<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login" name="Medienfreigabe Login">
        <t t-call="website.layout">
            <div id="wrap" class="glma-page">
                <div class="container py-5">
                    <div class="glma-login-card mx-auto">
                        <h1>Medienfreigabe</h1>
                        <p class="text-muted">Bitte gib deine persönliche PIN ein.</p>
                        <t t-if="error">
                            <div class="alert alert-danger">Die PIN wurde nicht gefunden.</div>
                        </t>
                        <form method="post" action="/media-approval/login" class="mt-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <input name="pin" type="password" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-lg text-center" placeholder="PIN" autofocus="autofocus"/>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100">Öffnen</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="folder_list" name="Medienfreigabe Ordnerliste">
        <t t-call="website.layout">
            <div id="wrap" class="glma-page">
                <div class="container py-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="mb-1">Medienfreigabe</h1>
                            <div class="text-muted">Angemeldet als <strong t-esc="person.name"/></div>
                        </div>
                        <a href="/media-approval/logout" class="btn btn-outline-secondary">Abmelden</a>
                    </div>
                    <t t-if="not folders">
                        <div class="alert alert-info">Aktuell sind keine Ordner freigeschaltet.</div>
                    </t>
                    <div class="row g-3">
                        <t t-foreach="folders" t-as="folder">
                            <div class="col-12 col-md-6 col-lg-4">
                                <a t-att-href="'/media-approval/folder/%s' % folder.id" class="glma-folder-card">
                                    <span class="glma-folder-title" t-esc="folder.name"/>
                                    <span class="glma-folder-sub"><t t-esc="folder.file_count"/> Dateien</span>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="folder_detail" name="Medienfreigabe Ordnerdetail">
        <t t-call="website.layout">
            <div id="wrap" class="glma-page">
                <div class="container-fluid py-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-lg-3">
                        <div>
                            <a href="/media-approval" class="glma-back">← Ordner</a>
                            <h1 class="mb-0" t-esc="folder.name"/>
                            <div class="text-muted">Angemeldet als <strong t-esc="person.name"/></div>
                        </div>
                        <a href="/media-approval/logout" class="btn btn-outline-secondary">Abmelden</a>
                    </div>
                    <div class="row g-3 px-lg-3">
                        <div class="col-12 col-lg-3 col-xl-2">
                            <div class="glma-list">
                                <t t-if="not files">
                                    <div class="p-3 text-muted">Keine Dateien in diesem Ordner.</div>
                                </t>
                                <t t-foreach="files" t-as="media">
                                    <a t-att-href="'/media-approval/folder/%s?file_id=%s' % (folder.id, media.id)"
                                       t-att-class="'glma-list-item %s %s' % (media.website_border_class, 'active' if selected and selected.id == media.id else '')">
                                        <span class="glma-file-name" t-esc="media.name"/>
                                        <span class="glma-file-meta">
                                            <t t-if="media.media_type == 'image'">Foto</t><t t-elif="media.media_type == 'video'">Video</t><t t-else="">Datei</t> ·
                                            <t t-esc="media.voted_count"/>/<t t-esc="media.required_count"/> Stimmen
                                        </span>
                                    </a>
                                </t>
                            </div>
                        </div>
                        <div class="col-12 col-lg-9 col-xl-10">
                            <t t-if="selected">
                                <t t-set="my_decision" t-value="selected.get_person_decision(person)"/>
                                <div t-att-class="'glma-preview-box %s' % selected.website_border_class">
                                    <div class="glma-preview-header">
                                        <div>
                                            <h2 t-esc="selected.name"/>
                                            <div class="text-muted">
                                                Status:
                                                <strong t-if="selected.decision_state == 'approved'">freigegeben</strong>
                                                <strong t-elif="selected.decision_state == 'rejected'">nicht freigegeben</strong>
                                                <strong t-else="">in Prüfung</strong>
                                                · <t t-esc="selected.voted_count"/>/<t t-esc="selected.required_count"/> Stimmen
                                            </div>
                                        </div>
                                    </div>
                                    <div class="glma-media-stage">
                                        <t t-if="selected.media_type == 'image'">
                                            <img t-att-src="'/media-approval/preview/%s' % selected.id" t-att-alt="selected.name" class="glma-preview-image"/>
                                        </t>
                                        <t t-elif="selected.media_type == 'video'">
                                            <video controls="controls" preload="metadata" class="glma-preview-video">
                                                <source t-att-src="'/media-approval/preview/%s' % selected.id" t-att-type="selected.mimetype"/>
                                                Dein Browser kann dieses Video nicht abspielen.
                                            </video>
                                        </t>
                                        <t t-else="">
                                            <div class="glma-generic-file">
                                                <div class="glma-generic-icon">📄</div>
                                                <div>Für diesen Dateityp gibt es keine Browser-Vorschau.</div>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="glma-actions">
                                        <form method="post" t-att-action="'/media-approval/vote/%s' % selected.id">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="decision" value="approved"/>
                                            <button type="submit" t-att-class="'btn btn-success btn-lg %s' % ('glma-active-vote' if my_decision == 'approved' else '')">Freigeben</button>
                                        </form>
                                        <form method="post" t-att-action="'/media-approval/vote/%s' % selected.id">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="decision" value="rejected"/>
                                            <button type="submit" t-att-class="'btn btn-danger btn-lg %s' % ('glma-active-vote' if my_decision == 'rejected' else '')">Nicht freigeben</button>
                                        </form>
                                        <t t-if="selected.download_unlocked">
                                            <a t-att-href="'/media-approval/download/%s' % selected.id" class="btn btn-success btn-lg">Download</a>
                                        </t>
                                        <t t-else="">
                                            <button class="btn btn-secondary btn-lg" disabled="disabled">Download</button>
                                        </t>
                                    </div>
                                    <div class="glma-legend">
                                        <span><i class="glma-dot glma-dot-green"></i> Grün: alle haben freigegeben</span>
                                        <span><i class="glma-dot glma-dot-orange"></i> Orange: noch nicht abgeschlossen</span>
                                        <span><i class="glma-dot glma-dot-red"></i> Rot: vollständig bewertet, mindestens eine Ablehnung</span>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">Bitte links eine Datei auswählen.</div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
