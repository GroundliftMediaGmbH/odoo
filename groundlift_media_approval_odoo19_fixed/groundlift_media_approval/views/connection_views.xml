<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_media_connection_tree" model="ir.ui.view">
        <field name="name">gl.media.approval.connection.tree</field>
        <field name="model">gl.media.approval.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="protocol"/>
                <field name="host"/>
                <field name="port"/>
                <field name="username"/>
                <field name="remote_base_path"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gl_media_connection_form" model="ir.ui.view">
        <field name="name">gl.media.approval.connection.form</field>
        <field name="model">gl.media.approval.connection</field>
        <field name="arch" type="xml">
            <form string="Hetzner Verbindung">
                <header>
                    <button name="action_test_connection" type="object" string="Verbindung testen" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="protocol"/>
                            <field name="host"/>
                            <field name="port"/>
                        </group>
                        <group>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="remote_base_path"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                    <group string="Erweitert">
                        <field name="ftp_passive" invisible="protocol == 'sftp'"/>
                        <field name="sftp_allow_unknown_host" invisible="protocol != 'sftp'"/>
                    </group>
                    <field name="note" placeholder="Interne Notizen..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_media_connection" model="ir.actions.act_window">
        <field name="name">Hetzner Verbindungen</field>
        <field name="res_model">gl.media.approval.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gl_media_connection" name="Hetzner Verbindungen" parent="menu_gl_media_config" action="action_gl_media_connection" sequence="10" groups="groundlift_media_approval.group_media_approval_manager"/>
</odoo>
