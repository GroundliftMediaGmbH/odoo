<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_media_vote_tree" model="ir.ui.view">
        <field name="name">gl.media.approval.vote.tree</field>
        <field name="model">gl.media.approval.vote</field>
        <field name="arch" type="xml">
            <list decoration-success="decision == 'approved'" decoration-danger="decision == 'rejected'">
                <field name="file_id"/>
                <field name="folder_id"/>
                <field name="person_id"/>
                <field name="decision"/>
                <field name="voted_at"/>
            </list>
        </field>
    </record>

    <record id="view_gl_media_vote_form" model="ir.ui.view">
        <field name="name">gl.media.approval.vote.form</field>
        <field name="model">gl.media.approval.vote</field>
        <field name="arch" type="xml">
            <form string="Stimme">
                <sheet>
                    <group>
                        <field name="file_id"/>
                        <field name="folder_id" readonly="1"/>
                        <field name="person_id"/>
                        <field name="decision"/>
                        <field name="voted_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_media_vote" model="ir.actions.act_window">
        <field name="name">Stimmen</field>
        <field name="res_model">gl.media.approval.vote</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gl_media_vote" name="Stimmen" parent="menu_gl_media_operation" action="action_gl_media_vote" sequence="30" groups="groundlift_media_approval.group_media_approval_manager"/>
</odoo>
