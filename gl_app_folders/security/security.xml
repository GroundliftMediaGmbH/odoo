<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_gl_app_folder_own" model="ir.rule">
        <field name="name">Eigene App-Ordner</field>
        <field name="model_id" ref="model_gl_app_folder"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_gl_app_folder_line_own" model="ir.rule">
        <field name="name">Eigene Apps in App-Ordnern</field>
        <field name="model_id" ref="model_gl_app_folder_line"/>
        <field name="domain_force">[('folder_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
