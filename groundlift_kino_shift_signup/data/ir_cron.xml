<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gl_kino_shift_monthly_request" model="ir.cron">
        <field name="name">Kino Dienstplan: Monatsanfrage versenden</field>
        <field name="model_id" ref="model_gl_kino_shift_campaign"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_monthly_request()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_gl_kino_shift_open_slot_reminder" model="ir.cron">
        <field name="name">Kino Dienstplan: Erinnerung offene Slots</field>
        <field name="model_id" ref="model_gl_kino_shift_campaign"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_open_slot_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_gl_kino_shift_manual_slot_due_reminder" model="ir.cron">
        <field name="name">Kino Dienstplan: Zusatztermin 1-Woche-Erinnerung</field>
        <field name="model_id" ref="model_gl_kino_shift_campaign"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_manual_slot_due_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
