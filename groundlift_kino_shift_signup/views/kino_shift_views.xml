<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_kino_shift_campaign_list" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.list</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <list string="Kino Dienstpläne">
                <field name="name"/>
                <field name="target_month"/>
                <field name="day_mode"/>
                <field name="state"/>
                <field name="filled_slot_count"/>
                <field name="total_slot_count"/>
                <field name="open_slot_count"/>
                <field name="priority_quota"/>
                <field name="request_sent_date"/>
                <field name="reminder_sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_gl_kino_shift_campaign_form" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.form</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <form string="Kino Dienstplan">
                <header>
                    <button name="action_generate_slots" type="object" string="Kinotage erzeugen" class="btn-secondary"/>
                    <button name="action_send_request" type="object" string="Anfrage senden" class="btn-primary"/>
                    <button name="action_send_reminder" type="object" string="Erinnerung senden" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target_month"/>
                            <field name="day_mode"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="manager_email"/>
                        </group>
                        <group>
                            <field name="filled_slot_count" readonly="1"/>
                            <field name="total_slot_count" readonly="1"/>
                            <field name="open_slot_count" readonly="1"/>
                            <field name="filmvorfuehrer_count" readonly="1"/>
                            <field name="priority_quota" readonly="1"/>
                            <field name="request_sent_date" readonly="1"/>
                            <field name="reminder_sent_date" readonly="1"/>
                            <field name="status_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kinotage">
                            <p class="text-muted">
                                Reguläre Tage werden über die Auswahl oben und den Button <strong>Kinotage erzeugen</strong> ergänzt.
                                Manuelle Zusatztermine können hier per <strong>Zeile hinzufügen</strong> angelegt werden.
                                Die Notiz ist für Filmvorführer:innen auf der öffentlichen Eintrageseite sichtbar.
                            </p>
                            <field name="slot_ids" context="{'default_is_manual': True}" mode="list,form">
                                <list editable="bottom" string="Kinotage">
                                    <field name="weekday_label" readonly="1"/>
                                    <field name="date" required="1"/>
                                    <field name="is_manual" string="Manuell"/>
                                    <field name="note" string="Notiz für Filmvorführer:innen" placeholder="z. B. Private Vermietung 11:00–18:00"/>
                                    <field name="status_label" readonly="1"/>
                                    <field name="employee_id"/>
                                    <field name="swap_requested"/>
                                    <field name="swap_requested_by_id" readonly="1"/>
                                    <field name="swap_requested_date" readonly="1"/>
                                </list>
                                <form string="Kinotag">
                                    <group>
                                        <field name="date" required="1"/>
                                        <field name="weekday_label" readonly="1"/>
                                        <field name="is_manual"/>
                                        <field name="status_label" readonly="1"/>
                                        <field name="employee_id"/>
                                        <field name="swap_requested"/>
                                        <field name="swap_requested_by_id" readonly="1"/>
                                        <field name="swap_requested_date" readonly="1"/>
                                        <field name="note" placeholder="z. B. Private Vermietung 11:00–18:00"/>
                                    </group>
                                    <group string="Prioritäten">
                                        <field name="preference_ids" readonly="1">
                                            <list string="Prioritäten">
                                                <field name="employee_id"/>
                                                <field name="priority"/>
                                                <field name="create_date"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Einladungen">
                            <field name="invite_ids" readonly="1">
                                <list string="Einladungen">
                                    <field name="employee_id"/>
                                    <field name="email_to"/>
                                    <field name="send_count"/>
                                    <field name="last_sent_date"/>
                                    <field name="signup_url" widget="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prioritäten">
                            <p class="text-muted">
                                Diese Liste zeigt alle per Website abgegebenen Prioritäten. Die automatische Besetzung bevorzugt
                                „will ich unbedingt machen“ vor „kann ich übernehmen“. Bei gleicher Priorität zählt die erste Eintragung.
                            </p>
                            <field name="preference_ids" readonly="1">
                                <list string="Prioritäten">
                                    <field name="slot_id"/>
                                    <field name="employee_id"/>
                                    <field name="priority"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_kino_shift_campaign_search" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.search</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <search string="Kino Dienstpläne">
                <field name="name"/>
                <field name="target_month"/>
                <field name="day_mode"/>
                <filter name="open" string="Offen" domain="[('state','=','open')]"/>
                <filter name="done" string="Vollständig" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_kino_shift_campaigns" model="ir.actions.act_window">
        <field name="name">Kino Dienstpläne</field>
        <field name="res_model">gl.kino.shift.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_kino_shift_campaign_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lege eine Kino-Dienstplan-Abfrage an oder lasse sie automatisch in der ersten Woche des Monats erstellen.
            </p>
        </field>
    </record>

    <menuitem id="menu_gl_kino_shift_root" name="Kino Dienstplan" sequence="80"/>
    <menuitem id="menu_gl_kino_shift_campaigns" name="Dienstpläne" parent="menu_gl_kino_shift_root" action="action_gl_kino_shift_campaigns" sequence="10"/>
</odoo>
