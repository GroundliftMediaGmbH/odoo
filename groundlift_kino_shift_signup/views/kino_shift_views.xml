<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_kino_shift_campaign_list" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.list</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <list string="Kino Dienstpläne">
                <field name="name"/>
                <field name="target_month"/>
                <field name="day_mode"/>
                <field name="state"/>
                <field name="filled_slot_count"/>
                <field name="total_slot_count"/>
                <field name="open_slot_count"/>
                <field name="priority_quota"/>
                <field name="max_monthly_shift_count"/>
                <field name="signup_deadline_date"/>
                <field name="request_sent_date"/>
                <field name="reminder_sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_gl_kino_shift_campaign_form" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.form</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <form string="Kino Dienstplan">
                <header>
                    <button name="action_generate_slots" type="object" string="Kinotage erzeugen" class="btn-secondary"/>
                    <button name="action_send_request" type="object" string="Anfrage senden" class="btn-primary"/>
                    <button name="action_send_reminder" type="object" string="Erinnerung senden" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target_month"/>
                            <field name="day_mode"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="manager_email"/>
                        </group>
                        <group>
                            <field name="filled_slot_count" readonly="1"/>
                            <field name="total_slot_count" readonly="1"/>
                            <field name="open_slot_count" readonly="1"/>
                            <field name="filmvorfuehrer_count" readonly="1"/>
                            <field name="priority_quota" readonly="1"/>
                            <field name="max_monthly_shift_count"/>
                            <field name="first_slot_date" readonly="1"/>
                            <field name="signup_deadline_date" readonly="1"/>
                            <field name="signup_state_label" readonly="1"/>
                            <field name="request_sent_date" readonly="1"/>
                            <field name="reminder_sent_date" readonly="1"/>
                            <field name="status_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kinotage">
                            <p class="text-muted">
                                Reguläre Tage werden über die Auswahl oben und den Button <strong>Kinotage erzeugen</strong> ergänzt.
                                Manuelle Zusatztermine können hier per <strong>Zeile hinzufügen</strong> angelegt werden.
                                Nachträglich gesperrte Termine zählen nicht mehr als Spieltag und werden auf der öffentlichen Eintrageseite ausgeblendet.
                                Die Notiz ist für Filmvorführer:innen auf der öffentlichen Eintrageseite sichtbar.
                            </p>
                            <field name="slot_ids" context="{'default_is_manual': True}" mode="list,form">
                                <list editable="bottom" string="Kinotage">
                                    <field name="weekday_label" readonly="1"/>
                                    <field name="date" required="1"/>
                                    <field name="is_manual" string="Manuell"/>
                                    <field name="is_blocked" string="Gesperrt" readonly="1"/>
                                    <field name="note" string="Notiz für Filmvorführer:innen" placeholder="z. B. Private Vermietung 11:00–18:00"/>
                                    <field name="status_label" readonly="1"/>
                                    <button name="action_block_slot" type="object" string="Sperren" class="btn-secondary" invisible="is_blocked" confirm="Diesen Kinotag wirklich sperren? Falls bereits jemand eingetragen ist, wird diese Person per E-Mail informiert."/>
                                    <button name="action_unblock_slot" type="object" string="Entsperren" class="btn-secondary" invisible="not is_blocked"/>
                                    <field name="employee_id" readonly="is_blocked"/>
                                    <field name="swap_requested" readonly="is_blocked"/>
                                    <field name="swap_requested_by_id" readonly="1"/>
                                    <field name="swap_requested_date" readonly="1"/>
                                    <field name="takeover_requested_by_id" readonly="1"/>
                                    <field name="takeover_requested_date" readonly="1"/>
                                    <field name="fill_request_state" readonly="1"/>
                                    <field name="fill_request_current_employee_id" readonly="1"/>
                                    <field name="fill_request_notice_sent_date" readonly="1"/>
                                    <field name="fill_request_due_reminder_sent_date" readonly="1"/>
                                </list>
                                <form string="Kinotag">
                                    <header>
                                        <button name="action_start_fill_request" type="object" string="Zusatztermin-Anfrage starten" class="btn-secondary" invisible="is_blocked"/>
                                        <button name="action_block_slot" type="object" string="Termin sperren" class="btn-secondary" invisible="is_blocked" confirm="Diesen Kinotag wirklich sperren? Falls bereits jemand eingetragen ist, wird diese Person per E-Mail informiert."/>
                                        <button name="action_unblock_slot" type="object" string="Termin entsperren" class="btn-secondary" invisible="not is_blocked"/>
                                    </header>
                                    <group>
                                        <field name="date" required="1"/>
                                        <field name="weekday_label" readonly="1"/>
                                        <field name="is_manual"/>
                                        <field name="is_blocked" readonly="1"/>
                                        <field name="blocked_datetime" readonly="1"/>
                                        <field name="status_label" readonly="1"/>
                                        <field name="employee_id" readonly="is_blocked"/>
                                        <field name="swap_requested" readonly="is_blocked"/>
                                        <field name="swap_requested_by_id" readonly="1"/>
                                        <field name="swap_requested_date" readonly="1"/>
                                        <field name="takeover_requested_by_id" readonly="1"/>
                                        <field name="takeover_requested_date" readonly="1"/>
                                        <field name="fill_request_state" readonly="1"/>
                                        <field name="fill_request_current_employee_id" readonly="1"/>
                                        <field name="fill_request_notice_sent_date" readonly="1"/>
                                        <field name="fill_request_due_reminder_sent_date" readonly="1"/>
                                        <field name="note" placeholder="z. B. Private Vermietung 11:00–18:00"/>
                                    </group>
                                    <group string="Automatische Zusatztermin-Anfragen">
                                        <field name="offer_ids" readonly="1">
                                            <list string="Anfragen">
                                                <field name="sequence"/>
                                                <field name="employee_id"/>
                                                <field name="shift_count_at_offer"/>
                                                <field name="state"/>
                                                <field name="sent_datetime"/>
                                                <field name="responded_datetime"/>
                                            </list>
                                        </field>
                                    </group>
                                    <group string="Prioritäten">
                                        <field name="preference_ids" readonly="1">
                                            <list string="Prioritäten">
                                                <field name="employee_id"/>
                                                <field name="priority"/>
                                                <field name="create_date"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Einladungen">
                            <field name="invite_ids" readonly="1">
                                <list string="Einladungen">
                                    <field name="employee_id"/>
                                    <field name="email_to"/>
                                    <field name="send_count"/>
                                    <field name="last_sent_date"/>
                                    <field name="signup_url" widget="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prioritäten">
                            <p class="text-muted">
                                Diese Liste zeigt alle per Website abgegebenen Prioritäten. Die automatische Besetzung bevorzugt
                                „will ich unbedingt machen“ vor „kann ich übernehmen“. Bei bereits fix besetzten Terminen wird jedoch zuerst die eingetragene Person gefragt.
                            </p>
                            <field name="preference_ids" readonly="1">
                                <list string="Prioritäten">
                                    <field name="slot_id"/>
                                    <field name="employee_id"/>
                                    <field name="priority"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_kino_shift_campaign_search" model="ir.ui.view">
        <field name="name">gl.kino.shift.campaign.search</field>
        <field name="model">gl.kino.shift.campaign</field>
        <field name="arch" type="xml">
            <search string="Kino Dienstpläne">
                <field name="name"/>
                <field name="target_month"/>
                <field name="day_mode"/>
                <filter name="open" string="Offen" domain="[('state','=','open')]"/>
                <filter name="done" string="Vollständig" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_kino_shift_campaigns" model="ir.actions.act_window">
        <field name="name">Kino Dienstpläne</field>
        <field name="res_model">gl.kino.shift.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_kino_shift_campaign_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lege eine Kino-Dienstplan-Abfrage an oder lasse sie automatisch in der ersten Woche des Monats erstellen.
            </p>
        </field>
    </record>



    <record id="view_gl_kino_shift_team_member_list" model="ir.ui.view">
        <field name="name">gl.kino.shift.team.member.list</field>
        <field name="model">gl.kino.shift.team.member</field>
        <field name="arch" type="xml">
            <list string="Filmvorführer:innen" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="employee_id" required="1"/>
                <field name="email_to" readonly="1"/>
                <field name="department_id" readonly="1"/>
                <field name="job_title" readonly="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gl_kino_shift_team_member_form" model="ir.ui.view">
        <field name="name">gl.kino.shift.team.member.form</field>
        <field name="model">gl.kino.shift.team.member</field>
        <field name="arch" type="xml">
            <form string="Filmvorführer:in">
                <sheet>
                    <group>
                        <field name="employee_id" required="1"/>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                    <group>
                        <field name="email_to" readonly="1"/>
                        <field name="department_id" readonly="1"/>
                        <field name="job_title" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_kino_shift_team_member_search" model="ir.ui.view">
        <field name="name">gl.kino.shift.team.member.search</field>
        <field name="model">gl.kino.shift.team.member</field>
        <field name="arch" type="xml">
            <search string="Filmvorführer:innen">
                <field name="employee_id"/>
                <filter name="active" string="Aktiv" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inaktiv" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_kino_shift_team_members" model="ir.actions.act_window">
        <field name="name">Filmvorführer:innen</field>
        <field name="res_model">gl.kino.shift.team.member</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_kino_shift_team_member_search"/>
        <field name="context">{'search_default_active': 1, 'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Über „Neu“ bzw. „Hinzufügen“ kannst du eine:n beliebige:n Mitarbeiter:in in das Kino-Schichtsystem aufnehmen.
            </p>
        </field>
    </record>

    <record id="view_gl_kino_shift_slot_offer_list" model="ir.ui.view">
        <field name="name">gl.kino.shift.slot.offer.list</field>
        <field name="model">gl.kino.shift.slot.offer</field>
        <field name="arch" type="xml">
            <list string="Zusatztermin-Anfragen">
                <field name="slot_id"/>
                <field name="campaign_id"/>
                <field name="sequence"/>
                <field name="employee_id"/>
                <field name="shift_count_at_offer"/>
                <field name="state"/>
                <field name="sent_datetime"/>
                <field name="responded_datetime"/>
            </list>
        </field>
    </record>

    <record id="action_gl_kino_shift_slot_offers" model="ir.actions.act_window">
        <field name="name">Zusatztermin-Anfragen</field>
        <field name="res_model">gl.kino.shift.slot.offer</field>
        <field name="view_mode">list</field>
    </record>


    <menuitem id="menu_gl_kino_shift_root" name="Kino Dienstplan" sequence="80"/>
    <menuitem id="menu_gl_kino_shift_campaigns" name="Dienstpläne" parent="menu_gl_kino_shift_root" action="action_gl_kino_shift_campaigns" sequence="10"/>
    <menuitem id="menu_gl_kino_shift_team_members" name="Filmvorführer:innen" parent="menu_gl_kino_shift_root" action="action_gl_kino_shift_team_members" sequence="20"/>
    <menuitem id="menu_gl_kino_shift_slot_offers" name="Zusatztermin-Anfragen" parent="menu_gl_kino_shift_root" action="action_gl_kino_shift_slot_offers" sequence="30"/>
</odoo>
