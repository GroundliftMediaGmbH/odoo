<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kino_shift_page" name="Kino Dienstplan Seite">
        <t t-call="website.layout">
            <t t-set="head">
                <meta name="robots" content="noindex,nofollow"/>
            </t>
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-11">
                            <div class="card shadow-sm border-0" style="border-radius:18px; overflow:hidden;">
                                <div class="card-body p-4 p-md-5">
                                    <t t-if="not campaign">
                                        <h1 class="mb-3">Kino-Dienstplan</h1>
                                        <p>Aktuell ist kein offener Kino-Dienstplan vorhanden.</p>
                                    </t>
                                    <t t-if="campaign">
                                        <t t-if="employee_portal">
                                            <div class="mb-4 p-3 p-md-4 bg-light rounded-3">
                                                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                                                    <div>
                                                        <div class="fw-semibold">Meine Kino-Dienstpläne</div>
                                                        <div class="small text-muted">Deine persönliche Seite bleibt immer unter demselben Link erreichbar. Wähle hier den gewünschten Monat.</div>
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        <t t-foreach="portal_month_entries" t-as="month_entry">
                                                            <a t-att-href="month_entry['url']"
                                                               t-att-class="'btn btn-sm ' + ('btn-dark' if month_entry['active'] else 'btn-outline-dark')">
                                                                <t t-out="month_entry['campaign'].month_label"/>
                                                            </a>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
                                            <div>
                                                <p class="text-uppercase text-muted mb-1" style="letter-spacing:.08em;font-size:12px;">Kino Alte Brauerei Stegen</p>
                                                <h1 class="mb-2">Kino-Dienstplan <t t-out="campaign.month_label"/></h1>
                                                <p class="mb-0 text-muted">
                                                    <strong><t t-out="campaign.filled_slot_count"/>/<t t-out="campaign.total_slot_count"/></strong>
                                                    Kinotagen fix besetzt
                                                </p>
                                                <p class="mb-0 text-muted" style="font-size:14px;">
                                                    Reguläre Spieltage: <t t-out="campaign.day_mode_label"/>
                                                </p>
                                            </div>
                                            <div t-if="invite" class="alert alert-success mb-0">
                                                <div>Persönlicher Link für <strong><t t-out="invite.employee_id.name"/></strong></div>
                                                <div class="mt-1">
                                                    <strong>Schichten:</strong> <t t-out="monthly_shift_count"/>/<t t-out="max_monthly_shift_count"/> übernommen, noch <strong><t t-out="monthly_shift_remaining"/></strong> möglich.
                                                </div>
                                                <div class="text-muted" style="font-size:13px;">
                                                    Prioritäten: noch <t t-out="strong_remaining"/>x „will ich unbedingt machen“ · max. <t t-out="priority_quota"/> Prioritäten
                                                </div>
                                                <div class="text-muted" style="font-size:13px;">
                                                    <t t-out="campaign.signup_state_label"/>
                                                </div>
                                            </div>
                                            <div t-if="not invite" class="alert alert-secondary mb-0">
                                                Statusansicht ohne Eintragung. Zum Eintragen bitte den persönlichen Link aus der E-Mail verwenden.
                                            </div>
                                        </div>

                                        <t t-if="message">
                                            <div class="alert alert-info" role="alert"><t t-out="message"/></div>
                                        </t>

                                        <t t-if="invite and takeover_request_slots">
                                            <div class="alert alert-warning mb-4" role="alert">
                                                <h5 class="mb-2">Übergabeanfrage für deinen Termin</h5>
                                                <p class="mb-3">Eine andere Person möchte einen deiner Termine unbedingt übernehmen. Bitte entscheide hier direkt:</p>
                                                <t t-foreach="takeover_request_slots" t-as="takeover_slot">
                                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-2 border-top">
                                                        <div>
                                                            <strong><t t-out="takeover_slot.display_line_short"/></strong>
                                                            <span class="ms-1">–</span>
                                                            <span><t t-out="takeover_slot.takeover_requested_by_id.name"/> möchte übernehmen</span>
                                                            <t t-if="takeover_slot.note">
                                                                <div class="small text-muted mt-1"><t t-out="takeover_slot.note"/></div>
                                                            </t>
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            <form method="post" action="/kino-dienstplan/takeover/respond" class="m-0">
                                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                <input type="hidden" name="slot_id" t-att-value="takeover_slot.id"/>
                                                                <input type="hidden" name="answer" value="yes"/>
                                                                <button type="submit" class="btn btn-dark btn-sm">Ja, Termin abgeben</button>
                                                            </form>
                                                            <form method="post" action="/kino-dienstplan/takeover/respond" class="m-0">
                                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                <input type="hidden" name="slot_id" t-att-value="takeover_slot.id"/>
                                                                <input type="hidden" name="answer" value="no"/>
                                                                <button type="submit" class="btn btn-outline-dark btn-sm">Nein, Termin behalten</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>

                                        <div class="table-responsive">
                                            <table class="table align-middle">
                                                <thead>
                                                    <tr>
                                                        <th style="width:150px;">Tag</th>
                                                        <th>Hinweis</th>
                                                        <th style="width:230px;">Status</th>
                                                        <th t-if="invite" style="width:330px;">Aktion / Priorität</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="week_rows" t-as="week">
                                                        <t t-foreach="week" t-as="slot">
                                                            <tr>
                                                                <td>
                                                                    <strong><t t-out="slot.weekday_label"/>:</strong>
                                                                    <t t-out="slot.date_label"/>
                                                                    <t t-if="slot.is_manual">
                                                                        <div class="mt-1"><span class="badge text-bg-info">Zusatztermin</span></div>
                                                                    </t>
                                                                </td>
                                                                <td>
                                                                    <t t-if="slot.note">
                                                                        <span><t t-out="slot.note"/></span>
                                                                    </t>
                                                                    <t t-if="not slot.note">
                                                                        <span class="text-muted">–</span>
                                                                    </t>
                                                                </td>
                                                                <td>
                                                                    <t t-if="slot.swap_requested">
                                                                        <span class="badge text-bg-danger">Tauschanfrage</span>
                                                                        <t t-if="slot.employee_id">
                                                                            <div class="small text-muted mt-1">aktuell: <t t-out="slot.employee_id.name"/></div>
                                                                        </t>
                                                                    </t>
                                                                    <t t-if="not slot.swap_requested and slot.employee_id">
                                                                        <span class="badge text-bg-success">fix besetzt</span>
                                                                        <span class="ms-2"><t t-out="slot.employee_id.name"/></span>
                                                                        <t t-if="slot.takeover_requested_by_id">
                                                                            <div class="small text-muted mt-1">
                                                                                Übergabewunsch von <t t-out="slot.takeover_requested_by_id.name"/>
                                                                            </div>
                                                                        </t>
                                                                    </t>
                                                                    <t t-if="not slot.swap_requested and not slot.employee_id">
                                                                        <t t-if="slot.fill_request_state == 'waiting' and slot.fill_request_current_employee_id">
                                                                            <span class="badge text-bg-info">Einzelanfrage läuft</span>
                                                                            <div class="small text-muted mt-1">aktuell angefragt: <t t-out="slot.fill_request_current_employee_id.name"/></div>
                                                                        </t>
                                                                        <t t-if="slot.fill_request_state == 'exhausted'">
                                                                            <span class="badge text-bg-danger">offen – niemand verfügbar</span>
                                                                        </t>
                                                                        <t t-if="slot.fill_request_state not in ['waiting', 'exhausted']">
                                                                            <span class="badge text-bg-warning">offen</span>
                                                                        </t>
                                                                    </t>
                                                                </td>
                                                                <td t-if="invite">
                                                                    <t t-set="current_pref" t-value="preference_by_slot_id.get(slot.id) if preference_by_slot_id else False"/>
                                                                    <t t-set="is_own_slot" t-value="slot.employee_id and slot.employee_id.id == invite.employee_id.id"/>
                                                                    <t t-set="can_take_more_shifts" t-value="monthly_shift_remaining &gt; 0 or is_own_slot"/>
                                                                    <t t-if="is_own_slot">
                                                                        <div class="text-success fw-semibold mb-2">Von dir übernommen</div>
                                                                        <t t-if="not slot.swap_requested">
                                                                            <t t-if="slot.takeover_requested_by_id">
                                                                                <div class="alert alert-warning py-2 px-3 mb-2 small">
                                                                                    <strong><t t-out="slot.takeover_requested_by_id.name"/></strong>
                                                                                    möchte diesen Termin unbedingt übernehmen.
                                                                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                                                                        <form method="post" action="/kino-dienstplan/takeover/respond" class="m-0">
                                                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                            <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                            <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                            <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                            <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                            <input type="hidden" name="answer" value="yes"/>
                                                                                            <button type="submit" class="btn btn-dark btn-sm">Ja, Termin abgeben</button>
                                                                                        </form>
                                                                                        <form method="post" action="/kino-dienstplan/takeover/respond" class="m-0">
                                                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                            <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                            <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                            <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                            <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                            <input type="hidden" name="answer" value="no"/>
                                                                                            <button type="submit" class="btn btn-outline-dark btn-sm">Nein, Termin behalten</button>
                                                                                        </form>
                                                                                    </div>
                                                                                </div>
                                                                            </t>
                                                                            <div class="d-flex flex-wrap gap-2">
                                                                                <t t-if="correction_available_by_slot_id.get(slot.id)">
                                                                                    <form method="post" action="/kino-dienstplan/correct" class="m-0" onsubmit="return confirm('Möchtest du deine Eintragung für diesen Termin korrigieren?');">
                                                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                        <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                        <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                        <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                        <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                        <button type="submit" class="btn btn-outline-dark btn-sm">Korrigieren</button>
                                                                                    </form>
                                                                                </t>
                                                                                <form method="post" action="/kino-dienstplan/swap/request" class="m-0" onsubmit="return confirm('Kannst du an diesem Tag wirklich nicht?');">
                                                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                    <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                    <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                    <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                    <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Tauschen</button>
                                                                                </form>
                                                                            </div>
                                                                        </t>
                                                                        <t t-if="slot.swap_requested">
                                                                            <span class="text-muted small">Tauschanfrage läuft</span>
                                                                        </t>
                                                                    </t>

                                                                    <t t-if="not is_own_slot and slot.swap_requested">
                                                                        <t t-if="monthly_shift_remaining &gt; 0">
                                                                            <form method="post" action="/kino-dienstplan/swap/accept" class="m-0">
                                                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                <button type="submit" class="btn btn-dark btn-sm">Tausch übernehmen</button>
                                                                            </form>
                                                                        </t>
                                                                        <t t-if="monthly_shift_remaining &lt;= 0">
                                                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="disabled">Monatslimit erreicht</button>
                                                                        </t>
                                                                    </t>

                                                                    <t t-if="not is_own_slot and not slot.swap_requested">
                                                                        <t t-if="current_pref">
                                                                            <div class="small text-muted mb-2">
                                                                                Deine Auswahl: <strong><t t-out="current_pref.priority_label"/></strong>
                                                                            </div>
                                                                        </t>
                                                                        <t t-if="not can_take_more_shifts">
                                                                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled="disabled">Monatslimit erreicht</button>
                                                                        </t>
                                                                        <t t-if="can_take_more_shifts">
                                                                            <t t-if="campaign.signup_locked">
                                                                                <t t-if="not slot.employee_id">
                                                                                    <form method="post" action="/kino-dienstplan/signup" class="m-0">
                                                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                        <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                        <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                        <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                        <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                        <input type="hidden" name="priority" value="normal"/>
                                                                                        <button type="submit" class="btn btn-dark btn-sm w-100">Freien Termin übernehmen</button>
                                                                                    </form>
                                                                                </t>
                                                                                <t t-if="slot.employee_id">
                                                                                    <span class="text-muted small">Nach der Frist nur noch per Tausch änderbar</span>
                                                                                </t>
                                                                            </t>
                                                                            <t t-if="not campaign.signup_locked">
                                                                                <div class="d-flex flex-column gap-2">
                                                                                    <t t-set="can_use_strong" t-value="strong_remaining &gt; 0 or (current_pref and current_pref.priority == 'strong')"/>
                                                                                    <form method="post" action="/kino-dienstplan/signup" class="m-0">
                                                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                        <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                        <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                        <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                        <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                        <input type="hidden" name="priority" value="strong"/>
                                                                                        <t t-if="can_use_strong">
                                                                                            <button type="submit" class="btn btn-dark btn-sm w-100">Will ich unbedingt machen</button>
                                                                                        </t>
                                                                                        <t t-if="not can_use_strong">
                                                                                            <button type="button" class="btn btn-dark btn-sm w-100" disabled="disabled">Priorisierung ausgeschöpft</button>
                                                                                        </t>
                                                                                    </form>
                                                                                    <form method="post" action="/kino-dienstplan/signup" class="m-0">
                                                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                                                        <input type="hidden" name="campaign_token" t-att-value="campaign.token"/>
                                                                                        <input type="hidden" name="employee_token" t-att-value="invite.token"/>
                                                                                        <t t-if="employee_portal"><input type="hidden" name="return_access_token" t-att-value="employee_portal.token"/></t>
                                                                                        <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                                                                                        <input type="hidden" name="priority" value="normal"/>
                                                                                        <button type="submit" class="btn btn-outline-dark btn-sm w-100">Kann ich übernehmen</button>
                                                                                    </form>
                                                                                </div>
                                                                            </t>
                                                                        </t>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="mt-4 p-3 bg-light rounded">
                                            <p class="mb-1"><strong>Hinweis:</strong></p>
                                            <p class="mb-0">
                                                Prioritäten können bis zwei Wochen vor der ersten Schicht gesetzt werden. Danach können nur noch freie Termine direkt übernommen oder bestehende Termine per Tauschanfrage geändert werden.
                                                Eine eigene Eintragung kann innerhalb von 24 Stunden über „Korrigieren“ zurückgenommen werden, solange die Eintragungsfrist noch läuft.
                                                Pro Person können maximal <t t-out="max_monthly_shift_count"/> Schichten im Monat übernommen werden.
                                                Eine laufende Tauschanfrage wird als „Tauschanfrage“ angezeigt, bis jemand den Termin übernimmt.
                                            </p>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
