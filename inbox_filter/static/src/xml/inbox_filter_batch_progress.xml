<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="inbox_filter.BatchProgress">
        <div class="o_inbox_filter_batch_progress p-4 h-100 overflow-auto">
            <div class="container-lg">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="mb-1"><t t-esc="state.name"/></h2>
                                <div class="text-muted">Status: <strong><t t-esc="state.state_label"/></strong></div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary" t-on-click="refreshNow">Jetzt aktualisieren</button>
                                <button class="btn btn-outline-secondary" t-on-click="openHistory">Historie</button>
                                <button class="btn btn-primary" t-on-click="openWorkspace">Zurück zum Inbox Filter</button>
                            </div>
                        </div>

                        <t t-if="!state.exists">
                            <div class="alert alert-danger">Der Stapellauf wurde nicht gefunden.</div>
                        </t>
                        <t t-else="">
                            <div class="progress mb-3" style="height: 30px;">
                                <div class="progress-bar progress-bar-striped"
                                     t-att-class="state.done ? 'progress-bar bg-success' : 'progress-bar progress-bar-striped progress-bar-animated'"
                                     role="progressbar"
                                     t-att-style="'width: ' + state.progress + '%'"
                                     t-att-aria-valuenow="state.progress"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <strong><t t-esc="state.progress"/> %</strong>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted">Bearbeitet</div><div class="fs-4"><t t-esc="state.processed_count"/> / <t t-esc="state.total_count"/></div></div></div>
                                <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted">Erfolgreich</div><div class="fs-4"><t t-esc="state.success_count"/></div></div></div>
                                <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted">Fehler</div><div class="fs-4"><t t-esc="state.error_count"/></div></div></div>
                                <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="text-muted">Übersprungen</div><div class="fs-4"><t t-esc="state.skipped_count"/></div></div></div>
                            </div>

                            <t t-if="state.state === 'waiting'">
                                <div class="alert alert-warning mb-3">
                                    <strong>Rate-Limit-Pause:</strong>
                                    OpenAI erhält bis zum Reset keine weitere Anfrage aus diesem Stapellauf.
                                    <t t-if="state.wait_seconds"> Fortsetzung automatisch in ca. <t t-esc="state.wait_seconds"/> Sekunden.</t>
                                </div>
                            </t>
                            <t t-if="state.done">
                                <div class="alert alert-success mb-3">
                                    Der Stapellauf ist abgeschlossen. Fehlerhafte Datensätze bleiben für die automatische spätere Nachprüfung vorgemerkt.
                                </div>
                            </t>

                            <div class="border rounded p-3 bg-light">
                                <div><strong>Aktuell:</strong> <t t-esc="state.current_history || '—'"/></div>
                                <div class="mt-1"><strong>Meldung:</strong> <t t-esc="state.last_message || '—'"/></div>
                            </div>
                            <div class="small text-muted mt-3">
                                Der Lauf wird zusätzlich per Odoo-Cron weitergeführt, falls diese Seite geschlossen wird.
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
