<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inbox_filter_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.inbox.filter.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Inbox Filter Einstellungen">
                <sheet>
                    <div class="oe_title">
                        <h1>Inbox Filter Einstellungen</h1>
                    </div>
                    <group string="OpenAI">
                        <field name="inbox_filter_openai_api_key_status" readonly="1"/>
                        <field name="inbox_filter_openai_api_key" password="True" placeholder="OpenAI API Token hier einfügen oder bestehenden ersetzen"/>
                        <button string="Token prüfen" type="object" name="action_test_openai_token_saved" class="btn-secondary"/>
                        <button string="Token entfernen" type="object" name="action_clear_openai_token" class="btn-secondary" confirm="Soll der gespeicherte OpenAI API Token wirklich entfernt werden?"/>
                        <field name="inbox_filter_openai_model"/>
                        <field name="inbox_filter_openai_url"/>
                    </group>
                    <group string="Sortierlauf">
                        <field name="inbox_filter_limit"/>
                    </group>
                    <group string="Kundensupport">
                        <field name="inbox_filter_customer_care_email"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Speichern" type="object" name="execute" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inbox_filter_settings" model="ir.actions.act_window">
        <field name="name">Einstellungen</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inbox_filter_settings_form"/>
        <field name="target">current</field>
        <field name="context">{'module': 'inbox_filter'}</field>
    </record>

    <menuitem id="menu_inbox_filter_settings" name="Einstellungen" parent="menu_inbox_filter_root" action="action_inbox_filter_settings" sequence="30" groups="base.group_system"/>
</odoo>
