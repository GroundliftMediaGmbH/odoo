<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inbox_filter_history_list" model="ir.ui.view">
        <field name="name">inbox.filter.history.list</field>
        <field name="model">inbox.filter.history</field>
        <field name="arch" type="xml">
            <list string="Inbox Filter Historie" create="false">
                <field name="perfect_recognized" widget="boolean_toggle" string="Perfekt erkannt"/>
                <field name="create_date" string="Zeitstempel"/>
                <field name="name" string="Beschreibung"/>
                <field name="category" string="Filter"/>
                <field name="moved_to" string="Verschoben nach"/>
                <field name="confidence"/>
                <field name="status"/>
                <field name="raw_input_preview" string="Voransicht"/>
            </list>
        </field>
    </record>

    <record id="view_inbox_filter_history_form" model="ir.ui.view">
        <field name="name">inbox.filter.history.form</field>
        <field name="model">inbox.filter.history</field>
        <field name="arch" type="xml">
            <form string="Inbox Filter Vorgang">
                <header>
                    <button name="action_open_record" type="object" string="Datensatz öffnen"/>
                    <button name="action_reclassify" type="object" string="Neu erkennen" class="btn-primary" confirm="Diesen Datensatz erneut prüfen und neu einsortieren?"/>
                    <button name="action_reclassify_all" type="object" string="Alle neu einsortieren" class="btn-secondary" confirm="Alle Historien-Datensätze, die nicht auf 'Perfekt erkannt' stehen, werden neu geprüft und erneut verschoben. Fortfahren?"/>
                    <button name="action_undo" type="object" string="Rückgängig" class="btn-secondary"/>
                    <button name="action_confirm_spam" type="object" string="SPAM bestätigt / löschen" class="btn-secondary"/>
                    <button name="action_mark_qualified" type="object" string="Qualifiziert" class="btn-primary"/>
                    <button name="action_mark_band_request" type="object" string="Bandanfragen"/>
                    <button name="action_mark_spam" type="object" string="SPAM"/>
                    <button name="action_mark_newsletter" type="object" string="Newsletter"/>
                    <button name="action_mark_cinema_delivery_report" type="object" string="Kino Lieferung/Report"/>
                    <button name="action_mark_invoice" type="object" string="Rechnungen"/>
                    <button name="action_mark_shipping_tracking" type="object" string="Versand/Paket"/>
                    <button name="action_mark_ticket_order" type="object" string="Kartenbestellung"/>
                    <button name="action_open_project_event_wizard" type="object" string="Projekt/VA"/>
                    <button name="action_mark_soft_bounce" type="object" string="Softbounce"/>
                    <button name="action_open_todo_wizard" type="object" string="ToDo"/>
                    <button name="action_assign_support" type="object" string="Kundensupport"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="perfect_recognized" widget="boolean_toggle"/>
                    </group>
                    <group string="Direkte Mail-Voransicht">
                        <field name="raw_input_preview_html" nolabel="1" readonly="1" widget="html"/>
                    </group>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="category"/>
                            <field name="confidence"/>
                            <field name="moved_to"/>
                            <field name="target_stage_id"/>
                        </group>
                        <group>
                            <field name="lead_id" context="{'active_test': False}"/>
                            <field name="project_id"/>
                            <field name="event_id"/>
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="ticket_ref_model" readonly="1"/>
                            <field name="ticket_ref_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Original &amp; Übersicht">
                            <group string="Originalinhalt">
                                <field name="raw_input" nolabel="1" widget="text" readonly="1"/>
                            </group>
                            <group string="Beschreibung">
                                <field name="summary" nolabel="1" widget="text"/>
                            </group>
                            <group string="Begründung">
                                <field name="reason" nolabel="1" widget="text"/>
                            </group>
                        </page>
                        <page string="GPT JSON"><field name="gpt_response_json" nolabel="1" widget="text"/></page>
                        <page string="Snapshot"><field name="original_data_json" nolabel="1" widget="text" readonly="1"/></page>
                        <page string="Fehler"><field name="error_message" nolabel="1" widget="text"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_inbox_filter_history_search" model="ir.ui.view">
        <field name="name">inbox.filter.history.search</field>
        <field name="model">inbox.filter.history</field>
        <field name="arch" type="xml">
            <search string="Inbox Filter Historie">
                <field name="name"/>
                <field name="summary"/>
                <field name="raw_input"/>
                <field name="category"/>
                <filter name="filter_perfect" string="Perfekt erkannt" domain="[('perfect_recognized','=',True)]"/>
                <filter name="filter_not_perfect" string="Nicht perfekt" domain="[('perfect_recognized','=',False)]"/>
                <filter name="filter_band_request" string="Bandanfragen" domain="[('category','=','band_request')]"/>
                <filter name="filter_spam" string="SPAM" domain="[('category','=','spam')]"/>
                <filter name="filter_newsletter" string="Newsletter" domain="[('category','=','newsletter')]"/>
                <filter name="filter_cinema_delivery_report" string="Kino Lieferung/Report" domain="[('category','=','cinema_delivery_report')]"/>
                <filter name="filter_invoice" string="Rechnungen" domain="[('category','=','invoice')]"/>
                <filter name="filter_shipping_tracking" string="Versand / Paketverfolgung" domain="[('category','=','shipping_tracking')]"/>
                <filter name="filter_ticket_order" string="Kartenbestellungen" domain="[('category','=','ticket_order')]"/>
                <filter name="filter_production" string="Projekt/VA" domain="[('category','=','production')]"/>
                <filter name="filter_soft_bounce" string="Softbounces" domain="[('category','=','soft_bounce')]"/>
                <filter name="filter_qualified" string="Qualifiziert" domain="[('category','=','qualified')]"/>
                <filter name="filter_support" string="Kundensupport" domain="[('category','=','support')]"/>
                <filter name="filter_review" string="Zu prüfen" domain="[('category','=','review')]"/>
                <filter name="filter_errors" string="Fehler" domain="[('status','=','error')]"/>
                <group>
                    <filter name="group_category" string="Filter" context="{'group_by':'category'}"/>
                    <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                    <filter name="group_perfect" string="Perfekt erkannt" context="{'group_by':'perfect_recognized'}"/>
                    <filter name="group_date" string="Datum" context="{'group_by':'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_inbox_filter_history" model="ir.actions.act_window">
        <field name="name">Historie</field>
        <field name="res_model">inbox.filter.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inbox_filter_history_search"/>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>

    <menuitem id="menu_inbox_filter_history" name="Historie" parent="menu_inbox_filter_root" action="action_inbox_filter_history" sequence="20" groups="base.group_user"/>
</odoo>
