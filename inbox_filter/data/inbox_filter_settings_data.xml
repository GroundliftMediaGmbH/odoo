<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inbox_filter_settings_singleton" model="inbox.filter.settings">
        <field name="name">Inbox Filter Einstellungen</field>
        <field name="openai_model">gpt-4.1-mini</field>
        <field name="openai_url">https://api.openai.com/v1/chat/completions</field>
        <field name="customer_care_email">customer-care@groundlift.odoo.com</field>
        <field name="limit">50</field>
        <field name="auto_sort_enabled">1</field>
        <field name="rate_limit_tpm">200000</field>
        <field name="rate_safety_percent">85</field>
        <field name="min_request_interval">1.5</field>
        <field name="classification_max_completion_tokens">1200</field>
        <field name="error_retry_enabled">1</field>
    </record>
    <record id="workspace_default" model="inbox.filter.workspace">
        <field name="name">Inbox Filter</field>
    </record>
</odoo>
