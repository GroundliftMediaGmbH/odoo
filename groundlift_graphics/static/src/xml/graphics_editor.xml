<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="groundlift_graphics.GraphicsEditor">
        <div class="o_gl_graphics_editor h-100 d-flex flex-column">
            <div class="o_gl_graphics_toolbar d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-white">
                <button class="btn btn-light" t-on-click="backToRecord"><i class="fa fa-arrow-left me-1"/>Zurück</button>
                <strong class="text-truncate ms-2" t-esc="state.eventName || 'Grafik-Editor'"/>
                <div class="flex-grow-1"/>
                <button class="btn btn-outline-primary" t-on-click="save" t-att-disabled="state.saving"><i t-att-class="state.saving ? 'fa fa-spinner fa-spin me-1' : 'fa fa-save me-1'"/>Speichern</button>
                <button class="btn btn-outline-secondary" t-on-click="saveAndDownload" t-att-disabled="state.saving"><i class="fa fa-download me-1"/>Aktuelles JPG</button>
                <button class="btn btn-primary" t-on-click="saveAndDownloadZip" t-att-disabled="state.saving"><i class="fa fa-file-archive-o me-1"/>Alle als ZIP</button>
            </div>
            <div t-if="state.loading" class="flex-grow-1 d-flex align-items-center justify-content-center text-muted">
                <div class="text-center"><i class="fa fa-spinner fa-spin fa-3x mb-3"/><div>Grafik-Editor wird geladen…</div></div>
            </div>
            <div t-else="" class="o_gl_graphics_workspace flex-grow-1 d-flex overflow-hidden">
                <aside class="o_gl_graphics_sidebar border-end bg-white overflow-auto">
                    <div class="p-3">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ausspielformat</label>
                            <select class="form-select" t-on-change="onTemplateChange">
                                <t t-foreach="state.templates" t-as="tmpl" t-key="tmpl.key">
                                    <option t-att-value="tmpl.key" t-att-selected="state.selectedTemplateKey === tmpl.key"><t t-esc="tmpl.name"/></option>
                                </t>
                            </select>
                        </div>

                        <ul class="nav nav-pills nav-fill mb-3">
                            <li class="nav-item"><a href="#" t-on-click.prevent="() => state.sidebarTab = 'overview'" t-att-class="'nav-link ' + (state.sidebarTab === 'overview' ? 'active' : '')">Übersicht</a></li>
                            <li class="nav-item"><a href="#" t-on-click.prevent="() => state.sidebarTab = 'layout'" t-att-class="'nav-link ' + (state.sidebarTab === 'layout' ? 'active' : '')">Layout</a></li>
                            <li class="nav-item"><a href="#" t-on-click.prevent="() => state.sidebarTab = 'links'" t-att-class="'nav-link ' + (state.sidebarTab === 'links' ? 'active' : '')">Links</a></li>
                            <li class="nav-item"><a href="#" t-on-click.prevent="() => state.sidebarTab = 'drink'" t-att-class="'nav-link ' + (state.sidebarTab === 'drink' ? 'active' : '')">Getränkekarte</a></li>
                        </ul>

                        <input t-ref="sourceFile" class="d-none" type="file" accept="image/*" t-on-change="onSourceFile"/>
                        <input t-ref="externalLogoFile" class="d-none" type="file" accept="image/*" t-on-change="onExternalLogoFile"/>

                        <t t-if="state.sidebarTab === 'overview'">
                            <section class="mb-4">
                                <h5>Bildquelle</h5>
                                <button class="btn btn-outline-primary w-100 mb-2" t-on-click="openFilePicker"><i class="fa fa-upload me-1"/>Bild hochladen / ersetzen</button>
                                <p class="small text-muted">Im Vorschaubild ziehen = verschieben, Mausrad = zoomen. Je Format bleibt die Justierung separat erhalten.</p>
                                <button class="btn btn-sm btn-outline-secondary w-100" t-on-click="extractPalette" t-att-disabled="!state.sourceImageBase64"><i class="fa fa-magic me-1"/>Farben aus Bild ableiten</button>
                            </section>
                            <section class="mb-4">
                                <h5>Texte</h5>
                                <div class="mb-2"><label class="form-label">Claim</label><textarea class="form-control" rows="2" data-field="claim" t-on-input="onFieldInput"><t t-esc="state.claim"/></textarea></div>
                                <div class="mb-2"><label class="form-label">Datum</label><input class="form-control" data-field="date_text" t-att-value="state.date_text" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">Titel</label><input class="form-control" data-field="event_title" t-att-value="state.event_title" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">Uhrzeit</label><input class="form-control" data-field="time_text" t-att-value="state.time_text" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">Kategorie (Label)</label><input class="form-control" data-field="event_type_text" t-att-value="state.event_type_text" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">Untertitel</label><textarea class="form-control" rows="2" data-field="event_subtitle" t-on-input="onFieldInput"><t t-esc="state.event_subtitle"/></textarea></div>
                                <div class="mb-2"><label class="form-label">Kurzzusammenfassung</label><textarea class="form-control" rows="4" data-field="summary_text" t-on-input="onFieldInput"><t t-esc="state.summary_text"/></textarea></div>
                                <div class="mb-2"><label class="form-label">Fotocredit</label><input class="form-control" data-field="photo_credit" t-att-value="state.photo_credit" t-on-input="onFieldInput"/></div>
                            </section>
                        </t>

                        <t t-if="state.sidebarTab === 'layout'">
                            <section class="mb-4">
                                <h5>Farben</h5>
                                <div class="form-check form-switch mb-3">
                                    <input id="gl_color_contrast" class="form-check-input" type="checkbox" t-att-checked="state.color_contrast" t-on-change="onContrastChange"/>
                                    <label class="form-check-label" for="gl_color_contrast">Farbkontrast</label>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6"><label class="form-label">Farbe 1</label><input class="form-control form-control-color w-100" type="color" data-field="color_1" t-att-value="state.color_1" t-on-input="onFieldInput"/></div>
                                    <div class="col-6"><label class="form-label">Farbe 2</label><input class="form-control form-control-color w-100" type="color" data-field="color_2" t-att-value="state.color_2" t-on-input="onFieldInput"/></div>
                                </div>
                            </section>
                            <section class="mb-4">
                                <h5>Störer</h5>
                                <select class="form-select mb-2" data-field="sticker_mode" t-on-change="onFieldInput">
                                    <option value="original" t-att-selected="state.sticker_mode === 'original'">Originalgrafik</option>
                                    <option value="custom" t-att-selected="state.sticker_mode === 'custom'">Individuell</option>
                                    <option value="hidden" t-att-selected="state.sticker_mode === 'hidden'">Ausblenden</option>
                                </select>
                                <textarea t-if="state.sticker_mode === 'custom'" class="form-control mb-2" rows="3" data-field="sticker_text" t-on-input="onFieldInput"><t t-esc="state.sticker_text"/></textarea>
                                <input t-if="state.sticker_mode === 'custom'" class="form-control form-control-color w-100 mb-3" type="color" data-field="sticker_color" t-att-value="state.sticker_color" t-on-input="onFieldInput"/>
                            </section>
                            <section class="mb-4">
                                <h5>Format-Justierung</h5>
                                <div class="small text-muted mb-2">Gilt nur für das aktuell gewählte Ausspielformat.</div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6"><label class="form-label">Bild X</label><input class="form-control" type="number" step="1" data-path="image.offsetX" t-att-value="currentVariant.image.offsetX" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-6"><label class="form-label">Bild Y</label><input class="form-control" type="number" step="1" data-path="image.offsetY" t-att-value="currentVariant.image.offsetY" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-6"><label class="form-label">Bild Zoom</label><input class="form-control" type="number" step="0.05" data-path="image.scale" t-att-value="currentVariant.image.scale" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-6"><label class="form-label">Bild Rotation</label><input class="form-control" type="number" step="1" data-path="image.rotation" t-att-value="currentVariant.image.rotation" t-on-input="onVariantNumberInput"/></div>
                                </div>
                                <h6 class="mt-3">QR-Code</h6>
                                <div class="row g-2 mb-2">
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="qr.dx" t-att-value="currentVariant.qr.dx" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="qr.dy" t-att-value="currentVariant.qr.dy" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="0.05" data-path="qr.scale" t-att-value="currentVariant.qr.scale" t-on-input="onVariantNumberInput"/></div>
                                </div>
                                <h6>Externes Logo</h6>
                                <button class="btn btn-outline-secondary btn-sm w-100 mb-2" t-on-click="openExternalLogoPicker"><i class="fa fa-image me-1"/>Externes Logo hochladen / ersetzen</button>
                                <div class="row g-2 mb-2">
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="externalLogo.dx" t-att-value="currentVariant.externalLogo.dx" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="externalLogo.dy" t-att-value="currentVariant.externalLogo.dy" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="0.05" data-path="externalLogo.scale" t-att-value="currentVariant.externalLogo.scale" t-on-input="onVariantNumberInput"/></div>
                                </div>
                                <h6>Störer</h6>
                                <div class="row g-2">
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="sticker.dx" t-att-value="currentVariant.sticker.dx" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="1" data-path="sticker.dy" t-att-value="currentVariant.sticker.dy" t-on-input="onVariantNumberInput"/></div>
                                    <div class="col-4"><input class="form-control" type="number" step="0.05" data-path="sticker.scale" t-att-value="currentVariant.sticker.scale" t-on-input="onVariantNumberInput"/></div>
                                </div>
                            </section>
                        </t>

                        <t t-if="state.sidebarTab === 'links'">
                            <section class="mb-4">
                                <h5>Links und Download</h5>
                                <div class="mb-2"><label class="form-label">Event-/Ticketseite</label><input class="form-control" type="url" data-field="ticket_url" t-att-value="state.ticket_url" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">Ticketlink-Zeile</label><input class="form-control" data-field="ticket_link_text" t-att-value="state.ticket_link_text" t-on-input="onFieldInput"/></div>
                                <div class="mb-2"><label class="form-label">QR-Code-Ziel</label><input class="form-control" type="url" t-att-value="state.qr_url" t-on-change="onQrUrlChange"/></div>
                                <div class="mb-2"><label class="form-label">Dateiname aktuelles Format</label><input class="form-control" data-field="output_filename" t-att-value="state.output_filename" t-on-input="onFieldInput"/></div>
                            </section>
                        </t>

                        <t t-if="state.sidebarTab === 'drink'">
                            <section class="mb-3">
                                <h5>Getränkekarte</h5>
                                <p class="small text-muted">Besonders relevant für das Format „Sudhaus Main“.</p>
                                <div class="mb-2">
                                    <label class="form-label">Gespeichertes Setup</label>
                                    <select class="form-select" t-on-change="applyDrinkProfile">
                                        <option value="">– neues / freies Setup –</option>
                                        <t t-foreach="state.drinkProfiles" t-as="profile" t-key="profile.id">
                                            <option t-att-value="profile.id" t-att-selected="state.drink_card_profile_id === profile.id"><t t-esc="profile.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <button class="btn btn-outline-primary btn-sm w-100 mb-3" t-on-click="saveDrinkProfile"><i class="fa fa-save me-1"/>Aktuelles Setup speichern</button>
                                <div class="mb-2"><label class="form-label">Fußnote</label><textarea class="form-control" rows="2" data-field="footer" t-on-input="(ev) => onDrinkFieldInput(ev, null)"><t t-esc="state.editor_state.drink_card.footer"/></textarea></div>
                                <t t-foreach="state.editor_state.drink_card.sections" t-as="section" t-key="section_index">
                                    <div class="border rounded p-2 mb-3">
                                        <div class="mb-2"><label class="form-label">Abschnittstitel</label><input class="form-control" data-field="title" t-att-value="section.title" t-on-input="(ev) => onDrinkFieldInput(ev, section_index)"/></div>
                                        <label class="form-label">Produkte</label>
                                        <select class="form-select" multiple="multiple" size="6" t-on-change="(ev) => onDrinkProductSelect(ev, section_index)">
                                            <t t-foreach="state.products" t-as="product" t-key="product.id">
                                                <option t-att-value="product.id" t-att-selected="section.product_ids.includes(product.id)"><t t-esc="product.name + ' (' + product.price.toFixed(2).replace('.', ',') + ' €)'"/></option>
                                            </t>
                                        </select>
                                    </div>
                                </t>
                            </section>
                        </t>
                    </div>
                </aside>
                <main class="o_gl_graphics_canvas_area flex-grow-1 overflow-auto d-flex align-items-center justify-content-center p-4">
                    <div class="o_gl_graphics_canvas_shell shadow-lg bg-dark">
                        <canvas t-ref="posterCanvas" t-on-pointerdown="onPointerDown" t-on-wheel.prevent="onCanvasWheel"/>
                    </div>
                </main>
            </div>
        </div>
    </t>
</templates>
