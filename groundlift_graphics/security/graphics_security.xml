<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_gl_graphics_poster_company" model="ir.rule">
        <field name="name">Grafiken: Unternehmen</field>
        <field name="model_id" ref="model_gl_graphics_poster"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_gl_graphics_template_company" model="ir.rule">
        <field name="name">Grafikvorlagen: Unternehmen</field>
        <field name="model_id" ref="model_gl_graphics_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
