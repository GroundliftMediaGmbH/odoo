<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_graphics" model="ir.ui.view">
        <field name="name">event.event.form.graphics</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_graphics_poster" type="object" string="Grafik erstellen" class="btn-secondary" icon="fa-picture-o"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_graphics_posters" type="object" class="oe_stat_button" icon="fa-picture-o">
                    <field name="graphics_poster_count" widget="statinfo" string="Grafiken"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
