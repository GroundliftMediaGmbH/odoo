<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_graphics_poster_list" model="ir.ui.view">
        <field name="name">gl.graphics.poster.list</field>
        <field name="model">gl.graphics.poster</field>
        <field name="arch" type="xml">
            <list string="Grafiken" default_order="write_date desc">
                <field name="name"/>
                <field name="event_id"/>
                <field name="date_text"/>
                <field name="event_title"/>
                <field name="last_rendered_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_graphics_poster_search" model="ir.ui.view">
        <field name="name">gl.graphics.poster.search</field>
        <field name="model">gl.graphics.poster</field>
        <field name="arch" type="xml">
            <search string="Grafiken durchsuchen">
                <field name="name"/>
                <field name="event_id"/>
                <field name="event_title"/>
                <filter name="has_output" string="Gerendert" domain="[('output_image', '!=', False)]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_event" string="Veranstaltung" context="{'group_by': 'event_id'}"/>
                    <filter name="group_company" string="Unternehmen" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_graphics_poster_form" model="ir.ui.view">
        <field name="name">gl.graphics.poster.form</field>
        <field name="model">gl.graphics.poster</field>
        <field name="arch" type="xml">
            <form string="Veranstaltungsgrafik">
                <header>
                    <button name="action_open_editor" type="object" string="Grafik-Editor öffnen" class="btn-primary" icon="fa-paint-brush"/>
                    <button name="action_download_output" type="object" string="PNG herunterladen" icon="fa-download" invisible="not output_image"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" text="Noch nicht gerendert" bg_color="text-bg-warning" invisible="output_image"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="last_rendered_at" readonly="1"/>
                            <field name="output_filename"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bilder">
                            <group>
                                <field name="source_image" widget="image" filename="source_image_filename" options="{'size': [640, 360]}"/>
                                <field name="source_image_filename" invisible="1"/>
                                <field name="output_image" widget="image" filename="output_filename" readonly="1" options="{'size': [640, 360]}"/>
                            </group>
                        </page>
                        <page string="Texte">
                            <group>
                                <group>
                                    <field name="claim"/>
                                    <field name="event_title"/>
                                    <field name="event_subtitle"/>
                                    <field name="date_text"/>
                                    <field name="time_text"/>
                                    <field name="event_type_text"/>
                                </group>
                                <group>
                                    <field name="photo_credit"/>
                                    <field name="ticket_url" widget="url"/>
                                    <field name="ticket_link_text"/>
                                    <field name="qr_url" widget="url"/>
                                </group>
                            </group>
                        </page>
                        <page string="Farben und Störer">
                            <group>
                                <group>
                                    <field name="color_contrast"/>
                                    <field name="color_1"/>
                                    <field name="color_2"/>
                                </group>
                                <group>
                                    <field name="sticker_mode"/>
                                    <field name="sticker_text" invisible="sticker_mode != 'custom'"/>
                                    <field name="sticker_color" invisible="sticker_mode != 'custom'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_graphics_poster" model="ir.actions.act_window">
        <field name="name">Grafiken</field>
        <field name="res_model">gl.graphics.poster</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_graphics_poster_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Erste Veranstaltungsgrafik erstellen</p>
            <p>Wähle eine Veranstaltung und öffne anschließend den Grafik-Editor.</p>
        </field>
    </record>
</odoo>
