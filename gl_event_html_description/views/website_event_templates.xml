<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="event_description_full_html_override"
        inherit_id="website_event.event_description_full"
        name="Event Description - Dedicated HTML Source"
    >
        <xpath expr="//div[@id='o_wevent_event_main_col']/div[@itemprop='description']" position="replace">
            <div class="mt-4" itemprop="description">
                <t t-out="event._gl_get_public_description_html()"/>
            </div>
        </xpath>
    </template>
</odoo>
