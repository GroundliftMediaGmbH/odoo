<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_html_description" model="ir.ui.view">
        <field name="name">event.event.form.html.description</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Website HTML" name="gl_event_website_html">
                    <div class="alert alert-info mb-3" role="alert">
                        Hier wird direkt Odoos originale Veranstaltungsbeschreibung als HTML-Quellcode bearbeitet.
                        Es gibt kein zweites Beschreibungsfeld und keine Synchronisation: Der Inhalt hier ist
                        derselbe Inhalt wie bei „Event Beschreibung“ und wird von der Odoo-Website verwendet.
                    </div>
                    <field
                        name="description"
                        string="HTML-Code"
                        widget="code"
                        options="{'mode': 'xml'}"
                        nolabel="1"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
