<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global company rule: also applies to Project Managers. -->
    <record id="rule_showcase_company" model="ir.rule">
        <field name="name">Showcase showcase: Mandantentrennung</field>
        <field name="model_id" ref="model_gl_project_showcase"/>
        <field name="domain_force">[('project_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_showcase_editor_project" model="ir.rule">
        <field name="name">Showcase showcase: Mitarbeiter mit Projektzugriff</field>
        <field name="model_id" ref="model_gl_project_showcase"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', 'in', ['employees', 'portal']), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_showcase_project_manager" model="ir.rule">
        <field name="name">Showcase showcase: Projektleitung</field>
        <field name="model_id" ref="model_gl_project_showcase"/>
        <field name="groups" eval="[(6, 0, [ref('project.group_project_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
