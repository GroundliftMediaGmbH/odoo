<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: project.edit_project has sheet/button_box and sheet/notebook.
         The tab and smart button are visible to EVERY internal Odoo user,
         irrespective of membership in any custom project-showcase group. -->
    <record id="view_project_form_inherit_showcase" model="ir.ui.view">
        <field name="name">project.project.form.gl.showcase</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page name="gl_project_showcase" string="Ergebnis-Landingpage"
                      groups="base.group_user">
                    <group string="Groundlift Project Showcase">
                        <field name="gl_showcase_count" invisible="1"/>
                        <button name="action_gl_open_showcase" type="object"
                                string="Ergebnis-Landingpage öffnen / anlegen" class="btn-primary"
                                icon="fa-external-link"/>
                        <div class="text-muted">Kunden-CI, Vimeo, Dokumente und Galerie getrennt von internen Projektanhängen verwalten.</div>
                    </group>
                </page>
            </xpath>
            <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_gl_open_showcase"
                        type="object" icon="fa-picture-o" groups="base.group_user">
                    <field name="gl_showcase_count" widget="statinfo" string="Showcase"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
