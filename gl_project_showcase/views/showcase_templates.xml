<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="showcase_document_card" name="Showcase Dokumentkarte"><article class="gl-document">
                                    <div class="gl-document-main">
                                        <span class="gl-file-icon" aria-hidden="true">▤</span>
                                        <div class="gl-document-title">
                                            <h3 t-esc="doc.name"/>
                                            <p t-if="doc.description" t-esc="doc.description"/>
                                            <span class="gl-document-tags" t-if="doc.tag_ids"><span t-foreach="doc.tag_ids" t-as="tag" class="gl-tag" t-esc="tag.name"/></span>
                                            <span class="gl-tag" t-if="not doc.allow_download" t-esc="labels['document_view_only']"/>
                                        </div>
                                    </div>
                                    <div class="gl-document-actions">
                                        <details t-if="doc.has_preview" class="gl-document-preview">
                                            <summary t-esc="labels['document_preview']"/>
                                            <div class="gl-preview-body" t-if="doc.mime_type == 'application/pdf'">
                                                <iframe loading="lazy" allowfullscreen="allowfullscreen" allow="fullscreen" t-att-title="labels['aria_pdf_preview']" t-att-src="'/showcase/%s/document/%s/preview' % (show.id, doc.id)"/>
                                            </div>
                                            <div class="gl-preview-body gl-image-preview" t-else="">
                                                <img loading="lazy" t-att-src="'/showcase/%s/document/%s' % (show.id, doc.id)" t-att-alt="doc.name"/>
                                            </div>
                                        </details>
                                        <a class="gl-btn gl-doc-new-window" t-if="doc.mime_type == 'application/pdf'" t-att-href="'/showcase/%s/document/%s/preview' % (show.id, doc.id)" target="_blank" rel="noopener noreferrer" t-esc="labels['document_new_window']"/>
                                        <a class="gl-btn" t-if="doc.allow_download" t-att-href="'/showcase/%s/document/%s?download=1' % (show.id, doc.id)" download="download" t-esc="labels['document_download']"/>
                                    </div>
                                </article>
                            </template><!-- Self-contained markup: a client's CI never changes Groundlift's global Odoo theme. -->
    <template id="showcase_page" name="Groundlift Projekt-Showcase">
        <html lang="de">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" t-att-content="'index,follow' if (show.visibility == 'public' and show.indexable and show.published) else 'noindex,nofollow,noarchive'"/>
                <meta name="description" t-att-content="show.subtitle or show.name"/>
                <title><t t-esc="show.name"/> · <t t-esc="labels['page_title_suffix']"/></title>
                <link rel="stylesheet" href="/gl_project_showcase/static/src/css/showcase.css"/>
                <t t-if="show.custom_font and show.font_choice == 'custom'">
                    <style t-out="'@font-face { font-family: GroundliftCustom; src: url(/showcase/%s/brand/font) format(woff2); font-display: swap; }' % show.id"/>
                </t>
                <script defer="defer" src="/gl_project_showcase/static/src/js/showcase.js"/>
            </head>
            <body class="gl-showcase" t-att-style="show.gl_css_variables">
                <a class="gl-skip" href="#gl-main" t-esc="labels['skip_link']"/>
                <header class="gl-head">
                    <div class="gl-container gl-head-inner">
                        <div class="gl-brand">
                            <t t-if="show.logo">
                                <img class="gl-logo" t-att-src="'/showcase/%s/brand/logo' % show.id" t-att-alt="show.client_label or labels['aria_logo']"/>
                            </t>
                            <t t-else="">
                                <span class="gl-brand-text" t-esc="show.client_label or labels['brand_fallback']"/>
                            </t>
                        </div>
                        <nav class="gl-nav" t-att-aria-label="labels['aria_navigation']">
                            <a href="#gl-results" t-esc="labels['nav_results']"/>
                            <a t-if="show.video_ids" href="#gl-video" t-esc="labels['nav_videos']"/>
                            <a t-if="standalone_documents" href="#gl-documents" t-esc="labels['nav_documents']"/>
                            <a t-if="show.photo_ids" href="#gl-gallery" t-esc="labels['nav_gallery']"/>
                        </nav>
                    </div>
                </header>
                <main id="gl-main">
                    <section class="gl-hero" t-att-class="'gl-hero gl-has-image' if show.header_image else 'gl-hero'">
                        <t t-if="show.header_image">
                            <img class="gl-hero-image" t-att-src="'/showcase/%s/brand/header_image' % show.id" alt=""/>
                        </t>
                        <div class="gl-hero-shade"/>
                        <div class="gl-container gl-hero-content">
                            <div class="gl-eyebrow" t-esc="show.client_label or labels['hero_eyebrow']"/>
                            <h1 t-esc="show.name"/>
                            <p class="gl-subtitle" t-if="show.subtitle" t-esc="show.subtitle"/>
                            <a class="gl-hero-link" href="#gl-results"><t t-esc="labels['hero_cta']"/> <span aria-hidden="true">↓</span></a>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-results">
                        <div class="gl-section-heading"><span class="gl-index" t-esc="labels['results_index']"/><h2 t-esc="labels['results_title']"/></div>
                        <p class="gl-prose" t-if="show.intro" t-esc="show.intro"/>
                        <p class="gl-prose gl-muted" t-else="" t-esc="labels['intro_fallback']"/>
                    </section>
                    <section class="gl-section gl-container" id="gl-video" t-if="show.video_ids">
                        <div class="gl-section-heading"><span class="gl-index" t-esc="labels['videos_index']"/><h2 t-esc="labels['videos_title']"/></div>
                        <div class="gl-video-grid">
                            <t t-foreach="show.video_ids" t-as="video">
                                <article class="gl-video-card">
                                    <div class="gl-player" t-att-data-vimeo-url="video.embed_url" t-att-data-vimeo-title="video.name">
                                        <button class="gl-video-consent" type="button" t-att-aria-label="labels['video_start']">
                                            <img class="gl-video-thumbnail" loading="eager" decoding="async" alt="" t-if="video.thumbnail_custom or video.thumbnail_vimeo" t-att-src="'/showcase/%s/video/%s/thumbnail' % (show.id, video.id)"/><span class="gl-play-icon gl-video-overlay" aria-hidden="true">▶</span>
                                            <span t-esc="labels['video_start']" class="gl-video-overlay"/>
                                            <small t-esc="labels['video_privacy']" class="gl-video-overlay"/>
                                        </button>
                                    </div>
                                    <div class="gl-card-info"><h3 t-esc="video.name"/><p t-if="video.description" t-esc="video.description"/></div>
                                <div class="gl-video-attachments" t-if="video.document_ids"><h4 t-esc="labels['video_files']"/><div class="gl-document-list gl-document-list-attached"><t t-foreach="video.document_ids" t-as="doc"><t t-call="gl_project_showcase.showcase_document_card"/></t></div></div></article>
                            </t>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-documents" t-if="standalone_documents">
                        <div class="gl-section-heading"><span class="gl-index" t-esc="labels['documents_index']"/><h2 t-esc="labels['documents_title']"/></div>
                        <div class="gl-document-list">
                            <t t-foreach="standalone_documents" t-as="doc">
                                <t t-call="gl_project_showcase.showcase_document_card"/></t>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-gallery" t-if="show.photo_ids">
                        <div class="gl-section-heading"><span class="gl-index" t-esc="labels['gallery_index']"/><h2 t-esc="labels['gallery_title']"/></div>
                        <t t-foreach="gallery_groups" t-as="group"><div class="gl-gallery-group"><h3 class="gl-gallery-group-title" t-if="group['name']" t-esc="group['name']"/><div class="gl-gallery-grid"><t t-foreach="group['photos']" t-as="photo">
                                <figure class="gl-gallery-item">
                                    <button type="button" class="gl-lightbox-open" t-att-data-src="'/showcase/%s/photo/%s' % (show.id, photo.id)" t-att-data-title="photo.name">
                                        <img loading="lazy" t-att-src="'/showcase/%s/photo/%s' % (show.id, photo.id)" t-att-alt="photo.name"/>
                                        <span class="gl-expand" aria-hidden="true">↗</span>
                                    </button>
                                    <figcaption t-if="photo.name or photo.description"><strong t-esc="photo.name"/><span t-if="photo.description" t-esc="photo.description"/></figcaption>
                                </figure>
                            </t>
                        </div></div></t></section>
                    <section class="gl-section gl-container gl-end" t-if="show.closing_text or labels['closing_body']">
                        <span class="gl-index" t-esc="labels['thanks']"/>
                        <p class="gl-prose" t-esc="show.closing_text or labels['closing_body']"/>
                    </section>
                </main>
                <footer class="gl-footer">
                    <div class="gl-container gl-footer-inner">
                        <span t-esc="show.client_label or show.name"/>
                        <div>
                            <a t-if="show.legal_notice_url" t-att-href="show.legal_notice_url" target="_blank" rel="noopener noreferrer" t-esc="labels['imprint']"/>
                            <a t-if="show.privacy_url" t-att-href="show.privacy_url" target="_blank" rel="noopener noreferrer" t-esc="labels['privacy']"/>
                        </div>
                    </div>
                </footer>
                <dialog class="gl-lightbox" t-att-aria-label="labels['aria_lightbox']">
                    <button type="button" class="gl-lightbox-close" t-att-aria-label="labels['lightbox_close']">✕</button>
                    <img alt=""/>
                    <p/>
                </dialog>
            </body>
        </html>
    </template>

    <template id="showcase_password" name="Groundlift Showcase Passwort">
        <html lang="de">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow,noarchive"/>
                <title t-esc="labels['password_browser_title']"/>
                <link rel="stylesheet" href="/gl_project_showcase/static/src/css/showcase.css"/>
            </head>
            <body class="gl-showcase gl-password-page" t-att-style="show.gl_css_variables">
                <main class="gl-password-card">
                    <div class="gl-eyebrow" t-esc="show.client_label or labels['password_eyebrow']"/>
                    <h1 t-esc="labels['password_title']"/>
                    <p t-esc="labels['password_help']"/>
                    <p class="gl-error" role="alert" t-if="error" t-esc="error"/>
                    <form t-att-action="'/showcase/%s/unlock' % show.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="gl-password" t-esc="labels['password_label']"/>
                        <input id="gl-password" name="password" type="password" required="required" autocomplete="current-password" autofocus="autofocus"/>
                        <button class="gl-btn" type="submit" t-esc="labels['password_submit']"/>
                    </form>
                </main>
            </body>
        </html>
    </template>

    <template id="showcase_pdf_viewer" name="Groundlift Showcase PDF Seitenansicht">
        <html lang="de">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow,noarchive"/>
                <title t-esc="doc.name"/>
                <link rel="stylesheet" href="/gl_project_showcase/static/src/css/pdf_viewer.css"/>
                <script src="/gl_project_showcase/static/src/js/pdf_viewer.js" defer="defer"/>
            </head>
            <body t-att-class="'gl-pdf-no-print' if not doc.allow_download else 'gl-pdf-printable'">
                <main id="gl-pdf-viewer" t-att-data-page-base="'/showcase/%s/document/%s/page/' % (show.id, doc.id)" t-att-data-pages="page_count">
                    <header class="gl-pdf-toolbar">
                        <span class="gl-pdf-title" t-esc="doc.name"/>
                        <nav class="gl-pdf-controls" t-att-aria-label="labels['aria_pdf_preview']">
                            <button id="gl-pdf-prev" type="button" t-att-aria-label="labels['document_previous']">←</button>
                            <span id="gl-pdf-counter">1 / <t t-esc="page_count"/></span>
                            <button id="gl-pdf-next" type="button" t-att-aria-label="labels['document_next']">→</button>
                            <button id="gl-pdf-zoom-out" type="button" t-att-aria-label="labels['document_zoom_out']">−</button>
                            <button id="gl-pdf-zoom-in" type="button" t-att-aria-label="labels['document_zoom_in']">+</button>
                            <button id="gl-pdf-fullscreen" type="button" t-esc="labels['document_fullscreen']"/>
                            <a t-if="doc.allow_download" class="gl-pdf-download" t-att-href="'/showcase/%s/document/%s?download=1' % (show.id, doc.id)" t-esc="labels['document_download']"/>
                        </nav>
                    </header>
                    <div class="gl-pdf-canvas">
                        <img id="gl-pdf-page-image" t-att-src="'/showcase/%s/document/%s/page/1' % (show.id, doc.id)" t-att-alt="'%s: 1' % doc.name" draggable="false"/>
                    </div>
                    <p class="gl-pdf-print-notice" t-esc="labels['document_print_blocked']"/>
                </main>
            </body>
        </html>
    </template>
</odoo>
