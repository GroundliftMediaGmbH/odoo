<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self-contained markup: a client's CI never changes Groundlift's global Odoo theme. -->
    <template id="showcase_page" name="Groundlift Projekt-Showcase">
        <html lang="de">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" t-att-content="'index,follow' if (show.visibility == 'public' and show.indexable and show.published) else 'noindex,nofollow,noarchive'"/>
                <meta name="description" t-att-content="show.subtitle or show.name"/>
                <title><t t-esc="show.name"/> · Project Showcase</title>
                <link rel="stylesheet" href="/gl_project_showcase/static/src/css/showcase.css"/>
                <t t-if="show.custom_font and show.font_choice == 'custom'">
                    <style t-out="'@font-face { font-family: GroundliftCustom; src: url(/showcase/%s/brand/font) format(woff2); font-display: swap; }' % show.id"/>
                </t>
                <script defer="defer" src="/gl_project_showcase/static/src/js/showcase.js"></script>
            </head>
            <body class="gl-showcase" t-att-style="show.gl_css_variables">
                <a class="gl-skip" href="#gl-main">Zum Inhalt springen</a>
                <header class="gl-head">
                    <div class="gl-container gl-head-inner">
                        <div class="gl-brand">
                            <t t-if="show.logo">
                                <img class="gl-logo" t-att-src="'/showcase/%s/brand/logo' % show.id" t-att-alt="show.client_label or 'Logo'"/>
                            </t>
                            <t t-else="">
                                <span class="gl-brand-text" t-esc="show.client_label or 'PROJECT SHOWCASE'"/>
                            </t>
                        </div>
                        <nav class="gl-nav" aria-label="Seitennavigation">
                            <a href="#gl-results">Ergebnisse</a>
                            <a t-if="show.video_ids" href="#gl-video">Filme</a>
                            <a t-if="show.document_ids" href="#gl-documents">Dokumente</a>
                            <a t-if="show.photo_ids" href="#gl-gallery">Galerie</a>
                        </nav>
                    </div>
                </header>
                <main id="gl-main">
                    <section class="gl-hero" t-att-class="'gl-hero gl-has-image' if show.header_image else 'gl-hero'">
                        <t t-if="show.header_image">
                            <img class="gl-hero-image" t-att-src="'/showcase/%s/brand/header_image' % show.id" alt=""/>
                        </t>
                        <div class="gl-hero-shade"></div>
                        <div class="gl-container gl-hero-content">
                            <div class="gl-eyebrow" t-esc="show.client_label or 'Projektabschluss · Ergebnisse'"/>
                            <h1 t-esc="show.name"/>
                            <p class="gl-subtitle" t-if="show.subtitle" t-esc="show.subtitle"/>
                            <a class="gl-hero-link" href="#gl-results">Ergebnisse entdecken <span aria-hidden="true">↓</span></a>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-results">
                        <div class="gl-section-heading"><span class="gl-index">01 / ÜBERBLICK</span><h2>Das Ergebnis</h2></div>
                        <p class="gl-prose" t-if="show.intro" t-esc="show.intro"/>
                        <p class="gl-prose gl-muted" t-else="">Einblicke und freigegebene Ergebnisse aus unserem gemeinsamen Projekt.</p>
                    </section>
                    <section class="gl-section gl-container" id="gl-video" t-if="show.video_ids">
                        <div class="gl-section-heading"><span class="gl-index">02 / MOVING IMAGE</span><h2>Showreel &amp; Videos</h2></div>
                        <div class="gl-video-grid">
                            <t t-foreach="show.video_ids" t-as="video">
                                <article class="gl-video-card">
                                    <div class="gl-player" t-att-data-vimeo-url="video.embed_url">
                                        <button class="gl-video-consent" type="button" aria-label="Vimeo-Video starten">
                                            <span class="gl-play-icon" aria-hidden="true">▶</span>
                                            <span>Video auf Vimeo laden</span>
                                            <small>Beim Abspielen werden Daten an Vimeo übertragen.</small>
                                        </button>
                                    </div>
                                    <div class="gl-card-info"><h3 t-esc="video.name"/><p t-if="video.description" t-esc="video.description"/></div>
                                </article>
                            </t>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-documents" t-if="show.document_ids">
                        <div class="gl-section-heading"><span class="gl-index">03 / ASSETS &amp; DOCUMENTS</span><h2>Dokumente</h2></div>
                        <div class="gl-document-list">
                            <t t-foreach="show.document_ids" t-as="doc">
                                <article class="gl-document">
                                    <div class="gl-document-main">
                                        <span class="gl-file-icon" aria-hidden="true">▤</span>
                                        <div class="gl-document-title">
                                            <h3 t-esc="doc.name"/>
                                            <p t-if="doc.description" t-esc="doc.description"/>
                                            <span class="gl-tag" t-if="not doc.allow_download">Nur Ansicht · kein Download-Button</span>
                                        </div>
                                    </div>
                                    <div class="gl-document-actions">
                                        <details t-if="doc.has_preview" class="gl-document-preview">
                                            <summary>Vorschau ansehen</summary>
                                            <div class="gl-preview-body" t-if="doc.mime_type == 'application/pdf'">
                                                <iframe loading="lazy" title="PDF-Vorschau"
                                                        t-att-src="'/showcase/%s/document/%s#toolbar=0&amp;navpanes=0' % (show.id, doc.id)"></iframe>
                                            </div>
                                            <div class="gl-preview-body gl-image-preview" t-else="">
                                                <img loading="lazy" t-att-src="'/showcase/%s/document/%s' % (show.id, doc.id)" t-att-alt="doc.name"/>
                                            </div>
                                        </details>
                                        <a class="gl-btn" t-if="doc.allow_download"
                                           t-att-href="'/showcase/%s/document/%s?download=1' % (show.id, doc.id)" download="download">Herunterladen ↓</a>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </section>
                    <section class="gl-section gl-container" id="gl-gallery" t-if="show.photo_ids">
                        <div class="gl-section-heading"><span class="gl-index">04 / STILL IMAGE</span><h2>Galerie</h2></div>
                        <div class="gl-gallery-grid">
                            <t t-foreach="show.photo_ids" t-as="photo">
                                <figure class="gl-gallery-item">
                                    <button type="button" class="gl-lightbox-open" t-att-data-src="'/showcase/%s/photo/%s' % (show.id, photo.id)" t-att-data-title="photo.name">
                                        <img loading="lazy" t-att-src="'/showcase/%s/photo/%s' % (show.id, photo.id)" t-att-alt="photo.name"/>
                                        <span class="gl-expand" aria-hidden="true">↗</span>
                                    </button>
                                    <figcaption t-if="photo.name or photo.description"><strong t-esc="photo.name"/><span t-if="photo.description" t-esc="photo.description"/></figcaption>
                                </figure>
                            </t>
                        </div>
                    </section>
                    <section class="gl-section gl-container gl-end" t-if="show.closing_text">
                        <span class="gl-index">VIELEN DANK</span>
                        <p class="gl-prose" t-esc="show.closing_text"/>
                    </section>
                </main>
                <footer class="gl-footer">
                    <div class="gl-container gl-footer-inner">
                        <span t-esc="show.client_label or show.name"/>
                        <div>
                            <a t-if="show.legal_notice_url" t-att-href="show.legal_notice_url" target="_blank" rel="noopener noreferrer">Impressum</a>
                            <a t-if="show.privacy_url" t-att-href="show.privacy_url" target="_blank" rel="noopener noreferrer">Datenschutz</a>
                        </div>
                    </div>
                </footer>
                <dialog class="gl-lightbox" aria-label="Bild in Großansicht">
                    <button type="button" class="gl-lightbox-close" aria-label="Schließen">✕</button>
                    <img alt=""/>
                    <p></p>
                </dialog>
            </body>
        </html>
    </template>

    <template id="showcase_password" name="Groundlift Showcase Passwort">
        <html lang="de">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow,noarchive"/>
                <title>Geschütztes Project Showcase</title>
                <link rel="stylesheet" href="/gl_project_showcase/static/src/css/showcase.css"/>
            </head>
            <body class="gl-showcase gl-password-page" t-att-style="show.gl_css_variables">
                <main class="gl-password-card">
                    <div class="gl-eyebrow" t-esc="show.client_label or 'GESCHÜTZTER PROJEKTBEREICH'"/>
                    <h1>Zugang zum Project Showcase</h1>
                    <p>Für diese Ergebnis-Landingpage benötigst du ein Zugangspasswort.</p>
                    <p class="gl-error" role="alert" t-if="error" t-esc="error"/>
                    <form t-att-action="'/showcase/%s/unlock' % show.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="gl-password">Passwort</label>
                        <input id="gl-password" name="password" type="password" required="required" autocomplete="current-password" autofocus="autofocus"/>
                        <button class="gl-btn" type="submit">Showcase öffnen →</button>
                    </form>
                </main>
            </body>
        </html>
    </template>
</odoo>
