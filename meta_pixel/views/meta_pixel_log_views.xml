<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meta_pixel_log_search" model="ir.ui.view">
        <field name="name">meta.pixel.log.search</field>
        <field name="model">meta.pixel.log</field>
        <field name="arch" type="xml">
            <search string="Meta Pixel Reporting">
                <field name="event_id"/>
                <field name="config_id"/>
                <field name="sale_order_id"/>
                <filter string="Käufe" name="purchases" domain="[('event_name','=','Purchase')]"/>
                <filter string="Fehler" name="errors" domain="[('status','=','error')]"/>
                <filter string="Tests" name="tests" domain="[('is_test','=',True)]"/>
                <group name="group_by">
                    <filter string="Veranstaltung" name="group_event" context="{'group_by':'event_id'}"/>
                    <filter string="Eventtyp" name="group_event_name" context="{'group_by':'event_name'}"/>
                    <filter string="Quelle" name="group_source" context="{'group_by':'source'}"/>
                    <filter string="Tag" name="group_day" context="{'group_by':'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_meta_pixel_log_list" model="ir.ui.view">
        <field name="name">meta.pixel.log.list</field>
        <field name="model">meta.pixel.log</field>
        <field name="arch" type="xml">
            <list string="Meta Pixel Ereignisse" create="false" decoration-danger="status == 'error'" decoration-muted="status == 'blocked'" decoration-info="is_test">
                <field name="create_date"/>
                <field name="event_id"/>
                <field name="event_name"/>
                <field name="source"/>
                <field name="status"/>
                <field name="is_test"/>
                <field name="value" sum="Umsatz"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sale_order_id" optional="show"/>
                <field name="config_id" optional="hide"/>
                <field name="response_code" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_meta_pixel_log_form" model="ir.ui.view">
        <field name="name">meta.pixel.log.form</field>
        <field name="model">meta.pixel.log</field>
        <field name="arch" type="xml">
            <form string="Meta Pixel Ereignis" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="event_id"/>
                            <field name="event_name"/>
                            <field name="event_uid"/>
                            <field name="source"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="config_id"/>
                            <field name="sale_order_id"/>
                            <field name="is_test"/>
                            <field name="value"/>
                            <field name="currency_id"/>
                            <field name="response_code"/>
                        </group>
                    </group>
                    <group><field name="page_url"/><field name="response_message"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_meta_pixel_log_pivot" model="ir.ui.view">
        <field name="name">meta.pixel.log.pivot</field>
        <field name="model">meta.pixel.log</field>
        <field name="arch" type="xml">
            <pivot string="Meta Pixel Reporting">
                <field name="event_id" type="row"/>
                <field name="event_name" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_meta_pixel_log_graph" model="ir.ui.view">
        <field name="name">meta.pixel.log.graph</field>
        <field name="model">meta.pixel.log</field>
        <field name="arch" type="xml">
            <graph string="Meta Pixel Reporting" type="bar">
                <field name="create_date" interval="day"/>
                <field name="event_name"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_meta_pixel_reporting" model="ir.actions.act_window">
        <field name="name">Reporting</field>
        <field name="res_model">meta.pixel.log</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_meta_pixel_log_search"/>
    </record>
</odoo>
