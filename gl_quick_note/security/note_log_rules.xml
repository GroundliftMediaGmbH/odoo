<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_gl_quick_note_logs_own" model="ir.rule">
        <field name="name">Schnell-Notiz: eigene Übertragungen</field>
        <field name="model_id" ref="model_gl_quick_note_log"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_gl_quick_note_logs_admin" model="ir.rule">
        <field name="name">Schnell-Notiz: Administration</field>
        <field name="model_id" ref="model_gl_quick_note_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
