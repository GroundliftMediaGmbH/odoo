<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_quick_note" model="ir.ui.view">
        <field name="name">res.config.settings.gl.quick.note</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="gl_quick_note" string="Schnell-Notiz">
                    <block title="OpenAI (optionale KI-Verarbeitung)">
                        <setting string="API-Schlüssel" help="Notiztexte werden bei aktivierter KI an die OpenAI API übertragen. Nur Administratoren können den Schlüssel ändern.">
                            <field name="gl_quick_note_api_key" password="True" placeholder="sk-..."/>
                        </setting>
                        <setting string="Modell" help="Voreinstellung gpt-4.1-mini; Chat-Completions-API mit JSON-Ausgabe.">
                            <field name="gl_quick_note_model" placeholder="gpt-4.1-mini"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
