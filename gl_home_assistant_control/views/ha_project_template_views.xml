<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_project_template_list" model="ir.ui.view">
        <field name="name">gl.ha.project.template.list</field>
        <field name="model">gl.ha.project.template</field>
        <field name="arch" type="xml">
            <list string="Projekt-Vorlagen">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="target_entity_ids" widget="many2many_tags"/>
                <field name="minutes_before"/>
                <field name="minutes_after"/>
                <field name="condition_entity_ids" widget="many2many_tags" optional="show"/>
                <field name="solar_clear_before_minutes" optional="hide"/>
                <field name="solar_cloudy_before_minutes" optional="hide"/>
                <field name="solar_cloud_threshold" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_project_template_form" model="ir.ui.view">
        <field name="name">gl.ha.project.template.form</field>
        <field name="model">gl.ha.project.template</field>
        <field name="arch" type="xml">
            <form string="Projekt-Vorlage">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="z. B. Private Kinobuchung"/></h1></div>
                    <group>
                        <group string="Vorlage">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="target_entity_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="minutes_before"/>
                            <field name="minutes_after"/>
                            <field name="notes" placeholder="Optionaler Hinweis zur Verwendung dieser Vorlage ..."/>
                            <p class="text-muted">Beispiel „Private Kinobuchung“: Licht und Lüftung auswählen, 60 Minuten Vorlauf und 60 Minuten Nachlauf. Beim Projekt wird diese Vorlage ausgewählt; die kopierten Werte können dort anschließend individuell angepasst werden.</p>
                        </group>
                        <group string="Optionale Sensorbedingungen">
                            <field name="has_solar_condition" invisible="1"/>
                            <field name="has_cloud_condition" invisible="1"/>
                            <field name="has_generic_condition" invisible="1"/>
                            <field name="condition_entity_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="condition_match_mode" invisible="not has_generic_condition"/>
                            <field name="condition_operator" invisible="not has_generic_condition"/>
                            <field name="condition_threshold" invisible="not has_generic_condition"/>
                            <field name="solar_clear_before_minutes" invisible="not has_solar_condition"/>
                            <field name="solar_cloudy_before_minutes" invisible="not has_solar_condition or not has_cloud_condition"/>
                            <field name="solar_cloud_threshold" invisible="not has_solar_condition or not has_cloud_condition"/>
                            <p class="text-muted" invisible="not has_solar_condition">Sonnenzeit- und Bewölkungswerte werden beim Anwenden der Vorlage vollständig in die Projektregel übernommen.</p>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_ha_project_template" model="ir.actions.act_window">
        <field name="name">Projekt-Vorlagen</field>
        <field name="res_model">gl.ha.project.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
