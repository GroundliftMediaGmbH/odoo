<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_heating_system_list" model="ir.ui.view">
        <field name="name">gl.ha.heating.system.list</field>
        <field name="model">gl.ha.heating.system</field>
        <field name="arch" type="xml">
            <list string="Heizsysteme">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="pump_entity_id"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_heating_system_form" model="ir.ui.view">
        <field name="name">gl.ha.heating.system.form</field>
        <field name="model">gl.ha.heating.system</field>
        <field name="arch" type="xml">
            <form string="Heizsystem">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Gemeinsame Heizung">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="pump_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <p class="text-muted">Die Pumpe läuft automatisch, sobald mindestens eine zugeordnete Raumzone Wärme anfordert. Fordert keine Zone Wärme an, wird sie ausgeschaltet.</p>
                        </group>
                    </group>
                    <separator string="Raumthermostate"/>
                    <field name="zone_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="active"/>
                            <field name="name"/>
                            <field name="temperature_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="valve_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="ventilation_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="base_setpoint"/>
                            <field name="heat_demand" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_ha_thermostat_zone_list" model="ir.ui.view">
        <field name="name">gl.ha.thermostat.zone.list</field>
        <field name="model">gl.ha.thermostat.zone</field>
        <field name="arch" type="xml">
            <list string="Raumthermostate">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="heating_system_id"/>
                <field name="temperature_entity_id"/>
                <field name="base_setpoint"/>
                <field name="last_effective_setpoint"/>
                <field name="last_temperature"/>
                <field name="heat_demand"/>
                <field name="last_setpoint_source" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_thermostat_zone_form" model="ir.ui.view">
        <field name="name">gl.ha.thermostat.zone.form</field>
        <field name="model">gl.ha.thermostat.zone</field>
        <field name="arch" type="xml">
            <form string="Raumthermostat">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Raum &amp; Geräte">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="heating_system_id"/>
                            <field name="temperature_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="valve_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="ventilation_entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <p class="text-muted">Die Lüftung ist optional. Bei Heizbedarf wird sie als zusätzliche EIN-Anforderung behandelt. Eine laufende Veranstaltungs-/Kino-Automatik kann sie deshalb weiterhin eingeschaltet halten.</p>
                        </group>
                        <group string="Temperaturregelung">
                            <field name="base_setpoint"/>
                            <field name="hysteresis"/>
                            <field name="min_setpoint"/>
                            <field name="max_setpoint"/>
                            <field name="dashboard_step"/>
                            <p class="text-muted">Beispiel: Soll 22,0 °C und Hysterese 0,5 K → Heizen EIN bei ≤ 21,75 °C und AUS bei ≥ 22,25 °C.</p>
                        </group>
                    </group>

                    <separator string="Solltemperatur nach Veranstaltungs-/Kino-/Projekt-Zeitslot"/>
                    <div class="text-muted mb-2">Ist kein Eintrag aktiv, gilt die Grundtemperatur. Überlappen mehrere Einträge, gewinnt die höchste Solltemperatur. Vor- und Nachlauf erlauben z. B. Vorheizen vor Kinobeginn.</div>
                    <field name="profile_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="active"/>
                            <field name="priority" optional="hide"/>
                            <field name="name" optional="show"/>
                            <field name="source"/>
                            <field name="room_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="setpoint"/>
                            <field name="minutes_before"/>
                            <field name="minutes_after"/>
                        </list>
                    </field>

                    <separator string="Aktueller Status"/>
                    <group>
                        <group>
                            <field name="last_temperature" readonly="1"/>
                            <field name="last_effective_setpoint" readonly="1"/>
                            <field name="heat_demand" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_setpoint_source" readonly="1"/>
                            <field name="manual_setpoint" readonly="1"/>
                            <field name="manual_override_until" readonly="1"/>
                            <field name="last_evaluated_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="last_message" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_ha_heating_system" model="ir.actions.act_window">
        <field name="name">Heizsysteme</field>
        <field name="res_model">gl.ha.heating.system</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gl_ha_thermostat_zone" model="ir.actions.act_window">
        <field name="name">Raumthermostate</field>
        <field name="res_model">gl.ha.thermostat.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
