<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_schedule_list" model="ir.ui.view">
        <field name="name">gl.ha.schedule.window.list</field>
        <field name="model">gl.ha.schedule.window</field>
        <field name="arch" type="xml">
            <list string="Automatik-Zeitfenster" create="0" edit="0" delete="0">
                <field name="source"/>
                <field name="name"/>
                <field name="details"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="source_ref" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_gl_ha_schedule" model="ir.actions.act_window">
        <field name="name">Zeitfenster</field>
        <field name="res_model">gl.ha.schedule.window</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
