<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_alert_list" model="ir.ui.view">
        <field name="name">gl.ha.alert.list</field>
        <field name="model">gl.ha.alert</field>
        <field name="arch" type="xml">
            <list string="Warnungen" decoration-danger="severity == 'critical' and state == 'open'" decoration-warning="severity == 'warning' and state == 'open'" decoration-muted="state == 'resolved'">
                <field name="state"/>
                <field name="severity"/>
                <field name="name"/>
                <field name="entity_id"/>
                <field name="message"/>
                <field name="first_seen"/>
                <field name="last_seen"/>
                <field name="occurrence_count"/>
                <button name="action_resolve" type="object" string="Erledigt" invisible="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_alert_form" model="ir.ui.view">
        <field name="name">gl.ha.alert.form</field>
        <field name="model">gl.ha.alert</field>
        <field name="arch" type="xml">
            <form string="Home Assistant Warnung">
                <header><button name="action_resolve" type="object" string="Als erledigt markieren" invisible="state == 'resolved'"/></header>
                <sheet>
                    <group>
                        <field name="state" readonly="1"/>
                        <field name="severity" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="entity_id" readonly="1"/>
                        <field name="message" readonly="1"/>
                        <field name="first_seen" readonly="1"/>
                        <field name="last_seen" readonly="1"/>
                        <field name="resolved_at" readonly="1"/>
                        <field name="occurrence_count" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gl_ha_alert" model="ir.actions.act_window">
        <field name="name">Warnungen</field>
        <field name="res_model">gl.ha.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>
