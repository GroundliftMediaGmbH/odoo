<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_device_access_list" model="ir.ui.view">
        <field name="name">gl.ha.device.access.list</field>
        <field name="model">gl.ha.device.access</field>
        <field name="arch" type="xml">
            <list string="Externe Gerätezugänge">
                <field name="active"/>
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="allow_main_page"/>
                <field name="allow_control"/>
                <field name="access_state"/>
                <field name="registered_at" optional="show"/>
                <field name="last_seen_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_device_access_form" model="ir.ui.view">
        <field name="name">gl.ha.device.access.form</field>
        <field name="model">gl.ha.device.access</field>
        <field name="arch" type="xml">
            <form string="Externer Gerätezugang">
                <header>
                    <button name="action_open_external" type="object" string="Geräte-Dashboard öffnen" class="oe_highlight" invisible="not public_key_jwk"/>
                    <button name="action_regenerate_setup" type="object" string="Gerät neu binden" invisible="not public_key_jwk"/>
                    <button name="action_regenerate_setup" type="object" string="Neuen Einrichtungslink erzeugen" invisible="public_key_jwk"/>
                    <button name="action_revoke_binding" type="object" string="Bindung aufheben" invisible="not public_key_jwk" confirm="Soll die Gerätebindung wirklich aufgehoben werden? Der Rechner verliert sofort den Zugriff."/>
                    <field name="access_state" widget="statusbar" statusbar_visible="waiting,registered,expired,disabled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="z. B. Kinokasse"/></h1></div>
                    <group>
                        <group string="Gerät">
                            <field name="active"/>
                            <field name="public_id" readonly="1"/>
                            <field name="registered_at" readonly="1"/>
                            <field name="last_seen_at" readonly="1"/>
                            <field name="last_user_agent" readonly="1"/>
                            <field name="key_fingerprint" readonly="1"/>
                        </group>
                        <group string="Freigabe">
                            <field name="dashboard_id"/>
                            <field name="allow_main_page"/>
                            <field name="page_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="allow_control"/>
                            <p class="text-muted">Die externe Steuerung funktioniert nur, wenn zusätzlich auf der jeweiligen Dashboard-Seite „Steuerung erlauben“ aktiv ist.</p>
                        </group>
                    </group>
                    <group string="Gerätebindung / externer Zugriff">
                        <group>
                            <field name="setup_url" widget="url" readonly="1"/>
                            <field name="setup_expires_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="external_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>So funktioniert die Bindung:</strong>
                        Öffnen Sie den Einrichtungslink einmalig direkt auf dem gewünschten Windows- oder Mac-Rechner.
                        Der Browser erzeugt dort einen nicht exportierbaren kryptografischen Geräteschlüssel. Danach reicht weder der Link noch ein kopiertes Passwort oder Cookie auf einem anderen Rechner aus. Wird das Browserprofil gelöscht oder gewechselt, muss das Gerät neu gebunden werden.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_ha_device_access" model="ir.actions.act_window">
        <field name="name">Gerätezugänge</field>
        <field name="res_model">gl.ha.device.access</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
