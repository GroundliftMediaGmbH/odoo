<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_ha_rule_list" model="ir.ui.view">
        <field name="name">gl.ha.automation.rule.list</field>
        <field name="model">gl.ha.automation.rule</field>
        <field name="arch" type="xml">
            <list string="Automatikregeln">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="source"/>
                <field name="project_id" optional="show" invisible="source != 'project'"/>
                <field name="project_template_id" optional="show" invisible="source != 'project'"/>
                <field name="target_entity_ids" widget="many2many_tags"/>
                <field name="minutes_before" invisible="source in ['daily', 'dewpoint']"/>
                <field name="minutes_after" invisible="source in ['daily', 'dewpoint']"/>
                <field name="project_start_at" optional="show" invisible="source != 'project'"/>
                <field name="project_end_at" optional="show" invisible="source != 'project'"/>
                <field name="daily_start_hour" widget="float_time" invisible="source != 'daily'"/>
                <field name="daily_end_hour" widget="float_time" invisible="source != 'daily'"/>
                <field name="dewpoint_outside_entity_id" optional="show" invisible="source != 'dewpoint'"/>
                <field name="dewpoint_inside_entity_id" optional="show" invisible="source != 'dewpoint'"/>
                <field name="dewpoint_delta_threshold" optional="show" invisible="source != 'dewpoint'"/>
                <field name="dewpoint_min_runtime_minutes" optional="hide" invisible="source != 'dewpoint'"/>
                <field name="dewpoint_max_runtime_minutes" optional="show" invisible="source != 'dewpoint'"/>
                <field name="condition_entity_ids" widget="many2many_tags" optional="show"/>
                <field name="condition_match_mode" optional="hide"/>
                <field name="condition_threshold_mode" optional="show"/>
                <field name="condition_threshold" optional="show" invisible="condition_threshold_mode == 'hysteresis'"/>
                <field name="condition_on_threshold" optional="show" invisible="condition_threshold_mode != 'hysteresis'"/>
                <field name="condition_hysteresis" optional="show" invisible="condition_threshold_mode != 'hysteresis'"/>
                <field name="solar_clear_before_minutes" optional="hide"/>
                <field name="solar_cloudy_before_minutes" optional="hide"/>
                <field name="solar_cloud_threshold" optional="hide"/>
                <field name="last_desired_state"/>
                <field name="last_evaluated_at"/>
            </list>
        </field>
    </record>

    <record id="view_gl_ha_rule_form" model="ir.ui.view">
        <field name="name">gl.ha.automation.rule.form</field>
        <field name="model">gl.ha.automation.rule</field>
        <field name="arch" type="xml">
            <form string="Automatikregel">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Zeitquelle und Ziele" col="2">
                            <!--
                                Die Labels werden absichtlich explizit ausgegeben.
                                In Odoo 19 kann die automatische Label-Erzeugung in
                                dieser gemischten Gruppe (dynamisch unsichtbare Felder,
                                M2M-Tags und Hilfetexte) je nach View-Rendering entfallen.
                                Mit label + nolabel bleibt die Beschriftung stabil.
                            -->
                            <label for="active" string="Aktiv"/>
                            <field name="active" nolabel="1"/>

                            <label for="sequence" string="Reihenfolge"/>
                            <field name="sequence" nolabel="1"/>

                            <label for="source" string="Automatiktyp / Quelle"/>
                            <field name="source" nolabel="1"/>

                            <label for="project_id" string="Odoo-Projekt" invisible="source != 'project'"/>
                            <field name="project_id" nolabel="1" invisible="source != 'project'" options="{'no_create': True}"/>

                            <label for="project_template_id" string="Projekt-Vorlage" invisible="source != 'project'"/>
                            <field name="project_template_id" nolabel="1" invisible="source != 'project'" options="{'no_create': True, 'no_create_edit': True}"/>

                            <label for="project_start_at" string="Projektbeginn" invisible="source != 'project'"/>
                            <field name="project_start_at" nolabel="1" invisible="source != 'project'"/>

                            <label for="project_end_at" string="Projektende" invisible="source != 'project'"/>
                            <field name="project_end_at" nolabel="1" invisible="source != 'project'"/>

                            <label for="target_entity_ids" string="Zu schaltende Entitäten"/>
                            <field name="target_entity_ids"
                                   nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>

                            <label for="minutes_before" string="Einschalten vor Beginn (Min.)" invisible="source in ['daily', 'dewpoint']"/>
                            <field name="minutes_before" nolabel="1" invisible="source in ['daily', 'dewpoint']"/>

                            <label for="minutes_after" string="Ausschalten nach Ende (Min.)" invisible="source in ['daily', 'dewpoint']"/>
                            <field name="minutes_after" nolabel="1" invisible="source in ['daily', 'dewpoint']"/>

                            <label for="daily_start_hour" string="Einschalten um" invisible="source != 'daily'"/>
                            <field name="daily_start_hour" nolabel="1" widget="float_time" invisible="source != 'daily'"/>

                            <label for="daily_end_hour" string="Ausschalten um" invisible="source != 'daily'"/>
                            <field name="daily_end_hour" nolabel="1" widget="float_time" invisible="source != 'daily'"/>
                            <group string="Wochentage" invisible="source != 'daily'" col="7">
                                <field name="daily_monday"/>
                                <field name="daily_tuesday"/>
                                <field name="daily_wednesday"/>
                                <field name="daily_thursday"/>
                                <field name="daily_friday"/>
                                <field name="daily_saturday"/>
                                <field name="daily_sunday"/>
                            </group>
                            <p class="text-muted">Eine Regel kann mehrere Schalter/Lichter gleichzeitig steuern. Alle ausgewählten Entitäten erhalten dieselbe Automatikentscheidung.</p>
                            <p class="text-muted" invisible="source != 'cinema'">Bei Kino wird pro Kalendertag ein gemeinsames Betriebsfenster gebildet: Vorlauf vor der ersten Vorstellung, Nachlauf nach dem Ende der letzten Vorstellung. Zwischen den Vorstellungen bleibt das Zeitfenster aktiv.</p>
                            <p class="text-muted" invisible="source != 'daily'">Das tägliche Zeitprogramm schaltet die ausgewählten Geräte an den gewählten Wochentagen zur eingestellten Uhrzeit ein und wieder aus. Beispiel: Lüftung täglich AN 08:00, AUS 08:30. Für mehrere Zeitblöcke am selben Tag einfach mehrere Regeln für dieselbe Entität anlegen.</p>
                            <p class="text-muted" invisible="source != 'daily'">Liegt die Ausschaltzeit vor der Einschaltzeit, läuft das Zeitfenster automatisch über Mitternacht, z. B. 23:00–01:00.</p>
                            <p class="text-muted" invisible="source != 'project'">Bei einer Projekt-Automatik wählst du das Odoo-Projekt aus und trägst den für die Gebäudesteuerung relevanten Beginn und das Ende manuell ein. Bei Ende nach Mitternacht bitte das Folgedatum verwenden, z. B. 12.02.2027 14:00 bis 13.02.2027 03:00.</p>
                            <p class="text-muted" invisible="source != 'project'">Eine Projekt-Vorlage übernimmt Geräte, Vor-/Nachlauf und optionale Sensorbedingungen. Die übernommenen Werte bleiben in der konkreten Projektregel frei anpassbar.</p>
                            <p class="text-muted" invisible="source != 'project'">Wenn sich Projekt-, Kino-, Veranstaltungs- oder Zeitregeln für dasselbe Gerät überschneiden, bleibt das Gerät eingeschaltet, solange mindestens eine dieser Regeln noch aktiv ist.</p>
                            <p class="text-muted" invisible="source != 'project_lounge'">Diese Regel reagiert auf Odoo-Projekte, in denen „Gebäude-Automation“ aktiv ist und der Raum Lounge ausgewählt wurde.</p>
                            <p class="text-muted" invisible="source != 'project_podcast'">Diese Regel reagiert auf Odoo-Projekte, in denen „Gebäude-Automation“ aktiv ist und der Raum Podcaststudio ausgewählt wurde.</p>
                            <p class="text-muted" invisible="source != 'dewpoint'">Taupunkt-Trocknung vergleicht Innen- und Außen-Taupunkt. Die ausgewählten Lüftungen schalten ein, sobald innen − außen mindestens die eingestellte Differenz erreicht. Betriebsblocker haben immer Vorrang.</p>
                        </group>
                        <group string="Optionale Sensorbedingungen" col="2" invisible="source == 'dewpoint'">
                            <field name="has_solar_condition" invisible="1"/>
                            <field name="has_cloud_condition" invisible="1"/>
                            <field name="has_generic_condition" invisible="1"/>

                            <label for="condition_entity_ids" string="Optionale Messsensoren"/>
                            <field name="condition_entity_ids"
                                   nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>

                            <label for="condition_match_mode" string="Verknüpfung der Sensoren" invisible="not has_generic_condition"/>
                            <field name="condition_match_mode" nolabel="1" invisible="not has_generic_condition"/>

                            <label for="condition_operator" string="Operator" invisible="not has_generic_condition"/>
                            <field name="condition_operator" nolabel="1" invisible="not has_generic_condition"/>

                            <label for="condition_threshold_mode" string="Grenzwert-Logik" invisible="not has_generic_condition"/>
                            <field name="condition_threshold_mode" nolabel="1" invisible="not has_generic_condition"/>

                            <label for="condition_threshold" string="Grenzwert" invisible="not has_generic_condition or condition_threshold_mode != 'simple'"/>
                            <field name="condition_threshold" nolabel="1" invisible="not has_generic_condition or condition_threshold_mode != 'simple'"/>

                            <label for="condition_on_threshold" string="Einschaltschwelle" invisible="not has_generic_condition or condition_threshold_mode != 'hysteresis'"/>
                            <field name="condition_on_threshold" nolabel="1" invisible="not has_generic_condition or condition_threshold_mode != 'hysteresis'"/>

                            <label for="condition_hysteresis" string="Hysterese" invisible="not has_generic_condition or condition_threshold_mode != 'hysteresis'"/>
                            <field name="condition_hysteresis" nolabel="1" invisible="not has_generic_condition or condition_threshold_mode != 'hysteresis'"/>
                            <field name="condition_hysteresis_latched" invisible="1"/>

                            <label for="solar_clear_before_minutes" string="Bei wenig Bewölkung: Minuten vor Sonnenzeit" invisible="not has_solar_condition"/>
                            <field name="solar_clear_before_minutes" nolabel="1" invisible="not has_solar_condition"/>

                            <label for="solar_cloudy_before_minutes" string="Bei Bewölkung: Minuten vor Sonnenzeit" invisible="not has_solar_condition or not has_cloud_condition"/>
                            <field name="solar_cloudy_before_minutes" nolabel="1" invisible="not has_solar_condition or not has_cloud_condition"/>

                            <label for="solar_cloud_threshold" string="Ab Bewölkung (%)" invisible="not has_solar_condition or not has_cloud_condition"/>
                            <field name="solar_cloud_threshold" nolabel="1" invisible="not has_solar_condition or not has_cloud_condition"/>

                            <p class="text-muted" invisible="not has_solar_condition">Sonnenaufgang oder Sonnenuntergang wird als dynamischer Zeitanker verwendet. Die tatsächliche Einschaltzeit ist die spätere Zeit aus dem normalen Vorlauf der Regel und dem Sonnen-Trigger. Das Ausschalten bleibt unverändert am Ende der Veranstaltung/des Projekts/Zeitprogramms plus Nachlauf.</p>
                            <p class="text-muted" invisible="not has_solar_condition or not has_cloud_condition">Beispiel: Sonnenuntergang + Bewölkung auswählen, 60 Minuten bei wenig Bewölkung, 90 Minuten bei Bewölkung und z. B. 60 % Grenzwert. Für die Entscheidung wird die Bewölkungsprognose zur Sonnenzeit verwendet, damit das Licht nicht bei wechselnder Bewölkung wieder aus- und eingeschaltet wird.</p>
                            <p class="text-muted" invisible="not has_generic_condition or condition_threshold_mode != 'simple'">Einfacher Grenzwert: Die Bedingung wird bei jedem Lauf direkt mit Operator und Grenzwert ausgewertet.</p>
                            <p class="text-muted" invisible="not has_generic_condition or condition_threshold_mode != 'hysteresis'">Hysterese verhindert Flattern an der Schwelle. Beispiel Licht: „kleiner als“, Einschaltschwelle 250 Lux und Hysterese 50 Lux bedeutet EIN unter 250 Lux; nach dem Einschalten erst wieder AUS ab 300 Lux. Bei „größer als“ wird die Ausschaltschwelle entsprechend unter die Einschaltschwelle gelegt. Nach Ende des Zeitfensters wird die Hysterese zurückgesetzt.</p>
                        </group>
                        <group string="Taupunkt-Trocknung" col="2" invisible="source != 'dewpoint'">
                            <label for="dewpoint_outside_entity_id" string="Taupunkt außen"/>
                            <field name="dewpoint_outside_entity_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True}"/>

                            <label for="dewpoint_inside_entity_id" string="Taupunkt innen"/>
                            <field name="dewpoint_inside_entity_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True}"/>

                            <label for="dewpoint_delta_threshold" string="Mindest-Taupunktdifferenz (°C)"/>
                            <field name="dewpoint_delta_threshold" nolabel="1"/>

                            <label for="dewpoint_min_runtime_minutes" string="Mindestlaufzeit (Min.)"/>
                            <field name="dewpoint_min_runtime_minutes" nolabel="1"/>

                            <label for="dewpoint_max_runtime_minutes" string="Maximallaufzeit (Min.)"/>
                            <field name="dewpoint_max_runtime_minutes" nolabel="1"/>

                            <separator string="Während Betrieb nicht trocknen" colspan="2"/>
                            <label for="dewpoint_block_event" string="Veranstaltungsbetrieb"/>
                            <field name="dewpoint_block_event" nolabel="1"/>
                            <label for="dewpoint_block_cinema" string="Kinobetrieb"/>
                            <field name="dewpoint_block_cinema" nolabel="1"/>
                            <label for="dewpoint_block_project" string="Projektbetrieb"/>
                            <field name="dewpoint_block_project" nolabel="1"/>

                            <separator string="Aktueller Trocknungszyklus" colspan="2"/>
                            <label for="dewpoint_running_since" string="Läuft seit"/>
                            <field name="dewpoint_running_since" nolabel="1" readonly="1"/>
                            <label for="dewpoint_max_latched" string="Maximallaufzeit erreicht"/>
                            <field name="dewpoint_max_latched" nolabel="1" readonly="1"/>

                            <p class="text-muted" colspan="2">Beispiel: Taupunkt Theater 12 °C, Taupunkt außen 8 °C und Schwelle 2 °C → Differenz 4 K, die Trocknung darf starten. Nach Erreichen der Maximallaufzeit bleibt sie aus, bis die Differenz einmal wieder unter die Schwelle fällt. Beginnt ein gewählter Veranstaltungs-, Kino- oder Projektbetrieb, wird die Trocknung unabhängig von der Mindestlaufzeit sofort beendet.</p>
                        </group>
                    </group>
                    <!-- Legacy-Felder nur für verlustfreie Updates älterer Regeln. -->
                    <field name="target_entity_id" invisible="1"/>
                    <field name="condition_entity_id" invisible="1"/>
                    <group string="Letzte Auswertung">
                        <field name="last_evaluated_at" readonly="1"/>
                        <field name="last_desired_state" readonly="1"/>
                        <field name="last_action_at" readonly="1"/>
                        <field name="last_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_ha_rule" model="ir.actions.act_window">
        <field name="name">Automatikregeln</field>
        <field name="res_model">gl.ha.automation.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
