<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gl_ha_sync_states" model="ir.cron">
        <field name="name">GROUNDLIFT Home Assistant: Zustände prüfen</field>
        <field name="model_id" ref="model_gl_ha_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_gl_ha_refresh_schedules" model="ir.cron">
        <field name="name">GROUNDLIFT Home Assistant: Event/Kino-Zeitfenster</field>
        <field name="model_id" ref="model_gl_ha_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_schedules()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_gl_ha_sync_weather" model="ir.cron">
        <field name="name">GROUNDLIFT Home Assistant: Wetter &amp; Sonne</field>
        <field name="model_id" ref="model_gl_ha_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_weather()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_gl_ha_automation" model="ir.cron">
        <field name="name">GROUNDLIFT Home Assistant: Automatik auswerten</field>
        <field name="model_id" ref="model_gl_ha_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_run_automation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_gl_ha_cleanup_history" model="ir.cron">
        <field name="name">GROUNDLIFT Home Assistant: Historie bereinigen</field>
        <field name="model_id" ref="model_gl_ha_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_history()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
