<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gl_home_assistant" model="ir.module.category">
        <field name="name">Gebäudesteuerung</field>
        <field name="description">Home Assistant, Sensorik und Gebäudeautomation</field>
        <field name="sequence">65</field>
    </record>

    <record id="res_groups_privilege_gl_home_assistant" model="res.groups.privilege">
        <field name="name">Home Assistant</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="gl_home_assistant_control.module_category_gl_home_assistant"/>
    </record>

    <record id="group_ha_viewer" model="res.groups">
        <field name="name">Anzeige</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="gl_home_assistant_control.res_groups_privilege_gl_home_assistant"/>
    </record>

    <record id="group_ha_operator" model="res.groups">
        <field name="name">Steuerung</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="gl_home_assistant_control.res_groups_privilege_gl_home_assistant"/>
        <field name="implied_ids" eval="[(4, ref('gl_home_assistant_control.group_ha_viewer'))]"/>
    </record>

    <record id="group_ha_manager" model="res.groups">
        <field name="name">Administration</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="gl_home_assistant_control.res_groups_privilege_gl_home_assistant"/>
        <field name="implied_ids" eval="[(4, ref('gl_home_assistant_control.group_ha_operator'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
