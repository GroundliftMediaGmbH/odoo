<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Servicepersonal
         ============================================================ -->
    <record id="view_gl_service_staff_member_list" model="ir.ui.view">
        <field name="name">gl.service.staff.member.list</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <list string="Servicepersonal" editable="bottom">
                <field name="employee_id"/>
                <field name="email"/>
                <field name="monthly_summary_opt_in" string="Monatsmail"/>
                <field name="pin_code" optional="hide"/>
                <field name="active"/>
                <button name="action_open_portal" type="object" string="Webseite öffnen" class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_staff_member_form" model="ir.ui.view">
        <field name="name">gl.service.staff.member.form</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <form string="Servicepersonal">
                <header>
                    <button name="action_open_portal" type="object" string="Mitarbeiter-Webseite öffnen" class="btn-primary"/>
                    <button name="action_generate_new_pin" type="object" string="Neuen PIN erzeugen" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="email"/>
                            <field name="active"/>
                            <field name="monthly_summary_opt_in"/>
                        </group>
                        <group>
                            <field name="pin_code"/>
                            <field name="portal_url" readonly="1" widget="url"/>
                            <field name="monthly_unsubscribe_url" readonly="1" widget="url" invisible="not monthly_unsubscribe_url"/>
                            <field name="last_monthly_summary_period" readonly="1" invisible="not last_monthly_summary_period"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notiz">
                            <field name="note" placeholder="Interne Hinweise ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_staff_member_search" model="ir.ui.view">
        <field name="name">gl.service.staff.member.search</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <search string="Servicepersonal suchen">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="email"/>
                <filter string="Aktiv" name="active_members" domain="[('active','=',True)]"/>
                <filter string="Monatsmail aktiv" name="monthly_mail" domain="[('monthly_summary_opt_in','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_service_staff_member" model="ir.actions.act_window">
        <field name="name">Mitarbeiter</field>
        <field name="res_model">gl.service.staff.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_members': 1}</field>
    </record>

    <!-- ============================================================
         Zuteilungen / Antworten
         ============================================================ -->
    <record id="view_gl_service_shift_line_list" model="ir.ui.view">
        <field name="name">gl.service.shift.line.list</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <list string="Servicepersonal-Zuteilungen" editable="bottom"
                  decoration-success="state == 'accepted' and role == 'desired'"
                  decoration-info="state == 'available' or (state == 'accepted' and role == 'reserve')"
                  decoration-danger="state in ('declined', 'expired') or time_change_state == 'declined'"
                  decoration-warning="state == 'invited' or time_change_state == 'pending'">
                <field name="shift_id"/>
                <field name="member_id"/>
                <field name="state"/>
                <field name="role" optional="hide"/>
                <field name="selected_for_booking" invisible="state != 'available'"/>
                <field name="planned_start_datetime"/>
                <field name="planned_end_datetime"/>
                <field name="time_change_state" readonly="1" optional="show"/>
                <field name="time_change_warning" readonly="1" optional="hide"/>
                <field name="availability_responded_at" readonly="1" optional="hide"/>
                <button name="action_send_invitation" type="object" string="Verfügbarkeit mailen" class="btn-secondary" invisible="state == 'available' or (state == 'accepted' and role == 'desired')"/>
                <button name="action_book_fixed" type="object" string="Fest buchen" class="btn-primary" invisible="state != 'available'"/>
                <button name="action_mark_available_manual" type="object" string="Verfügbar" invisible="state == 'available' or (state == 'accepted' and role == 'desired')"/>
                <button name="action_mark_unavailable_manual" type="object" string="Nicht verfügbar" invisible="state == 'accepted' and role == 'desired'"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_shift_line_form" model="ir.ui.view">
        <field name="name">gl.service.shift.line.form</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <form string="Servicepersonal-Zuteilung">
                <header>
                    <button name="action_send_invitation" type="object" string="Verfügbarkeit mailen" class="btn-secondary" invisible="state == 'available' or (state == 'accepted' and role == 'desired')"/>
                    <button name="action_book_fixed" type="object" string="Fest buchen" class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_mark_available_manual" type="object" string="Manuell verfügbar" invisible="state == 'available' or (state == 'accepted' and role == 'desired')"/>
                    <button name="action_mark_unavailable_manual" type="object" string="Manuell nicht verfügbar" invisible="state == 'accepted' and role == 'desired'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invited,available,accepted,declined"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="member_id"/>
                            <field name="role" invisible="1"/>
                            <field name="email" readonly="1"/>
                            <field name="selected_for_booking" invisible="state != 'available'"/>
                        </group>
                        <group>
                            <field name="planned_start_datetime"/>
                            <field name="planned_end_datetime"/>
                            <field name="availability_responded_at" readonly="1"/>
                            <field name="accepted_at" readonly="1" invisible="not accepted_at"/>
                        </group>
                    </group>
                    <group string="Zeitänderung" invisible="state != 'accepted' and time_change_state == 'none'">
                        <field name="time_change_state" readonly="1"/>
                        <field name="time_change_warning" readonly="1"/>
                        <field name="time_change_requested_at" readonly="1"/>
                        <field name="time_change_answered_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Links" invisible="not accept_url">
                            <field name="accept_url" readonly="1" widget="url"/>
                            <field name="decline_url" readonly="1" widget="url"/>
                        </page>
                        <page string="Notiz">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_shift_line_search" model="ir.ui.view">
        <field name="name">gl.service.shift.line.search</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <search string="Zuteilungen suchen">
                <field name="shift_id"/>
                <field name="member_id"/>
                <filter string="Verfügbarkeit offen" name="invited" domain="[('state','=','invited')]"/>
                <filter string="Verfügbar" name="available" domain="[('state','=','available')]"/>
                <filter string="Gebucht" name="accepted" domain="[('state','=','accepted'),('role','=','desired')]"/>
                <filter string="Nicht verfügbar" name="declined" domain="[('state','in',('declined','expired'))]"/>
                <group>
                    <filter string="Schicht" name="group_shift" context="{'group_by': 'shift_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_service_shift_line" model="ir.actions.act_window">
        <field name="name">Zuteilungen</field>
        <field name="res_model">gl.service.shift.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================
         Schichten
         ============================================================ -->
    <record id="view_gl_service_shift_list" model="ir.ui.view">
        <field name="name">gl.service.shift.list</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <list string="Schichten" editable="bottom"
                  decoration-success="coverage_state == 'complete'"
                  decoration-warning="coverage_state == 'partial'"
                  decoration-danger="coverage_state == 'missing'">
                <header>
                    <button name="action_generate_lines" type="object" string="Personalliste aktualisieren" class="btn-secondary"/>
                    <button name="action_send_availability_request" type="object" string="Verfügbarkeit anfragen" class="btn-primary"/>
                    <button name="action_book_selected" type="object" string="Ausgewählte fest buchen" class="btn-primary"/>
                </header>
                <field name="green_check" string="✓" readonly="1"/>
                <field name="name"/>
                <field name="source_model"/>
                <field name="shift_date"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="required_count"/>
                <field name="accepted_count" readonly="1" string="Gebucht"/>
                <field name="available_count" readonly="1"/>
                <field name="pending_count" readonly="1"/>
                <field name="declined_count" readonly="1" optional="hide"/>
                <field name="coverage_state" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_shift_form" model="ir.ui.view">
        <field name="name">gl.service.shift.form</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <form string="Serviceschicht">
                <header>
                    <button name="action_generate_lines" type="object" string="Personalliste aktualisieren" class="btn-secondary"/>
                    <button name="action_send_availability_request" type="object" string="Verfügbarkeit anfragen" class="btn-primary"/>
                    <button name="action_book_selected" type="object" string="Ausgewählte fest buchen" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="problem,booked,confirmed,draft"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_model"/>
                            <field name="event_id" invisible="source_model != 'event.event'"/>
                            <field name="project_id" invisible="source_model != 'project.project'"/>
                            <field name="source_ref" readonly="1"/>
                            <field name="managed_source_times"/>
                        </group>
                        <group>
                            <field name="shift_date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="required_count"/>
                        </group>
                    </group>
                    <group string="Besetzung">
                        <group>
                            <field name="accepted_count" readonly="1"/>
                            <field name="available_count" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="coverage_state" readonly="1"/>
                            <field name="availability_last_sent_at" readonly="1"/>
                            <field name="availability_auto_sent" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Servicekräfte">
                            <field name="line_ids" context="{'default_role': 'reserve'}">
                                <list editable="bottom"
                                      decoration-success="state == 'accepted' and role == 'desired'"
                                      decoration-info="state == 'available' or (state == 'accepted' and role == 'reserve')"
                                      decoration-danger="state in ('declined', 'expired') or time_change_state == 'declined'"
                                      decoration-warning="state == 'invited' or time_change_state == 'pending'">
                                    <field name="member_id"/>
                                    <field name="role" optional="hide"/>
                                    <field name="state"/>
                                    <field name="selected_for_booking" invisible="state != 'available'"/>
                                    <field name="planned_start_datetime"/>
                                    <field name="planned_end_datetime"/>
                                    <field name="time_change_state" readonly="1" optional="show"/>
                                    <field name="time_change_warning" readonly="1" optional="hide"/>
                                    <field name="availability_responded_at" readonly="1" optional="hide"/>
                                    <button name="action_send_invitation" type="object" string="Mailen" invisible="state == 'available' or (state == 'accepted' and role == 'desired')"/>
                                    <button name="action_book_fixed" type="object" string="Fest buchen" class="btn-primary" invisible="state != 'available'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_shift_search" model="ir.ui.view">
        <field name="name">gl.service.shift.search</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <search string="Schichten suchen">
                <field name="name"/>
                <field name="shift_date"/>
                <field name="event_id"/>
                <field name="project_id"/>
                <filter string="Service fehlt" name="missing" domain="[('coverage_state','in',('missing','partial'))]"/>
                <filter string="Vollständig gebucht" name="complete" domain="[('coverage_state','=','complete')]"/>
                <filter string="Zukünftig" name="future" domain="[('shift_date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Datum" name="group_date" context="{'group_by': 'shift_date'}"/>
                    <filter string="Quelle" name="group_source" context="{'group_by': 'source_model'}"/>
                    <filter string="Besetzung" name="group_coverage" context="{'group_by': 'coverage_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_service_shift" model="ir.actions.act_window">
        <field name="name">Schichten</field>
        <field name="res_model">gl.service.shift</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_future': 1}</field>
    </record>

    <record id="action_gl_service_import_sources" model="ir.actions.server">
        <field name="name">Bestehende Events/Projekte einholen</field>
        <field name="model_id" ref="model_gl_service_shift"/>
        <field name="state">code</field>
        <field name="code">action = model.action_import_sources()</field>
    </record>

    <record id="action_gl_service_portal_overview" model="ir.actions.act_url">
        <field name="name">Web-Übersicht öffnen</field>
        <field name="url">/servicepersonal/overview</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================
         Mail-Debug-Freigabe
         ============================================================ -->
    <record id="view_gl_service_mail_queue_list" model="ir.ui.view">
        <field name="name">gl.service.mail.queue.list</field>
        <field name="model">gl.service.mail.queue</field>
        <field name="arch" type="xml">
            <list string="Mail-Freigaben"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_approve_all_pending" type="object" string="Alle offenen freigeben" class="btn-primary"/>
                </header>
                <field name="create_date" string="Erstellt"/>
                <field name="queue_kind"/>
                <field name="shift_id"/>
                <field name="member_id"/>
                <field name="email_to"/>
                <field name="subject"/>
                <field name="state"/>
                <button name="action_approve_send" type="object" string="Freigeben &amp; senden" class="btn-primary" invisible="state not in ('pending', 'error')"/>
                <button name="action_cancel" type="object" string="Verwerfen" invisible="state not in ('pending', 'error')"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_mail_queue_form" model="ir.ui.view">
        <field name="name">gl.service.mail.queue.form</field>
        <field name="model">gl.service.mail.queue</field>
        <field name="arch" type="xml">
            <form string="Mail-Freigabe">
                <header>
                    <button name="action_approve_send" type="object" string="Freigeben &amp; senden" class="btn-primary" invisible="state not in ('pending', 'error')"/>
                    <button name="action_cancel" type="object" string="Verwerfen" class="btn-secondary" invisible="state not in ('pending', 'error')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,error,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="queue_kind" readonly="1"/>
                            <field name="shift_id" readonly="1"/>
                            <field name="member_id" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="email_to"/>
                            <field name="email_from"/>
                            <field name="reply_to"/>
                            <field name="sent_at" readonly="1" invisible="not sent_at"/>
                            <field name="approved_by_id" readonly="1" invisible="not approved_by_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject"/>
                    </group>
                    <field name="body_html" widget="html"/>
                    <field name="error_message" readonly="1" invisible="not error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_service_mail_queue" model="ir.actions.act_window">
        <field name="name">Mail-Freigaben</field>
        <field name="res_model">gl.service.mail.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',('pending','error'))]</field>
    </record>

    <!-- ============================================================
         App-Einstellungen
         ============================================================ -->
    <record id="view_gl_service_staff_settings_form" model="ir.ui.view">
        <field name="name">gl.service.staff.settings.form</field>
        <field name="model">gl.service.staff.settings</field>
        <field name="arch" type="xml">
            <form string="Servicepersonal Einstellungen">
                <header>
                    <button name="action_save" type="object" string="Speichern" class="btn-primary"/>
                    <button name="action_open_mail_queue" type="object" string="Mail-Freigaben" class="btn-secondary" invisible="not can_manage_debug"/>
                </header>
                <sheet>
                    <field name="can_manage_debug" invisible="1"/>
                    <div class="oe_title">
                        <h1>Servicepersonal Einstellungen</h1>
                    </div>
                    <group string="Verantwortung &amp; Mail-Freigabe">
                        <group>
                            <field name="responsible_user_id" options="{'no_create': True}"/>
                            <field name="technical_manager_user_id" options="{'no_create': True}" readonly="not can_manage_debug"/>
                        </group>
                        <group>
                            <field name="mail_debugging" readonly="not can_manage_debug"/>
                            <field name="pending_mail_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not mail_debugging">
                        Mail debugging ist aktiv: Alle von dieser App erzeugten Mails werden zunächst zurückgehalten. Die technische Leitung prüft und versendet sie über „Mail-Freigaben“.
                    </div>
                    <group string="Standard-Zeiträume">
                        <group string="Veranstaltungen">
                            <field name="event_before_hours"/>
                            <field name="event_after_hours"/>
                            <div class="text-muted">Standard: 2 Stunden vor Beginn bis 1 Stunde nach Veranstaltungsende. Pro Veranstaltung überschreibbar.</div>
                        </group>
                        <group string="Projekte / Homeautomation">
                            <field name="project_start_field" placeholder="z. B. x_studio_startzeit"/>
                            <field name="project_end_field" placeholder="z. B. x_studio_endzeit"/>
                            <div class="text-muted">Die Projektzeiten werden jeweils um 1 Stunde nach vorne bzw. hinten erweitert. Leer lassen, wenn die Felder „Startzeit“ und „Endzeit“ automatisch erkannt werden.</div>
                        </group>
                    </group>
                    <group string="Mailvorlagen">
                        <group>
                            <field name="availability_template_id" options="{'no_create': True}"/>
                            <field name="booking_template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="day_before_template_id" options="{'no_create': True}"/>
                            <field name="time_change_template_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <button name="action_open_mail_templates" type="object" string="Mailvorlagen bearbeiten" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_service_settings" model="ir.actions.act_window">
        <field name="name">Einstellungen</field>
        <field name="res_model">gl.service.staff.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ============================================================
         Veranstaltung: manuelle Anfrage + individuelle Zusatzzeiten
         ============================================================ -->
    <record id="view_event_form_gl_service_staff" model="ir.ui.view">
        <field name="name">event.event.form.gl.service.staff</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='stage_id']" position="before">
                <button name="action_gl_service_send_availability" type="object" string="Service-Verfügbarkeit anfragen" class="btn-secondary" invisible="not date_begin"/>
            </xpath>
            <xpath expr="//field[@name='date_begin']" position="after">
                <field name="gl_service_custom_time_window"/>
                <field name="gl_service_before_hours" invisible="not gl_service_custom_time_window"/>
                <field name="gl_service_after_hours" invisible="not gl_service_custom_time_window"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Projekt: Servicebedarf + manuelle Anfrage
         ============================================================ -->
    <record id="view_project_form_gl_service_staff" model="ir.ui.view">
        <field name="name">project.project.form.gl.service.staff</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='stage_id']" position="before">
                <button name="action_gl_service_send_availability" type="object" string="Service-Verfügbarkeit anfragen" class="btn-secondary" invisible="gl_service_staff_count &lt;= 0"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="gl_service_staff_count"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_list_gl_service_staff" model="ir.ui.view">
        <field name="name">project.project.list.gl.service.staff</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="gl_service_staff_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Menüs
         ============================================================ -->
    <menuitem id="menu_gl_service_root" name="Servicepersonal" sequence="35" web_icon="gl_service_staff,static/description/icon.png"/>
    <menuitem id="menu_gl_service_shifts" name="Schichten" parent="menu_gl_service_root" action="action_gl_service_shift" sequence="10"/>
    <menuitem id="menu_gl_service_staff" name="Mitarbeiter" parent="menu_gl_service_root" action="action_gl_service_staff_member" sequence="20"/>
    <menuitem id="menu_gl_service_lines" name="Zuteilungen" parent="menu_gl_service_root" action="action_gl_service_shift_line" sequence="30"/>
    <menuitem id="menu_gl_service_overview" name="Web-Übersicht" parent="menu_gl_service_root" action="action_gl_service_portal_overview" sequence="35"/>
    <menuitem id="menu_gl_service_import" name="Bestehende Events/Projekte einholen" parent="menu_gl_service_root" action="action_gl_service_import_sources" sequence="40"/>
    <menuitem id="menu_gl_service_settings" name="Einstellungen" parent="menu_gl_service_root" action="action_gl_service_settings" sequence="100"/>
</odoo>
