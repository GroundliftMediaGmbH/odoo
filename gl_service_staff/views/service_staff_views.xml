<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Servicepersonal -->
    <record id="view_gl_service_staff_member_list" model="ir.ui.view">
        <field name="name">gl.service.staff.member.list</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <list string="Servicepersonal" editable="bottom">
                <field name="employee_id"/>
                <field name="email"/>
                <field name="rating_choice"/>
                <field name="rating_display" readonly="1"/>
                <field name="pin_code"/>
                <field name="active"/>
                <button name="action_open_portal" type="object" string="Webseite öffnen" class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_staff_member_form" model="ir.ui.view">
        <field name="name">gl.service.staff.member.form</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <form string="Servicepersonal">
                <header>
                    <button name="action_open_portal" type="object" string="Mitarbeiter-Webseite öffnen" class="btn-primary"/>
                    <button name="action_generate_new_pin" type="object" string="Neuen PIN erzeugen" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="rating_choice"/>
                            <field name="rating_display" readonly="1"/>
                            <field name="pin_code"/>
                            <field name="portal_url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notiz">
                            <field name="note" placeholder="Interne Hinweise, z. B. Erfahrung, Präferenzen, Einschränkungen ..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_staff_member_search" model="ir.ui.view">
        <field name="name">gl.service.staff.member.search</field>
        <field name="model">gl.service.staff.member</field>
        <field name="arch" type="xml">
            <search string="Servicepersonal suchen">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="email"/>
                <filter string="Aktiv" name="active_members" domain="[('active','=',True)]"/>
                <group>
                    <filter string="Bewertung" name="group_rating" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_service_staff_member" model="ir.actions.act_window">
        <field name="name">Mitarbeiter</field>
        <field name="res_model">gl.service.staff.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_members': 1}</field>
    </record>

    <!-- Schicht-Zeilen -->
    <record id="view_gl_service_shift_line_list" model="ir.ui.view">
        <field name="name">gl.service.shift.line.list</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <list string="Servicepersonal-Zuteilungen" editable="bottom" decoration-success="state == 'accepted'" decoration-danger="state in ('declined', 'expired')" decoration-warning="state == 'invited'">
                <field name="shift_id"/>
                <field name="member_id"/>
                <field name="role"/>
                <field name="state"/>
                <field name="base_rating" readonly="1"/>
                <field name="shift_rating_choice"/>
                <field name="rating_display" readonly="1"/>
                <field name="planned_start_datetime"/>
                <field name="planned_end_datetime"/>
                <field name="invite_deadline" readonly="1"/>
                <button name="action_send_invitation" type="object" string="Einladen" class="btn-primary" invisible="state == 'accepted'"/>
                <button name="action_accept_manual" type="object" string="Manuell zusagen" invisible="state == 'accepted'"/>
                <button name="action_decline_manual" type="object" string="Manuell absagen" invisible="state in ('declined', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_shift_line_form" model="ir.ui.view">
        <field name="name">gl.service.shift.line.form</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <form string="Servicepersonal-Zuteilung">
                <header>
                    <button name="action_send_invitation" type="object" string="Einladen" class="btn-primary" invisible="state == 'accepted'"/>
                    <button name="action_accept_manual" type="object" string="Manuell zusagen" class="btn-secondary" invisible="state == 'accepted'"/>
                    <button name="action_decline_manual" type="object" string="Manuell absagen" class="btn-secondary" invisible="state in ('declined', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invited,accepted,declined,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="member_id"/>
                            <field name="email" readonly="1"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="base_rating" readonly="1"/>
                            <field name="shift_rating_choice"/>
                            <field name="effective_rating" readonly="1"/>
                            <field name="rating_display" readonly="1"/>
                        </group>
                    </group>
                    <group string="Arbeitszeit">
                        <field name="planned_start_datetime"/>
                        <field name="planned_end_datetime"/>
                    </group>
                    <group string="Einladung / Antwort">
                        <field name="invite_sent_at" readonly="1"/>
                        <field name="invite_deadline" readonly="1"/>
                        <field name="accepted_at" readonly="1"/>
                        <field name="declined_at" readonly="1"/>
                        <field name="replacement_for_id" readonly="1"/>
                        <field name="replacement_reason" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Links">
                            <field name="accept_url" readonly="1"/>
                            <field name="decline_url" readonly="1"/>
                        </page>
                        <page string="Notiz">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_shift_line_search" model="ir.ui.view">
        <field name="name">gl.service.shift.line.search</field>
        <field name="model">gl.service.shift.line</field>
        <field name="arch" type="xml">
            <search string="Zuteilungen suchen">
                <field name="shift_id"/>
                <field name="member_id"/>
                <filter string="Wunschpersonal" name="desired" domain="[('role','=','desired')]"/>
                <filter string="Reservepersonal" name="reserve" domain="[('role','=','reserve')]"/>
                <filter string="Offen" name="invited" domain="[('state','=','invited')]"/>
                <filter string="Zugesagt" name="accepted" domain="[('state','=','accepted')]"/>
                <group>
                    <filter string="Schicht" name="group_shift" context="{'group_by': 'shift_id'}"/>
                    <filter string="Antwort" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Einteilung" name="group_role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_service_shift_line" model="ir.actions.act_window">
        <field name="name">Zuteilungen</field>
        <field name="res_model">gl.service.shift.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Schichten -->
    <record id="view_gl_service_shift_list" model="ir.ui.view">
        <field name="name">gl.service.shift.list</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <list string="Schichten" decoration-success="all_confirmed" decoration-warning="pending_count &gt; 0" decoration-danger="state == 'problem'">
                <header>
                    <button name="action_generate_lines" type="object" string="Personalliste erzeugen" class="btn-secondary"/>
                    <button name="action_servicepersonal_buchen" type="object" string="Servicepersonal buchen" class="btn-primary"/>
                </header>
                <field name="green_check" string="✓"/>
                <field name="name"/>
                <field name="source_model"/>
                <field name="shift_date"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="required_count"/>
                <field name="accepted_count"/>
                <field name="pending_count"/>
                <field name="declined_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_gl_service_shift_form" model="ir.ui.view">
        <field name="name">gl.service.shift.form</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <form string="Serviceschicht">
                <header>
                    <button name="action_generate_lines" type="object" string="Personalliste erzeugen" class="btn-secondary"/>
                    <button name="action_servicepersonal_buchen" type="object" string="Servicepersonal buchen" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,confirmed,problem"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_model"/>
                            <field name="event_id" invisible="source_model != 'event.event'"/>
                            <field name="project_id" invisible="source_model != 'project.project'"/>
                            <field name="source_ref" readonly="1"/>
                        </group>
                        <group>
                            <field name="shift_date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="required_count"/>
                        </group>
                    </group>
                    <group string="Übersicht">
                        <field name="green_check" readonly="1"/>
                        <field name="accepted_count" readonly="1"/>
                        <field name="pending_count" readonly="1"/>
                        <field name="declined_count" readonly="1"/>
                        <field name="all_confirmed" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Servicekräfte">
                            <field name="line_ids" context="{'default_role': 'reserve'}">
                                <list editable="bottom" decoration-success="state == 'accepted'" decoration-danger="state in ('declined', 'expired')" decoration-warning="state == 'invited'">
                                    <field name="member_id"/>
                                    <field name="role"/>
                                    <field name="state"/>
                                    <field name="base_rating" readonly="1"/>
                                    <field name="shift_rating_choice"/>
                                    <field name="rating_display" readonly="1"/>
                                    <field name="planned_start_datetime"/>
                                    <field name="planned_end_datetime"/>
                                    <field name="invite_deadline" readonly="1"/>
                                    <field name="replacement_for_id" readonly="1"/>
                                    <button name="action_send_invitation" type="object" string="Einladen" class="btn-primary" invisible="state == 'accepted'"/>
                                    <button name="action_accept_manual" type="object" string="Zusage" invisible="state == 'accepted'"/>
                                    <button name="action_decline_manual" type="object" string="Absage" invisible="state in ('declined', 'expired')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_service_shift_search" model="ir.ui.view">
        <field name="name">gl.service.shift.search</field>
        <field name="model">gl.service.shift</field>
        <field name="arch" type="xml">
            <search string="Schichten suchen">
                <field name="name"/>
                <field name="shift_date"/>
                <field name="event_id"/>
                <field name="project_id"/>
                <filter string="Nicht vollständig" name="not_confirmed" domain="[('all_confirmed','=',False)]"/>
                <filter string="Bestätigt" name="confirmed" domain="[('all_confirmed','=',True)]"/>
                <filter string="Zukünftig" name="future" domain="[('shift_date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Datum" name="group_date" context="{'group_by': 'shift_date'}"/>
                    <filter string="Quelle" name="group_source" context="{'group_by': 'source_model'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_service_shift" model="ir.actions.act_window">
        <field name="name">Schichten</field>
        <field name="res_model">gl.service.shift</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_future': 1}</field>
    </record>

    <record id="action_gl_service_import_sources" model="ir.actions.server">
        <field name="name">Bestehende Events/Projekte einholen</field>
        <field name="model_id" ref="model_gl_service_shift"/>
        <field name="state">code</field>
        <field name="code">action = model.action_import_sources()</field>
    </record>

    <record id="action_gl_service_portal_overview" model="ir.actions.act_url">
        <field name="name">Web-Übersicht öffnen</field>
        <field name="url">/servicepersonal/overview</field>
        <field name="target">new</field>
    </record>

    <!-- Menüs -->
    <menuitem id="menu_gl_service_root" name="Servicepersonal" sequence="35" web_icon="gl_service_staff,static/description/icon.png"/>
    <menuitem id="menu_gl_service_shifts" name="Schichten" parent="menu_gl_service_root" action="action_gl_service_shift" sequence="10"/>
    <menuitem id="menu_gl_service_staff" name="Mitarbeiter" parent="menu_gl_service_root" action="action_gl_service_staff_member" sequence="20"/>
    <menuitem id="menu_gl_service_lines" name="Zuteilungen" parent="menu_gl_service_root" action="action_gl_service_shift_line" sequence="30"/>
    <menuitem id="menu_gl_service_overview" name="Web-Übersicht" parent="menu_gl_service_root" action="action_gl_service_portal_overview" sequence="35"/>
    <menuitem id="menu_gl_service_import" name="Bestehende Events/Projekte einholen" parent="menu_gl_service_root" action="action_gl_service_import_sources" sequence="40"/>
</odoo>
