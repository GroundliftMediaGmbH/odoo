<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_service_staff_home" name="Servicepersonal Portal">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <h1 class="mb-3">Servicepersonal</h1>
                            <p class="text-muted">Hier siehst du deine Verfügbarkeitsanfragen und fest gebuchten Einsätze.</p>

                            <t t-if="not member">
                                <div class="card shadow-sm border-0 mt-4">
                                    <div class="card-body p-4">
                                        <h2 class="h4 mb-3">Mit PIN-Code anmelden</h2>
                                        <t t-if="error">
                                            <div class="alert alert-danger" role="alert"><t t-out="error"/></div>
                                        </t>
                                        <form method="post" action="/servicepersonal">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-3">
                                                <label class="form-label" for="pin_code">PIN-Code</label>
                                                <input class="form-control form-control-lg" id="pin_code" name="pin_code" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="6-stelliger PIN" required="required"/>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-lg">Anmelden</button>
                                        </form>
                                    </div>
                                </div>
                            </t>

                            <t t-if="member">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-4">
                                    <div>
                                        <h2 class="h4 mb-1">Hallo <t t-out="member.name"/></h2>
                                        <small class="text-muted">
                                            Monatsübersicht:
                                            <t t-if="member.monthly_summary_opt_in">aktiv</t>
                                            <t t-else="">abbestellt</t>
                                        </small>
                                    </div>
                                    <a class="btn btn-outline-secondary" href="/servicepersonal/logout">Abmelden</a>
                                </div>

                                <t t-if="not lines">
                                    <div class="alert alert-info">Aktuell sind keine zukünftigen Anfragen oder Buchungen für dich vorhanden.</div>
                                </t>

                                <div class="row g-3">
                                    <t t-foreach="lines" t-as="line">
                                        <div class="col-12">
                                            <div class="card shadow-sm border-0">
                                                <div class="card-body p-4">
                                                    <div class="d-flex flex-wrap justify-content-between gap-2">
                                                        <div>
                                                            <h3 class="h5 mb-1"><t t-out="line.shift_id.name"/></h3>
                                                            <div class="text-muted">
                                                                <t t-if="line.planned_start_datetime">
                                                                    <span t-field="line.planned_start_datetime" t-options='{&quot;format&quot;: &quot;dd.MM.yyyy HH:mm&quot;}'/> Uhr
                                                                    <t t-if="line.planned_end_datetime"> bis <span t-field="line.planned_end_datetime" t-options='{&quot;format&quot;: &quot;dd.MM.yyyy HH:mm&quot;}'/> Uhr</t>
                                                                </t>
                                                                <t t-elif="line.shift_id.shift_date">
                                                                    <span t-field="line.shift_id.shift_date"/>
                                                                </t>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <span t-if="line.state == 'accepted' and line.role == 'desired'" class="badge text-bg-success">Gebucht</span>
                                                            <span t-if="line.state == 'accepted' and line.role == 'reserve'" class="badge text-bg-info">Verfügbar (Altbestand)</span>
                                                            <span t-if="line.state == 'available'" class="badge text-bg-info">Verfügbar gemeldet</span>
                                                            <span t-if="line.state == 'invited'" class="badge text-bg-warning">Rückmeldung offen</span>
                                                            <span t-if="line.state in ('declined', 'expired')" class="badge text-bg-secondary">Nicht verfügbar</span>
                                                            <span t-if="line.time_change_state == 'pending'" class="badge text-bg-warning">Zeitänderung offen</span>
                                                            <span t-if="line.time_change_state == 'declined'" class="badge text-bg-danger">Zeitänderung abgelehnt</span>
                                                        </div>
                                                    </div>

                                                    <t t-if="line.state == 'invited'">
                                                        <p class="mt-3 mb-2">Kannst du in diesem Zeitraum arbeiten?</p>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            <a class="btn btn-success" t-att-href="line.accept_url">Ich bin verfügbar</a>
                                                            <a class="btn btn-outline-danger" t-att-href="line.decline_url">Ich bin nicht verfügbar</a>
                                                        </div>
                                                        <p class="text-muted small mt-2 mb-0">Die Verfügbarkeitsmeldung ist noch keine feste Buchung.</p>
                                                    </t>

                                                    <t t-if="line.state == 'available'">
                                                        <div class="alert alert-info mt-3 mb-0">Deine Verfügbarkeit ist gespeichert. Wenn du fest eingeplant wirst, erhältst du eine separate Buchungsbestätigung.</div>
                                                    </t>

                                                    <t t-if="line.state == 'accepted' and line.role == 'desired' and line.time_change_state == 'pending'">
                                                        <div class="alert alert-warning mt-3 mb-0">Die Arbeitszeit wurde geändert. Bitte bestätige kurz, ob die neue Zeit für dich passt.</div>
                                                        <div class="mt-3 d-flex flex-wrap gap-2">
                                                            <a class="btn btn-success" t-att-href="line.accept_url">Geänderte Zeit passt</a>
                                                            <a class="btn btn-outline-danger" t-att-href="line.decline_url">Geänderte Zeit passt nicht</a>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="portal_service_staff_response" name="Servicepersonal Antwort">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div t-att-class="'alert alert-success' if success else 'alert alert-danger'" role="alert">
                                <h1 class="h3"><t t-out="title"/></h1>
                                <p class="mb-0"><t t-out="message"/></p>
                            </div>
                            <t t-if="line">
                                <div class="card shadow-sm border-0 mt-4">
                                    <div class="card-body p-4">
                                        <h2 class="h5"><t t-out="line.shift_id.name"/></h2>
                                        <p class="mb-0">
                                            <t t-if="line.planned_start_datetime">
                                                <span t-field="line.planned_start_datetime" t-options='{&quot;format&quot;: &quot;dd.MM.yyyy HH:mm&quot;}'/> Uhr
                                                <t t-if="line.planned_end_datetime"> bis <span t-field="line.planned_end_datetime" t-options='{&quot;format&quot;: &quot;dd.MM.yyyy HH:mm&quot;}'/> Uhr</t>
                                            </t>
                                            <t t-elif="line.shift_id.shift_date">Datum: <span t-field="line.shift_id.shift_date"/></t>
                                        </p>
                                    </div>
                                </div>
                            </t>
                            <a class="btn btn-primary mt-4" href="/servicepersonal">Zur Übersicht</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="portal_service_staff_overview" name="Servicepersonal Gesamtübersicht">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <h1 class="mb-3">Servicepersonal-Übersicht</h1>
                    <p class="text-muted">Zukünftige Schichten mit Bedarf, Verfügbarkeiten und fest gebuchtem Personal.</p>
                    <t t-if="not shifts">
                        <div class="alert alert-info">Aktuell sind keine zukünftigen Schichten vorhanden.</div>
                    </t>
                    <div class="table-responsive" t-if="shifts">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Schicht</th>
                                    <th>Benötigt</th>
                                    <th>Gebucht</th>
                                    <th>Verfügbar</th>
                                    <th>Gebuchtes Personal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="shifts" t-as="shift">
                                    <tr>
                                        <td><span t-field="shift.shift_date"/></td>
                                        <td><t t-out="shift.name"/></td>
                                        <td><t t-out="shift.required_count"/></td>
                                        <td><t t-out="shift.accepted_count"/></td>
                                        <td><t t-out="shift.available_count"/></td>
                                        <td>
                                            <t t-foreach="shift.line_ids.filtered(lambda l: l.state == 'accepted' and l.role == 'desired')" t-as="line">
                                                <div>
                                                    <strong><t t-out="line.member_id.name"/></strong>
                                                    <span class="text-muted small ms-1">
                                                        <t t-if="line.planned_start_datetime">
                                                            <span t-field="line.planned_start_datetime" t-options='{&quot;format&quot;: &quot;dd.MM.yyyy HH:mm&quot;}'/> Uhr
                                                            <t t-if="line.planned_end_datetime"> bis <span t-field="line.planned_end_datetime" t-options='{&quot;format&quot;: &quot;HH:mm&quot;}'/> Uhr</t>
                                                        </t>
                                                    </span>
                                                    <span t-if="line.time_change_state == 'pending'" class="badge text-bg-warning">Zeitänderung offen</span>
                                                    <span t-if="line.time_change_state == 'declined'" class="badge text-bg-danger">Zeitänderung abgelehnt</span>
                                                </div>
                                            </t>
                                        </td>
                                        <td>
                                            <span t-if="shift.coverage_state == 'complete'" class="badge text-bg-success">✅ vollständig gebucht</span>
                                            <span t-if="shift.coverage_state == 'partial'" class="badge text-bg-warning">teilweise gebucht</span>
                                            <span t-if="shift.coverage_state == 'missing'" class="badge text-bg-danger">Service fehlt</span>
                                            <span t-if="shift.coverage_state == 'none'" class="badge text-bg-secondary">kein Bedarf</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
