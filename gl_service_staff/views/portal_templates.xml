<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_service_staff_home" name="Servicepersonal Portal">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            <h1 class="mb-3">Servicepersonal</h1>
                            <p class="text-muted">Hier siehst du deine aktuellen Service-Schichten und kannst Einladungen bestätigen oder absagen.</p>

                            <t t-if="not member">
                                <div class="card shadow-sm border-0 mt-4">
                                    <div class="card-body p-4">
                                        <h2 class="h4 mb-3">Mit PIN-Code anmelden</h2>
                                        <t t-if="error">
                                            <div class="alert alert-danger" role="alert"><t t-out="error"/></div>
                                        </t>
                                        <form method="post" action="/servicepersonal">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-3">
                                                <label class="form-label" for="pin_code">PIN-Code</label>
                                                <input class="form-control form-control-lg" id="pin_code" name="pin_code" type="text" inputmode="numeric" autocomplete="one-time-code" placeholder="6-stelliger PIN" required="required"/>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-lg">Anmelden</button>
                                        </form>
                                    </div>
                                </div>
                            </t>

                            <t t-if="member">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-4">
                                    <div>
                                        <h2 class="h4 mb-0">Hallo <t t-out="member.name"/></h2>
                                    </div>
                                    <a class="btn btn-outline-secondary" href="/servicepersonal/logout">Abmelden</a>
                                </div>

                                <t t-if="not lines">
                                    <div class="alert alert-info">Aktuell sind keine zukünftigen Schichten für dich vorhanden.</div>
                                </t>

                                <div class="row g-3">
                                    <t t-foreach="lines" t-as="line">
                                        <div class="col-12">
                                            <div class="card shadow-sm border-0">
                                                <div class="card-body p-4">
                                                    <div class="d-flex flex-wrap justify-content-between gap-2">
                                                        <div>
                                                            <h3 class="h5 mb-1"><t t-out="line.shift_id.name"/></h3>
                                                            <div class="text-muted">
                                                                <span t-field="line.shift_id.shift_date"/>
                                                                <t t-if="line.planned_start_datetime"> · <span t-field="line.planned_start_datetime"/></t>
                                                                <t t-if="line.planned_end_datetime"> bis <span t-field="line.planned_end_datetime"/></t>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <span t-if="line.state == 'accepted'" class="badge text-bg-success">Zugesagt</span>
                                                            <span t-if="line.state == 'invited'" class="badge text-bg-warning">Antwort offen</span>
                                                            <span t-if="line.state == 'declined'" class="badge text-bg-danger">Abgesagt</span>
                                                            <span t-if="line.state == 'expired'" class="badge text-bg-secondary">Frist abgelaufen</span>
                                                            <span t-if="line.state == 'draft'" class="badge text-bg-light">Noch nicht angefragt</span>
                                                        </div>
                                                    </div>
                                                    <t t-if="line.invite_deadline">
                                                        <div class="mt-3">
                                                            <strong>Antwortfrist:</strong> <span t-field="line.invite_deadline"/>
                                                        </div>
                                                    </t>
                                                    <t t-if="line.state == 'invited'">
                                                        <div class="mt-4 d-flex flex-wrap gap-2">
                                                            <a class="btn btn-success" t-att-href="line.accept_url">Ich bin gerne dabei</a>
                                                            <a class="btn btn-danger" t-att-href="line.decline_url">Ich kann leider nicht</a>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="portal_service_staff_response" name="Servicepersonal Antwort">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div t-att-class="'alert alert-success' if success else 'alert alert-danger'" role="alert">
                                <h1 class="h3"><t t-out="title"/></h1>
                                <p class="mb-0"><t t-out="message"/></p>
                            </div>
                            <t t-if="line">
                                <div class="card shadow-sm border-0 mt-4">
                                    <div class="card-body p-4">
                                        <h2 class="h5"><t t-out="line.shift_id.name"/></h2>
                                        <p class="mb-0">
                                            Datum: <span t-field="line.shift_id.shift_date"/><br/>
                                            <t t-if="line.planned_start_datetime">Anfang: <span t-field="line.planned_start_datetime"/><br/></t>
                                            <t t-if="line.planned_end_datetime">Ende: <span t-field="line.planned_end_datetime"/></t>
                                        </p>
                                    </div>
                                </div>
                            </t>
                            <a class="btn btn-primary mt-4" href="/servicepersonal">Zur Übersicht</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="portal_service_staff_overview" name="Servicepersonal Gesamtübersicht">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <h1 class="mb-3">Servicepersonal-Übersicht</h1>
                    <p class="text-muted">Zukünftige Schichten mit eingeteiltem und bestätigtem Servicepersonal.</p>
                    <t t-if="not shifts">
                        <div class="alert alert-info">Aktuell sind keine zukünftigen Schichten vorhanden.</div>
                    </t>
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Schicht</th>
                                    <th>Benötigt</th>
                                    <th>Zugesagt</th>
                                    <th>Offen</th>
                                    <th>Personal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="shifts" t-as="shift">
                                    <tr>
                                        <td><span t-field="shift.shift_date"/></td>
                                        <td><t t-out="shift.name"/></td>
                                        <td><t t-out="shift.required_count"/></td>
                                        <td><t t-out="shift.accepted_count"/></td>
                                        <td><t t-out="shift.pending_count"/></td>
                                        <td>
                                            <t t-foreach="shift.line_ids.filtered(lambda l: l.role == 'desired')" t-as="line">
                                                <div>
                                                    <t t-out="line.member_id.name"/>
                                                    <span t-if="line.state == 'accepted'" class="badge text-bg-success">zugesagt</span>
                                                    <span t-if="line.state == 'invited'" class="badge text-bg-warning">offen</span>
                                                    <span t-if="line.state == 'declined'" class="badge text-bg-danger">abgesagt</span>
                                                    <span t-if="line.state == 'expired'" class="badge text-bg-secondary">abgelaufen</span>
                                                </div>
                                            </t>
                                        </td>
                                        <td>
                                            <span t-if="shift.all_confirmed" class="badge text-bg-success">✅ komplett</span>
                                            <span t-if="not shift.all_confirmed" class="badge text-bg-warning">offen</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
