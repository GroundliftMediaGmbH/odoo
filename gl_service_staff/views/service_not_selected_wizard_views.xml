<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_service_not_selected_wizard_form" model="ir.ui.view">
        <field name="name">gl.service.not.selected.wizard.form</field>
        <field name="model">gl.service.not.selected.wizard</field>
        <field name="arch" type="xml">
            <form string="Service-Absagen prüfen">
                <sheet>
                    <group>
                        <field name="shift_id" readonly="1"/>
                        <field name="available_count" readonly="1"/>
                        <field name="previous_count" readonly="1"/>
                        <field name="resend_previous"/>
                        <field name="send_count" readonly="1"/>
                    </group>
                    <group string="Empfänger (Vorschau)">
                        <field name="recipients_preview" nolabel="1" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Neue Absagen gehen über die bestehende E-Mail-Vorlage und
                        gegebenenfalls über die Mail-Freigabe. Bereits fest gebuchte
                        oder nicht verfügbare Personen erhalten keine Absage.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not resend_previous">
                        Achtung: Mit dieser Option werden bereits abgesagte Personen
                        erneut benachrichtigt, auch wenn sie die Absage früher erhalten haben.
                        Noch offene Mail-Freigaben werden nicht doppelt angelegt.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Absagen auslösen" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
