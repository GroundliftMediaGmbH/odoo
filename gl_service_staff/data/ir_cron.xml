<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_gl_service_staff_deadlines" model="ir.cron">
        <field name="name">Servicepersonal: Vortagserinnerungen</field>
        <field name="model_id" ref="model_gl_service_shift"/>
        <field name="state">code</field>
        <field name="code">model.cron_service_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_gl_service_staff_monthly_summary" model="ir.cron">
        <field name="name">Servicepersonal: Monatliche Einsatzübersicht</field>
        <field name="model_id" ref="model_gl_service_staff_member"/>
        <field name="state">code</field>
        <field name="code">model.cron_monthly_summary()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
