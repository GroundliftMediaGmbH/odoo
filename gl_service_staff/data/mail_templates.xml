<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_service_availability" model="mail.template">
        <field name="name">Servicepersonal: Verfügbarkeit anfragen</field>
        <field name="model_id" ref="model_gl_service_shift_line"/>
        <field name="subject">Bist du verfügbar? {{ object.shift_id.name }}</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:15px;line-height:1.5;color:#222;">
                <p>Hallo <t t-out="object.member_id.name"/>,</p>
                <p>wir planen den Service für folgenden Einsatz und möchten wissen, ob du in diesem Zeitraum verfügbar bist:</p>
                <p>
                    <strong><t t-out="object.shift_id.name"/></strong><br/>
                    Datum: <t t-out="object.shift_id.shift_date"/><br/>
                    Zeitraum: <t t-out="format_datetime(object.planned_start_datetime) if object.planned_start_datetime else 'noch offen'"/>
                    bis <t t-out="format_datetime(object.planned_end_datetime) if object.planned_end_datetime else 'noch offen'"/>
                </p>
                <p style="margin:24px 0;">
                    <a t-att-href="object.accept_url" style="background:#1f8f3a;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;margin-right:8px;">Ich bin verfügbar</a>
                    <a t-att-href="object.decline_url" style="background:#8f1f1f;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;">Ich bin nicht verfügbar</a>
                </p>
                <p style="color:#666;font-size:13px;">Deine Verfügbarkeitsmeldung ist noch keine feste Buchung. Wenn du eingeplant wirst, erhältst du anschließend eine Buchungsbestätigung.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_service_booking_confirmation" model="mail.template">
        <field name="name">Servicepersonal: Buchungsbestätigung</field>
        <field name="model_id" ref="model_gl_service_shift_line"/>
        <field name="subject">Fest gebucht: {{ object.shift_id.name }}</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:15px;line-height:1.5;color:#222;">
                <p>Hallo <t t-out="object.member_id.name"/>,</p>
                <p>vielen Dank für deine Rückmeldung. Du bist für folgenden Service-Einsatz <strong>fest gebucht</strong>:</p>
                <p>
                    <strong><t t-out="object.shift_id.name"/></strong><br/>
                    Datum: <t t-out="object.shift_id.shift_date"/><br/>
                    Arbeitszeit: <t t-out="format_datetime(object.planned_start_datetime) if object.planned_start_datetime else 'noch offen'"/>
                    bis <t t-out="format_datetime(object.planned_end_datetime) if object.planned_end_datetime else 'noch offen'"/>
                </p>
                <p>Der Einsatz erscheint ab jetzt in deiner Servicepersonal-Übersicht als „Gebucht“.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_service_day_before" model="mail.template">
        <field name="name">Servicepersonal: Arbeitszeit-Erinnerung am Vortag</field>
        <field name="model_id" ref="model_gl_service_shift_line"/>
        <field name="subject">Morgen: Service-Schicht {{ object.shift_id.name }}</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:15px;line-height:1.5;color:#222;">
                <p>Hallo <t t-out="object.member_id.name"/>,</p>
                <p>hier kommt deine Erinnerung für die morgige Service-Schicht:</p>
                <p>
                    <strong><t t-out="object.shift_id.name"/></strong><br/>
                    Datum: <t t-out="object.shift_id.shift_date"/><br/>
                    Arbeitszeit: <t t-out="format_datetime(object.planned_start_datetime) if object.planned_start_datetime else 'noch offen'"/>
                    bis <t t-out="format_datetime(object.planned_end_datetime) if object.planned_end_datetime else 'noch offen'"/>
                </p>
                <p>Vielen Dank und bis morgen!</p>
            </div>
        </field>
    </record>

    <record id="mail_template_service_time_change" model="mail.template">
        <field name="name">Servicepersonal: Bestätigung Zeitänderung</field>
        <field name="model_id" ref="model_gl_service_shift_line"/>
        <field name="subject">Zeitänderung Service-Schicht: {{ object.shift_id.name }}</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:15px;line-height:1.5;color:#222;">
                <p>Hallo <t t-out="object.member_id.name"/>,</p>
                <p>bei deinem bereits fest gebuchten Service-Einsatz hat sich die Arbeitszeit geändert. Bitte bestätige kurz, ob die neue Zeit für dich passt.</p>
                <p>
                    <strong><t t-out="object.shift_id.name"/></strong><br/>
                    Neue Arbeitszeit: <t t-out="format_datetime(object.planned_start_datetime) if object.planned_start_datetime else 'noch offen'"/>
                    bis <t t-out="format_datetime(object.planned_end_datetime) if object.planned_end_datetime else 'noch offen'"/>
                </p>
                <p style="margin:24px 0;">
                    <a t-att-href="object.accept_url" style="background:#1f8f3a;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;margin-right:8px;">Geänderte Zeit passt</a>
                    <a t-att-href="object.decline_url" style="background:#8f1f1f;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;">Geänderte Zeit passt nicht</a>
                </p>
            </div>
        </field>
    </record>

    <!-- Legacy XML-ID aktualisieren, damit externe Aufrufe der alten Einladung ebenfalls
         nur eine Verfügbarkeitsabfrage und keine direkte Buchung kommunizieren. -->
    <record id="mail_template_service_invitation" model="mail.template">
        <field name="name">Servicepersonal: Verfügbarkeit anfragen (Legacy-ID)</field>
        <field name="model_id" ref="model_gl_service_shift_line"/>
        <field name="subject">Bist du verfügbar? {{ object.shift_id.name }}</field>
        <field name="email_from">{{ user.email_formatted or company.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,sans-serif;font-size:15px;line-height:1.5;color:#222;">
                <p>Hallo <t t-out="object.member_id.name"/>,</p>
                <p>bist du für folgenden Service-Einsatz verfügbar?</p>
                <p><strong><t t-out="object.shift_id.name"/></strong><br/>
                <t t-out="format_datetime(object.planned_start_datetime) if object.planned_start_datetime else 'noch offen'"/> bis
                <t t-out="format_datetime(object.planned_end_datetime) if object.planned_end_datetime else 'noch offen'"/></p>
                <p style="margin:24px 0;">
                    <a t-att-href="object.accept_url" style="background:#1f8f3a;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;margin-right:8px;">Ich bin verfügbar</a>
                    <a t-att-href="object.decline_url" style="background:#8f1f1f;color:#fff;text-decoration:none;padding:12px 18px;border-radius:8px;display:inline-block;">Ich bin nicht verfügbar</a>
                </p>
                <p style="color:#666;font-size:13px;">Eine feste Buchung wird separat bestätigt.</p>
            </div>
        </field>
    </record>
</odoo>
