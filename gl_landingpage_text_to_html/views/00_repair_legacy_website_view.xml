<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        IMPORTANT UPGRADE REPAIR.
        Versions 1.2 to 1.5 created the external id below as an inherited QWeb
        view. Removing its XML file from Git does NOT remove the corresponding
        ir.ui.view row from an existing Odoo database. A stale invalid XPath
        can therefore break every later module upgrade while Odoo validates
        dependent views.

        Reusing the SAME external id rewrites that database row before any of
        this module's normal backend views are loaded. The replacement is a
        structure-independent no-op using XPath dot and is disabled. It does
        not change the public event page.
    -->
    <record id="gl_landingpage_event_description_html" model="ir.ui.view">
        <field name="name">Groundlift legacy event website view (disabled repair)</field>
        <field name="inherit_id" ref="website_event.event_description_full"/>
        <field name="priority">90</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <t t-if="False"/>
            </xpath>
        </field>
    </record>
</odoo>
