<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_gl_landingpage_html" model="ir.ui.view">
        <field name="name">event.event.form.gl.landingpage.html</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="gl_landingpage_html_page" string="Landingpage HTML">
                    <group>
                        <div colspan="2" class="text-muted">
                            Die HTML-Beschreibung wird als Klartext in das bisherige Textfeld übernommen.
                            Auf der Odoo-Standard-Veranstaltungsseite wird die native
                            Odoo-Webseitenbeschreibung automatisch synchronisiert. Das HTML-Feld ist
                            dabei die führende Quelle; eine abweichende alte Beschreibung wird einmal gesichert.
                        </div>
                        <button name="action_gl_copy_plain_to_html"
                                type="object" string="Bestehenden Text übernehmen (nur wenn HTML leer)"
                                class="btn-secondary"/>
                        <field name="gl_landingpage_html" widget="html" nolabel="1" colspan="2"
                               placeholder="Hier lässt sich die Eventbeschreibung formatieren ..."/>
                        <field name="gl_landingpage_native_linked" readonly="1"/>
                        <field name="gl_landingpage_website_status" readonly="1"/>
                        <button name="action_gl_sync_native_if_safe" type="object"
                                string="HTML jetzt mit Odoo-Webseite synchronisieren"
                                class="btn-secondary"/>
                        <button name="action_gl_force_native_link" type="object"
                                string="HTML jetzt auf Odoo-Webseite übernehmen"
                                class="btn-secondary" confirm="Die native Odoo-Eventbeschreibung wird auf den Stand von Landingpage HTML synchronisiert. Eine abweichende alte Fassung wird beim ersten Mal gesichert. Fortfahren?"
                                invisible="not gl_landingpage_html"/>
                        <field name="gl_landingpage_native_backup" widget="html" readonly="1"
                               groups="base.group_system" invisible="not gl_landingpage_native_backup"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
