<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_gl_landingpage_html" model="ir.ui.view">
        <field name="name">event.event.form.gl.landingpage.html</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="gl_landingpage_html_page" string="Landingpage HTML">
                    <group>
                        <div colspan="2" class="text-muted">
                            Der bestehende Groundlift-Text wird in HTML umgewandelt und hier bearbeitbar gemacht.
                            Diese HTML-Version ist die führende Version. Die öffentliche Odoo-Veranstaltungsseite
                            erhält exakt diese HTML-Version über die native Odoo-Beschreibung – ohne zusätzliche
                            Website-Template-Vererbung.
                        </div>
                        <button name="action_gl_copy_plain_to_html"
                                type="object"
                                string="Bestehenden Text übernehmen (nur wenn HTML leer)"
                                class="btn-secondary"/>
                        <field name="gl_landingpage_html"
                               widget="html"
                               nolabel="1"
                               colspan="2"
                               placeholder="Hier lässt sich die Eventbeschreibung formatieren ..."/>
                        <field name="gl_landingpage_website_status" readonly="1"/>
                        <button name="action_gl_force_native_link"
                                type="object"
                                string="HTML jetzt auf Odoo-Webseite übernehmen"
                                class="btn-secondary"
                                invisible="not gl_landingpage_html"/>
                        <field name="gl_landingpage_native_linked" invisible="1"/>
                        <field name="gl_landingpage_native_backup"
                               widget="html"
                               readonly="1"
                               groups="base.group_system"
                               invisible="not gl_landingpage_native_backup"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
