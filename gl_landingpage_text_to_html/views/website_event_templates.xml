<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Groundlift v1.4: the public Odoo event page renders ONLY the dedicated
        Landingpage HTML field.  There is deliberately no fallback to
        event.description and no rendering of the original plain-text field.

        Odoo 19's standard /event/.../register page contains:
            <div class="mt-4" t-field="event.description" itemprop="description"/>
        in website_event.event_description_full.
    -->
    <template id="gl_landingpage_event_description_html"
              name="Groundlift event page: HTML description only"
              inherit_id="website_event.event_description_full"
              priority="90">
        <xpath expr="//div[@id='o_wevent_event_main_col']/div[@t-field='event.description']"
               position="replace">
            <div class="mt-4 gl_landingpage_html"
                 t-field="event.gl_landingpage_html"
                 itemprop="description"
                 data-oe-placeholder="Eventbeschreibung bearbeiten ..."/>
        </xpath>
    </template>
</odoo>
