<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Groundlift v1.5

        Deliberately keep the XPath as small and stable as in the working v1.2:
        target the native event.description node wherever it sits in the current
        website_event template.  Do NOT depend on Odoo's surrounding container
        hierarchy, because that hierarchy may be changed by Website Builder or
        another installed module.

        The public event page renders ONLY gl_landingpage_html.  There is no
        fallback to event.description here.
    -->
    <template id="gl_landingpage_event_description_html"
              name="Groundlift event page: Landingpage HTML only"
              inherit_id="website_event.event_description_full"
              priority="999">
        <xpath expr="//*[@t-field='event.description']" position="replace">
            <div t-if="event.gl_landingpage_html or editable"
                 class="mt-4 gl_landingpage_html"
                 t-field="event.gl_landingpage_html"
                 itemprop="description"
                 data-oe-placeholder="Eventbeschreibung bearbeiten ..."/>
        </xpath>
    </template>
</odoo>
