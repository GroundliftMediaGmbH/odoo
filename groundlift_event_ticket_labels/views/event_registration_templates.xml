<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="groundlift_modal_ticket_labels"
              inherit_id="website_event.modal_ticket_registration"
              name="Groundlift: Paid ticket labels and purchase button"
              priority="100">

        <!--
            Prefer paid tickets on the public website. Free ticket types are
            hidden whenever at least one paid ticket is available. If an event
            only has free tickets, those tickets remain publicly selectable.
        -->
        <xpath expr="//form[@id='registration_form']" position="attributes">
            <attribute name="t-if">event.event_registrations_open</attribute>
        </xpath>

        <xpath expr="//t[@t-set='tickets']" position="replace">
            <t t-set="available_tickets"
               t-value="event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired)"/>
            <t t-set="paid_tickets"
               t-value="available_tickets.filtered(lambda ticket: ticket.price &gt; 0)"/>
            <t t-set="tickets"
               t-value="paid_tickets or available_tickets"/>
        </xpath>

        <!-- Select the single/multiple layout according to publicly visible tickets. -->
        <xpath expr="//t[@t-if='len(event.event_ticket_ids) &gt; 1']" position="attributes">
            <attribute name="t-if">len(tickets) &gt; 1</attribute>
        </xpath>

        <!-- Multiple ticket types: use the meaningful ticket/product label. -->
        <xpath expr="//div[@id='o_wevent_tickets_collapse']//h5[@t-field='ticket.name']"
               position="replace">
            <h5 itemprop="name" class="h6 my-0">
                <t t-out="ticket._get_website_ticket_label()"/>
            </h5>
        </xpath>

        <!-- Single paid ticket type: apply the same label logic. -->
        <xpath expr="//h5[hasclass('o_wevent_single_ticket_name')]/span[@t-if='tickets']"
               position="replace">
            <span t-if="tickets" t-out="tickets._get_website_ticket_label()"/>
        </xpath>

        <!-- Event without an explicit ticket line. -->
        <xpath expr="//h5[hasclass('o_wevent_single_ticket_name')]/span[@t-else]"
               position="replace">
            <span t-else="">Ticket</span>
        </xpath>

        <!--
            The website_event_sale extension calculates the price range from
            all event ticket records by default. Apply the same visibility
            rule here: paid tickets take precedence; free tickets are included
            only when no paid ticket exists.
        -->
        <xpath expr="//div[hasclass('o_wevent_price_range')]//t[@t-set='all_prices' and contains(@t-value, &quot;mapped('price_reduce')&quot;)]"
               position="attributes">
            <attribute name="t-value">(event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired and ticket.price &gt; 0) or event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired)).mapped('price_reduce')</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_wevent_price_range')]//t[@t-set='all_prices' and contains(@t-value, &quot;mapped('price_reduce_taxinc')&quot;)]"
               position="attributes">
            <attribute name="t-value">(event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired and ticket.price &gt; 0) or event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired)).mapped('price_reduce_taxinc')</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_wevent_price_range')]//t[@t-set='lowest_price']"
               position="attributes">
            <attribute name="t-value">min(all_prices) if all_prices else 0</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_wevent_price_range')]//t[@t-set='highest_price']"
               position="attributes">
            <attribute name="t-value">max(all_prices) if all_prices else 0</attribute>
        </xpath>

        <!-- Submit button for the multi-ticket layout. -->
        <xpath expr="(//form[@id='registration_form']//button[@type='submit' and hasclass('a-submit')])[1]"
               position="replace">
            <button type="submit" class="btn btn-primary a-submit" disabled="" t-attf-id="#{event.id}">
                Tickets kaufen
                <t t-if="event.seats_limited and event.seats_max and event.seats_available &lt;= (event.seats_max * 0.2)">
                    (nur noch <t t-out="event.seats_available"/> verfügbar)
                </t>
            </button>
        </xpath>

        <!-- Submit button for the single-ticket layout. -->
        <xpath expr="(//form[@id='registration_form']//button[@type='submit' and hasclass('a-submit')])[2]"
               position="replace">
            <button type="submit" class="btn btn-primary a-submit" t-attf-id="#{event.id}" disabled="disabled">
                Tickets kaufen
                <t t-if="event.seats_limited and event.seats_max and event.seats_available &lt;= (event.seats_max * 0.2)">
                    (nur noch <t t-out="event.seats_available"/> verfügbar)
                </t>
            </button>
        </xpath>
    </template>
</odoo>
