<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_groundlift_invoice_print_fields" model="ir.ui.view">
        <field name="name">account.move.form.groundlift.invoice.print.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook[1]" position="before">
                <group name="groundlift_invoice_print_fields"
                       string="GROUNDLIFT Rechnungsdruck"
                       col="2"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="groundlift_invoice_description"
                               placeholder="Einleitung, Veranstaltungsbeschreibung, Leistungszeitraum usw. …"/>
                    </group>
                    <group>
                        <field name="groundlift_invoice_side_note"
                               placeholder="z. B. Kostenstelle 79149002&#10;PSP-Element: M-79149002-06"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
