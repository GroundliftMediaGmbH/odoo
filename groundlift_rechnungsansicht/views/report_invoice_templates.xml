<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Replace the invoice document call in account.report_invoice, instead of xpatching
        account.report_invoice_document internally. This is intentionally more stable on
        customized Odoo.sh databases where the inner document view may be extended by Studio,
        localization modules or previous tests.
    -->
    <template id="report_invoice_replace_document_call_groundlift" inherit_id="account.report_invoice" priority="300">
        <xpath expr="//t[contains(@t-call, 'account.report_invoice_document')]" position="replace">
            <t t-if="o.move_type in ('out_invoice', 'out_refund')"
               t-call="groundlift_rechnungsansicht.report_invoice_document_groundlift_custom"
               t-lang="'de_DE'"/>
            <t t-else=""
               t-call="account.report_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>

    <template id="report_invoice_document_groundlift_custom">
        <t t-set="o" t-value="o.with_context(lang='de_DE')"/>
        <t t-set="gl_invoice_number" t-value="o._groundlift_invoice_display_number()"/>
        <t t-call="groundlift_rechnungsansicht.external_layout_groundlift_invoice">
            <div class="page gl_invoice_page">
                <style type="text/css">
                    .gl_invoice_page,
                    .gl_invoice_page * {
                        font-family: Arial, Helvetica, sans-serif !important;
                        color: #111111;
                        line-height: 1.18 !important;
                    }
                    .gl_invoice_page {
                        font-size: 8.4pt !important;
                    }
                    .gl_invoice_page .gl_invoice_title {
                        margin: 0 0 13mm 0 !important;
                        padding: 0 !important;
                        font-size: 12.2pt !important;
                        line-height: 1.15 !important;
                        font-weight: 400 !important;
                        color: #111111 !important;
                    }
                    .gl_invoice_page .gl_invoice_origin,
                    .gl_invoice_page .gl_invoice_narrative {
                        margin: 0 0 5mm 0 !important;
                        padding: 0 !important;
                        font-size: 8.4pt !important;
                        line-height: 1.18 !important;
                        white-space: pre-line !important;
                    }

                    /* Invoice table. Borders are in the actual invoice body, not in the external layout preview. */
                    .gl_invoice_page table.gl_invoice_line_table {
                        width: 100% !important;
                        border-collapse: collapse !important;
                        border-spacing: 0 !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        font-size: 8.0pt !important;
                        line-height: 1.16 !important;
                    }
                    .gl_invoice_page table.gl_invoice_line_table thead {
                        display: table-header-group !important;
                    }
                    .gl_invoice_page table.gl_invoice_line_table thead tr {
                        border-bottom: 0.55pt solid #111111 !important;
                    }
                    .gl_invoice_page table.gl_invoice_line_table thead th {
                        padding: 0 1.2mm 1.4mm 0 !important;
                        font-size: 7.7pt !important;
                        font-weight: 400 !important;
                        color: #555555 !important;
                        background: transparent !important;
                        border-top: none !important;
                        border-left: none !important;
                        border-right: none !important;
                        border-bottom: 0.55pt solid #111111 !important;
                    }
                    .gl_invoice_page table.gl_invoice_line_table tbody td {
                        padding: 2.2mm 1.2mm 0.6mm 0 !important;
                        font-size: 8.0pt !important;
                        line-height: 1.16 !important;
                        vertical-align: top !important;
                        border: none !important;
                        background: transparent !important;
                    }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_pos { width: 9mm !important; text-align: left !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_desc { width: 68mm !important; text-align: left !important; white-space: pre-line !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_qty { width: 17mm !important; text-align: right !important; white-space: nowrap !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_uom { width: 18mm !important; text-align: left !important; white-space: nowrap !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_price { width: 20mm !important; text-align: right !important; white-space: nowrap !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_tax { width: 16mm !important; text-align: right !important; white-space: nowrap !important; }
                    .gl_invoice_page table.gl_invoice_line_table .gl_col_amount { width: 24mm !important; text-align: right !important; white-space: nowrap !important; }
                    .gl_invoice_page table.gl_invoice_line_table tr.gl_section_line td,
                    .gl_invoice_page table.gl_invoice_line_table tr.gl_note_line td {
                        padding-top: 2.4mm !important;
                        font-weight: 400 !important;
                        white-space: pre-line !important;
                    }

                    .gl_invoice_page .gl_totals_wrap {
                        width: 100% !important;
                        margin-top: 7mm !important;
                        text-align: right !important;
                        page-break-inside: avoid !important;
                    }
                    .gl_invoice_page .gl_totals_table {
                        display: inline-table !important;
                        width: 108mm !important;
                        border-collapse: collapse !important;
                        font-size: 8.2pt !important;
                        line-height: 1.18 !important;
                    }
                    .gl_invoice_page .gl_totals_table td {
                        padding: 1.1mm 0 !important;
                        border: none !important;
                        font-size: 8.2pt !important;
                        vertical-align: top !important;
                    }
                    .gl_invoice_page .gl_totals_table td:first-child {
                        text-align: left !important;
                        width: 78mm !important;
                    }
                    .gl_invoice_page .gl_totals_table td:last-child {
                        text-align: right !important;
                        width: 30mm !important;
                        white-space: nowrap !important;
                    }
                    .gl_invoice_page .gl_totals_table .gl_total_final td {
                        border-top: 0.55pt solid #111111 !important;
                        font-weight: 700 !important;
                        padding-top: 1.6mm !important;
                    }
                    .gl_invoice_page .gl_payment_terms {
                        margin-top: 10mm !important;
                        font-size: 8.2pt !important;
                        line-height: 1.2 !important;
                        white-space: pre-line !important;
                    }
                </style>

                <h2 class="gl_invoice_title">
                    <t t-if="o.move_type == 'out_refund'">Gutschrift </t>
                    <t t-else="">Rechnung </t>
                    <span t-out="gl_invoice_number"/>
                </h2>

                <div class="gl_invoice_origin" t-if="o.invoice_origin">
                    <span t-out="o.invoice_origin"/>
                </div>

                <table class="gl_invoice_line_table">
                    <thead>
                        <tr>
                            <th class="gl_col_pos">Pos</th>
                            <th class="gl_col_desc">Bezeichnung</th>
                            <th class="gl_col_qty">Menge</th>
                            <th class="gl_col_uom">Einheit</th>
                            <th class="gl_col_price">Einzel €</th>
                            <th class="gl_col_tax">USt. %</th>
                            <th class="gl_col_amount">Gesamt €</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="gl_pos" t-value="0"/>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <t t-if="line.display_type == 'product'">
                                <t t-set="gl_pos" t-value="gl_pos + 1"/>
                                <tr>
                                    <td class="gl_col_pos"><span t-out="gl_pos"/></td>
                                    <td class="gl_col_desc"><span t-field="line.name"/></td>
                                    <td class="gl_col_qty"><span t-field="line.quantity"/></td>
                                    <td class="gl_col_uom"><span t-field="line.product_uom_id"/></td>
                                    <td class="gl_col_price"><span t-field="line.price_unit"/></td>
                                    <td class="gl_col_tax"><span t-out="line._groundlift_invoice_tax_rate_display()"/></td>
                                    <td class="gl_col_amount"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <tr class="gl_section_line">
                                    <td/>
                                    <td colspan="6"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <tr class="gl_note_line">
                                    <td/>
                                    <td colspan="6"><span t-field="line.name"/></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <t t-set="gl_tax_summary_lines" t-value="o._groundlift_invoice_tax_summary_by_rate()"/>
                <div class="gl_totals_wrap">
                    <table class="gl_totals_table">
                        <tr>
                            <td>Summe:</td>
                            <td><span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                        <t t-foreach="gl_tax_summary_lines" t-as="tax_line">
                            <tr>
                                <td>
                                    <span t-out="tax_line['label']"/>
                                    <span> (aus </span>
                                    <span t-out="tax_line['base']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    <span> netto):</span>
                                </td>
                                <td><span t-out="tax_line['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                        </t>
                        <tr class="gl_total_final">
                            <td>Endbetrag:</td>
                            <td><span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                    </table>
                </div>

                <div class="gl_payment_terms" t-if="o.invoice_payment_term_id and o.invoice_payment_term_id.note">
                    <strong>Bitte beachten Sie unsere Zahlungsbedingung:</strong><br/>
                    <span t-field="o.invoice_payment_term_id.note"/>
                </div>
            </div>
        </t>
    </template>
</odoo>
