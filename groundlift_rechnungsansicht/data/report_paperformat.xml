<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A4 paperformat tuned for the Groundlift Rechnungsansicht.
        The larger top margin is intentional: Odoo/wkhtmltopdf repeats the external
        layout header on every PDF page. The invoice body must therefore start below
        the logo, right-hand metadata and centered page counter.
    -->
    <record id="paperformat_groundlift_invoice_a4" model="report.paperformat">
        <field name="name">GROUNDLIFT Rechnung A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">72</field>
        <field name="margin_bottom">27</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">62</field>
        <field name="dpi">90</field>
    </record>
</odoo>
