<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_scorsese_user" model="res.groups">
        <field name="name">SCORSESE Benutzer</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_scorsese_manager" model="res.groups">
        <field name="name">SCORSESE Administrator</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="implied_ids" eval="[(4, ref('groundlift_scorsese_bridge.group_scorsese_user'))]"/>
    </record>
    <record id="group_scorsese_agent" model="res.groups">
        <field name="name">SCORSESE API Agent</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
</odoo>
