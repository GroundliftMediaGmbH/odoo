<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19: res.groups in this environment has no category_id field.
        The previous version created groups but did not assign/imply them,
        so all menus/buttons were invisible after installation.
    -->
    <record id="group_scorsese_user" model="res.groups">
        <field name="name">SCORSESE Benutzer</field>
    </record>

    <record id="group_scorsese_manager" model="res.groups">
        <field name="name">SCORSESE Administrator</field>
        <field name="implied_ids" eval="[(4, ref('groundlift_scorsese_bridge.group_scorsese_user'))]"/>
    </record>

    <record id="group_scorsese_agent" model="res.groups">
        <field name="name">SCORSESE API Agent</field>
    </record>

    <!-- Make the module usable immediately after installation. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('groundlift_scorsese_bridge.group_scorsese_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('groundlift_scorsese_bridge.group_scorsese_manager'))]"/>
    </record>
</odoo>
