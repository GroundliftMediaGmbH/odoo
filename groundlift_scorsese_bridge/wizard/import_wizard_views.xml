<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_scorsese_import_wizard_form" model="ir.ui.view">
        <field name="name">gl.scorsese.import.wizard.form</field>
        <field name="model">gl.scorsese.import.wizard</field>
        <field name="arch" type="xml">
            <form string="SCORSESE Ordner importieren">
                <sheet>
                    <group>
                        <group>
                            <field name="target_model"/>
                            <field name="storage_id"/>
                            <field name="folder_path" placeholder="\\SERVER\Produktion\2026-09-28 Hans Sigl Talk Fast Forward"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="parsed_date"/>
                            <field name="create_validation_job"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Ordner im Format „YYYY-MM-DD Titel“ werden automatisch in Datum und Titel aufgeteilt. 
                        Der Import erstellt nur den Odoo-Datensatz und verknüpft den bestehenden Ordner.
                    </p>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Importieren" class="btn-primary"/>
                    <button string="Abbrechen" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
