<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Paperformat tuned for the minimal GROUNDLIFT invoice layout.
        If wkhtmltopdf renders the header/body with a small vertical offset in your DB,
        adjust margin_top/header_spacing here first.
    -->
    <record id="paperformat_groundlift_invoice_a4" model="report.paperformat">
        <field name="name">GROUNDLIFT Rechnung A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">42</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>
</odoo>
