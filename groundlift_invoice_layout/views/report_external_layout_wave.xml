<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        GROUNDLIFT variant of Odoo's Wave external layout.
        Scope: every report using the Wave document layout. The invoice report action
        is patched separately to use the GROUNDLIFT paperformat and filename.
    -->
    <template id="external_layout_wave_groundlift" inherit_id="web.external_layout_wave" priority="99">

        <!-- HEADER: centered logo, invoice metadata and page counter. -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
            <div t-attf-class="header gl_groundlift_header o_company_#{company.id}_layout {{report_type != 'pdf' and 'h-0'}}">
                <style type="text/css">
                    .gl_groundlift_header,
                    .gl_groundlift_article,
                    .gl_groundlift_footer {
                        font-family: Arial, Helvetica, sans-serif !important;
                        color: #111111;
                    }

                    /* ---------- Header ---------- */
                    .gl_groundlift_header {
                        position: relative;
                        min-height: 70mm;
                        padding: 8mm 18mm 0 18mm;
                    }
                    .gl_groundlift_header .gl_logo_wrap {
                        width: 100%;
                        text-align: center;
                    }
                    .gl_groundlift_header .gl_company_logo {
                        max-width: 62mm;
                        max-height: 20mm;
                        object-fit: contain;
                    }
                    .gl_groundlift_header .gl_invoice_meta {
                        position: absolute;
                        top: 35mm;
                        right: 18mm;
                        width: 80mm;
                        font-size: 8.6pt;
                        line-height: 1.18;
                        color: #111111;
                    }
                    .gl_groundlift_header .gl_invoice_meta .gl_label {
                        display: inline-block;
                        min-width: 32mm;
                    }
                    .gl_groundlift_header .gl_page_counter {
                        position: absolute;
                        top: 63mm;
                        left: 0;
                        right: 0;
                        text-align: center;
                        font-size: 8.8pt;
                        line-height: 1;
                        color: #111111;
                    }

                    /* ---------- Body / invoice content ---------- */
                    .gl_groundlift_article {
                        font-size: 8.8pt !important;
                        line-height: 1.18 !important;
                    }
                    .gl_groundlift_article * {
                        line-height: 1.18 !important;
                    }
                    .gl_groundlift_article .text-primary,
                    .gl_groundlift_article .text-muted,
                    .gl_groundlift_article .o_main_table .text-primary,
                    .gl_groundlift_article #total .text-primary {
                        color: #111111 !important;
                    }
                    .gl_groundlift_article .gl_sender_line {
                        margin: 0 0 7mm 0;
                        font-size: 7.3pt !important;
                        line-height: 1.1 !important;
                        color: #e5262d !important;
                        white-space: nowrap;
                    }
                    .gl_groundlift_article .o_address_layout,
                    .gl_groundlift_article [name='address'],
                    .gl_groundlift_article address,
                    .gl_groundlift_article .address {
                        font-size: 8.9pt !important;
                        line-height: 1.18 !important;
                    }
                    .gl_groundlift_article h1,
                    .gl_groundlift_article h2,
                    .gl_groundlift_article .gl_document_title {
                        margin: 9mm 0 8mm 0 !important;
                        padding: 0 !important;
                        font-size: 13.2pt !important;
                        line-height: 1.15 !important;
                        font-weight: 400 !important;
                        color: #111111 !important;
                    }

                    /* Hide the standard QR payment block; the Farbe-Blau reference has none. */
                    .gl_groundlift_article #qrcode,
                    .gl_groundlift_article .o_qr_code,
                    .gl_groundlift_article .o_invoice_qr_code,
                    .gl_groundlift_article div[name='qrcode'] {
                        display: none !important;
                    }

                    /* ---------- Invoice table ---------- */
                    .gl_groundlift_article table.o_main_table,
                    .gl_groundlift_article table[name='invoice_line_table'],
                    .gl_groundlift_article table.table {
                        width: 100% !important;
                        margin-top: 5mm !important;
                        font-size: 8.4pt !important;
                        line-height: 1.16 !important;
                        border-collapse: collapse !important;
                        border-spacing: 0 !important;
                    }
                    .gl_groundlift_article table.o_main_table thead th,
                    .gl_groundlift_article table[name='invoice_line_table'] thead th,
                    .gl_groundlift_article table.table thead th {
                        padding: 0 1.2mm 1.4mm 0 !important;
                        font-size: 8.2pt !important;
                        font-weight: 400 !important;
                        color: #555555 !important;
                        background: transparent !important;
                        border-top: none !important;
                        border-left: none !important;
                        border-right: none !important;
                        border-bottom: 0.45pt solid #111111 !important;
                    }
                    .gl_groundlift_article table.o_main_table tbody td,
                    .gl_groundlift_article table[name='invoice_line_table'] tbody td,
                    .gl_groundlift_article table.table tbody td {
                        padding: 2mm 1.2mm 0.6mm 0 !important;
                        font-size: 8.4pt !important;
                        line-height: 1.16 !important;
                        vertical-align: top !important;
                        border: none !important;
                        background: transparent !important;
                    }
                    .gl_groundlift_article table.o_main_table tbody tr,
                    .gl_groundlift_article table[name='invoice_line_table'] tbody tr {
                        background: transparent !important;
                    }
                    .gl_groundlift_article .o_line_section,
                    .gl_groundlift_article .o_line_note,
                    .gl_groundlift_article tr.o_line_section,
                    .gl_groundlift_article tr.o_line_note {
                        background: transparent !important;
                    }

                    /* Closer to the reference: no separate tax column in the line table. */
                    .gl_groundlift_article table[name='invoice_line_table'] th[name='th_taxes'],
                    .gl_groundlift_article table[name='invoice_line_table'] td[name='td_taxes'],
                    .gl_groundlift_article table.o_main_table th[name='th_taxes'],
                    .gl_groundlift_article table.o_main_table td[name='td_taxes'] {
                        display: none !important;
                    }

                    /* Common Odoo invoice column names. */
                    .gl_groundlift_article th[name='th_description'] { width: 52% !important; }
                    .gl_groundlift_article th[name='th_quantity'] { width: 10% !important; }
                    .gl_groundlift_article th[name='th_priceunit'] { width: 14% !important; }
                    .gl_groundlift_article th[name='th_subtotal'] { width: 14% !important; }

                    /* ---------- Totals ---------- */
                    .gl_groundlift_article #total,
                    .gl_groundlift_article .clearfix,
                    .gl_groundlift_article .o_total_table {
                        font-size: 8.8pt !important;
                        line-height: 1.18 !important;
                    }
                    .gl_groundlift_article #total table,
                    .gl_groundlift_article .o_total_table {
                        border-collapse: collapse !important;
                        margin-top: 6mm !important;
                    }
                    .gl_groundlift_article #total table td,
                    .gl_groundlift_article .o_total_table td,
                    .gl_groundlift_article .o_total_table th {
                        padding-top: 1.2mm !important;
                        padding-bottom: 1.2mm !important;
                        border-left: none !important;
                        border-right: none !important;
                        border-bottom: none !important;
                        background: transparent !important;
                    }
                    .gl_groundlift_article #total table tr:first-child td,
                    .gl_groundlift_article .o_total_table tr:first-child td,
                    .gl_groundlift_article .o_total_table tr:first-child th {
                        border-top: 0.45pt solid #111111 !important;
                    }
                    .gl_groundlift_article #total table tr:last-child td,
                    .gl_groundlift_article .o_total_table tr:last-child td,
                    .gl_groundlift_article .o_total_table tr:last-child th,
                    .gl_groundlift_article .border-black,
                    .gl_groundlift_article .border-top {
                        border-top: 0.45pt solid #111111 !important;
                        border-color: #111111 !important;
                    }

                    /* ---------- Footer ---------- */
                    .gl_groundlift_footer {
                        font-size: 6.9pt !important;
                        color: #8a8d91 !important;
                    }
                    .gl_groundlift_footer .gl_footer_inner {
                        position: relative;
                        height: 20mm;
                        margin: 0 10mm 7mm 18mm;
                    }
                    .gl_groundlift_footer .gl_footer_mark {
                        position: absolute;
                        left: 0;
                        top: 1.1mm;
                        width: 0.55mm;
                        height: 16.2mm;
                        background: #e5262d;
                    }
                    .gl_groundlift_footer .gl_footer_col {
                        position: absolute;
                        top: 0;
                        vertical-align: top;
                        line-height: 1.16 !important;
                        white-space: normal;
                    }
                    .gl_groundlift_footer .gl_footer_col_1 { left: 7mm; width: 68mm; }
                    .gl_groundlift_footer .gl_footer_col_2 { left: 82mm; width: 54mm; }
                    .gl_groundlift_footer .gl_footer_col_3 { left: 140mm; width: 50mm; }
                    .gl_groundlift_footer strong {
                        display: block;
                        margin-bottom: 1mm;
                        color: #e5262d !important;
                        font-weight: 700 !important;
                        letter-spacing: 0.015em;
                    }
                </style>

                <div class="gl_logo_wrap">
                    <img t-if="company.logo" class="gl_company_logo" t-att-src="image_data_uri(company.logo)" alt="GROUNDLIFT"/>
                </div>

                <div class="gl_invoice_meta" t-if="o and o._name == 'account.move'">
                    <div>
                        <span class="gl_label">Belegnummer:</span>
                        <span t-out="o.name if o.name and o.name != '/' else ''"/>
                    </div>
                    <div t-if="o.invoice_date">
                        <span class="gl_label">Belegdatum:</span>
                        <span t-field="o.invoice_date"/>
                    </div>
                    <div t-if="'delivery_date' in o._fields and o.delivery_date">
                        <span class="gl_label">Liefer-/Leistungsdatum:</span>
                        <span t-field="o.delivery_date"/>
                    </div>
                    <div t-elif="o.invoice_date">
                        <span class="gl_label">Liefer-/Leistungsdatum:</span>
                        <span t-field="o.invoice_date"/>
                    </div>
                </div>

                <div class="gl_page_counter" t-if="report_type == 'pdf'">
                    <span>Seite </span><span class="page"/> <span>von</span> <span class="topage"/>
                </div>
            </div>
        </xpath>

        <!-- BODY: keep Odoo invoice content; only provide external framing. -->
        <xpath expr="//div[contains(@t-attf-class, 'article o_report_layout_wave')]" position="replace">
            <div t-attf-class="article gl_groundlift_article o_company_#{company.id}_layout {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
                 t-attf-style="{{report_type != 'pdf' and 'margin-top:72mm;'}} {{ 'background-image: url(%s);' % layout_background_url if layout_background_url else ''}}"
                 t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-set="custom_layout_address" t-value="true"/>
                <t t-set="information_block" t-value="False"/>
                <div class="gl_sender_line" t-if="o and o._name == 'account.move'">
                    Groundlift Media GmbH · Am Eichet 11a · 86938 Schondorf
                </div>
                <t t-call="web.address_layout"/>
                <h2 class="gl_document_title" t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>
        </xpath>

        <!-- FOOTER: absolute columns instead of table-cell; wkhtmltopdf is more reliable here. -->
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]" position="replace">
            <div t-attf-class="footer gl_groundlift_footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'position-relative mt-auto mx-n5'}}">
                <div class="gl_footer_inner">
                    <div class="gl_footer_mark"/>
                    <div class="gl_footer_col gl_footer_col_1">
                        <strong>GROUNDLIFT MEDIA GMBH</strong>
                        <div>Am Eichet 11a, 86938 Schondorf am Ammersee</div>
                        <div>Telefon: +49 8192 933333 | Fax: +49 8192 933339</div>
                        <div>anfrage@groundlift.de | www.groundlift.de</div>
                    </div>
                    <div class="gl_footer_col gl_footer_col_2">
                        <div>Geschäftsführung: Daniel Betz</div>
                        <div>HRB 34444, Amtsgericht Augsburg</div>
                        <div>USt.-ID: <span t-out="company.vat or 'DE328162722'"/></div>
                    </div>
                    <div class="gl_footer_col gl_footer_col_3">
                        <div>VR-Bank Landsberg-Ammersee eG</div>
                        <div>IBAN: DE57700916000002572265</div>
                        <div>BIC: GENODEF1DSS</div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
