<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_video_job_list" model="ir.ui.view">
        <field name="name">gl.video.teaser.job.list</field>
        <field name="model">gl.video.teaser.job</field>
        <field name="arch" type="xml">
            <list string="AI Video-Teaser" default_order="create_date desc">
                <field name="name"/>
                <field name="event_id"/>
                <field name="style_id"/>
                <field name="duration"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
                <field name="approved_by" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_gl_video_job_search" model="ir.ui.view">
        <field name="name">gl.video.teaser.job.search</field>
        <field name="model">gl.video.teaser.job</field>
        <field name="arch" type="xml">
            <search string="AI Video-Teaser">
                <field name="event_id"/>
                <field name="style_id"/>
                <field name="state"/>
                <filter string="Fehler" name="error" domain="[('state','=','error')]"/>
                <filter string="Freigegeben" name="approved" domain="[('state','=','approved')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Event" name="group_event" context="{'group_by':'event_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gl_video_job_form" model="ir.ui.view">
        <field name="name">gl.video.teaser.job.form</field>
        <field name="model">gl.video.teaser.job</field>
        <field name="arch" type="xml">
            <form string="AI Video-Teaser">
                <header>
                    <button name="action_queue" type="object" string="Teaser generieren" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process_now" type="object" string="Nächsten Schritt jetzt ausführen" groups="event.group_event_manager" invisible="state not in ('queued','planning','assets','rendering')"/>
                    <button name="action_approve" type="object" string="Freigeben" class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_retry" type="object" string="Erneut versuchen" invisible="state != 'error'"/>
                    <button name="action_cancel" type="object" string="Abbrechen" invisible="state not in ('queued','planning','assets','rendering')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,planning,assets,rendering,done,approved,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="style_id"/>
                            <field name="duration"/>
                            <field name="generate_16_9"/>
                            <field name="generate_9_16"/>
                        </group>
                        <group>
                            <field name="use_runway"/>
                            <field name="generate_music"/>
                            <field name="subtitles"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="checkpoint" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Regie &amp; Voiceover">
                            <group>
                                <field name="hook_text"/>
                                <field name="voiceover_text" placeholder="Wird durch OpenAI erzeugt und kann vor dem Rendering noch bearbeitet werden."/>
                                <field name="cta_text"/>
                                <field name="music_prompt"/>
                            </group>
                        </page>

                        <page string="Szenen">
                            <field name="scene_ids" context="{'default_job_id': id}">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="duration"/>
                                    <field name="source_kind"/>
                                    <field name="asset_id"/>
                                    <field name="overlay_headline"/>
                                    <field name="overlay_subline"/>
                                    <field name="runway_state_16_9" optional="hide"/>
                                    <field name="runway_state_9_16" optional="hide"/>
                                </list>
                                <form string="Szene">
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="duration"/>
                                            <field name="source_kind"/>
                                            <field name="asset_id"/>
                                        </group>
                                        <group>
                                            <field name="overlay_headline"/>
                                            <field name="overlay_subline"/>
                                        </group>
                                    </group>
                                    <field name="runway_prompt"/>
                                    <group string="Runway">
                                        <field name="runway_state_16_9" readonly="1"/>
                                        <field name="runway_state_9_16" readonly="1"/>
                                        <field name="runway_url_16_9" widget="url" readonly="1"/>
                                        <field name="runway_url_9_16" widget="url" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Vorschau" invisible="state not in ('done','approved')">
                            <field name="preview_html" widget="html" readonly="1" nolabel="1"/>
                            <group>
                                <field name="output_url_16_9" widget="url" readonly="1"/>
                                <field name="output_url_9_16" widget="url" readonly="1"/>
                                <field name="output_16_9" filename="output_filename_16_9" readonly="1"/>
                                <field name="output_9_16" filename="output_filename_9_16" readonly="1"/>
                            </group>
                        </page>

                        <page string="Technik">
                            <group string="Creatomate">
                                <field name="creatomate_id_16_9" readonly="1"/>
                                <field name="creatomate_state_16_9" readonly="1"/>
                                <field name="creatomate_url_16_9" widget="url" readonly="1"/>
                                <field name="creatomate_id_9_16" readonly="1"/>
                                <field name="creatomate_state_9_16" readonly="1"/>
                                <field name="creatomate_url_9_16" widget="url" readonly="1"/>
                            </group>
                            <group string="Fehler / Log">
                                <field name="error_message" readonly="1"/>
                                <field name="log_text" readonly="1"/>
                                <field name="plan_json" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
