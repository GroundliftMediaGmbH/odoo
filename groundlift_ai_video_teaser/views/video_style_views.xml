<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_video_style_list" model="ir.ui.view">
        <field name="name">gl.video.teaser.style.list</field>
        <field name="model">gl.video.teaser.style</field>
        <field name="arch" type="xml">
            <list string="Video-Styles" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="template_kind"/>
                <field name="pacing_profile"/>
                <field name="target_scene_count"/>
                <field name="active"/>
                <field name="subtitle_effect"/>
            </list>
        </field>
    </record>

    <record id="view_gl_video_style_form" model="ir.ui.view">
        <field name="name">gl.video.teaser.style.form</field>
        <field name="model">gl.video.teaser.style</field>
        <field name="arch" type="xml">
            <form string="Video-Style">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="subtitle_effect"/>
                            <field name="template_kind"/>
                            <field name="pacing_profile"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Szenen-Blueprint">
                        <group>
                            <field name="target_scene_count"/>
                            <field name="min_scene_duration"/>
                            <field name="max_scene_duration"/>
                        </group>
                        <group>
                            <field name="reference_structure" widget="text" placeholder="z. B. 0-2s Hook, 2-6s Hero, 6-12s Montage ..."/>
                            <field name="identity_prompt" widget="text" placeholder="Zusätzlicher Guardrail für Gesichter / Identität ..."/>
                        </group>
                    </group>
                    <group string="Creative Direction">
                        <field name="director_prompt" placeholder="Dramaturgie, Schnittgefühl, Tonalität ..."/>
                        <field name="runway_prompt_suffix" placeholder="Globale Bewegungs-/Kameraanweisung ..."/>
                        <field name="music_prompt" placeholder="Musikalische Grundrichtung ..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
