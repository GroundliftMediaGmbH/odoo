<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_website_color_entry_list" model="ir.ui.view">
        <field name="name">gl.website.color.entry.list</field>
        <field name="model">gl.website.color.entry</field>
        <field name="arch" type="xml">
            <list string="Farb-Fundstellen" editable="bottom" decoration-muted="not active">
                <field name="active"/>
                <field name="website_id"/>
                <field name="swatch_id"/>
                <field name="source_type"/>
                <field name="selector"/>
                <field name="property_name"/>
                <field name="css_variable"/>
                <field name="original_color" widget="gl_hex_color" readonly="1"/>
                <field name="raw_value"/>
                <field name="matched_value"/>
                <field name="occurrence_count"/>
                <field name="last_seen" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_gl_website_color_entry_form" model="ir.ui.view">
        <field name="name">gl.website.color.entry.form</field>
        <field name="model">gl.website.color.entry</field>
        <field name="arch" type="xml">
            <form string="Farb-Fundstelle">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="swatch_id"/>
                            <field name="website_id" readonly="1"/>
                            <field name="source_type"/>
                            <field name="original_color" widget="gl_hex_color" readonly="1"/>
                        </group>
                        <group>
                            <field name="property_name"/>
                            <field name="css_variable"/>
                            <field name="occurrence_count"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="scan_session_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="selector"/>
                        <field name="raw_value"/>
                        <field name="matched_value"/>
                        <field name="sample_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_website_color_entry_search" model="ir.ui.view">
        <field name="name">gl.website.color.entry.search</field>
        <field name="model">gl.website.color.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="website_id"/>
                <field name="swatch_id"/>
                <field name="selector"/>
                <field name="property_name"/>
                <field name="raw_value"/>
                <filter name="filter_active_entries" string="Für CSS aktiv" domain="[('active', '=', True)]"/>
                <filter name="variables" string="CSS-Variablen" domain="[('source_type', '=', 'css_variable')]"/>
                <filter name="computed" string="Gerenderte Stile" domain="[('source_type', '=', 'computed')]"/>
                <group>
                    <filter name="group_website" string="Website" context="{'group_by': 'website_id'}"/>
                    <filter name="group_swatch" string="Farbe" context="{'group_by': 'swatch_id'}"/>
                    <filter name="group_property" string="CSS-Eigenschaft" context="{'group_by': 'property_name'}"/>
                    <filter name="group_source" string="Quelle" context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gl_website_color_entry" model="ir.actions.act_window">
        <field name="name">Farb-Fundstellen</field>
        <field name="res_model">gl.website.color.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_website_color_entry_search"/>
    </record>
</odoo>
