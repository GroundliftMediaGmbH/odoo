<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_website_color_scan_wizard_form" model="ir.ui.view">
        <field name="name">gl.website.color.scan.wizard.form</field>
        <field name="model">gl.website.color.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Homepage-Farbscan starten">
                <group>
                    <field name="website_id"/>
                    <field name="path" placeholder="/"/>
                </group>
                <p class="text-muted">
                    Der Scan öffnet die Website in einem neuen Tab. Dort werden die tatsächlich gerenderten Farben erfasst und im Backend gespeichert. Mit der Bereichsauswahl kannst du direkt auf ein sichtbares Element klicken und nur dessen Farben bearbeiten.
                </p>
                <footer>
                    <button name="action_start_homepage_scan" type="object" string="Ganze Seite scannen" class="btn-primary"/>
                    <button name="action_start_click_pick_scan" type="object" string="Bereich anklicken" class="btn-secondary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gl_website_color_scan_wizard" model="ir.actions.act_window">
        <field name="name">Homepage scannen</field>
        <field name="res_model">gl.website.color.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_gl_website_color_scan_session_list" model="ir.ui.view">
        <field name="name">gl.website.color.scan.session.list</field>
        <field name="model">gl.website.color.scan.session</field>
        <field name="arch" type="xml">
            <list string="Farbscans">
                <field name="scan_date"/>
                <field name="website_id"/>
                <field name="url"/>
                <field name="state"/>
                <field name="color_count"/>
                <field name="entry_count"/>
                <field name="picked_sample_text"/>
            </list>
        </field>
    </record>

    <record id="view_gl_website_color_scan_session_form" model="ir.ui.view">
        <field name="name">gl.website.color.scan.session.form</field>
        <field name="model">gl.website.color.scan.session</field>
        <field name="arch" type="xml">
            <form string="Farbscan">
                <header>
                    <button name="action_open_picked_swatches" type="object" string="Angeklickte Farben bearbeiten" class="oe_highlight" invisible="not picked_swatch_ids"/>
                    <button name="action_open_picked_entries" type="object" string="Angeklickte Fundstellen öffnen" invisible="not picked_swatch_ids"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="website_id" readonly="1"/>
                            <field name="scan_date" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="color_count" readonly="1"/>
                            <field name="entry_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="url" readonly="1"/>
                        <field name="message" readonly="1"/>
                        <field name="picked_sample_text" readonly="1"/>
                        <field name="picked_selector" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Angeklickte Farben" invisible="not picked_swatch_ids">
                            <field name="picked_swatch_ids" readonly="0">
                                <list editable="bottom">
                                    <field name="active"/>
                                    <field name="original_color" widget="gl_hex_color" readonly="1"/>
                                    <field name="replacement_color" widget="gl_hex_color"/>
                                    <field name="occurrence_count" readonly="1"/>
                                    <field name="picked_entry_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fundstellen">
                            <field name="entry_ids" readonly="1">
                                <list>
                                    <field name="swatch_id"/>
                                    <field name="picked"/>
                                    <field name="source_type"/>
                                    <field name="selector"/>
                                    <field name="property_name"/>
                                    <field name="raw_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_website_color_scan_session" model="ir.actions.act_window">
        <field name="name">Scan-Historie</field>
        <field name="res_model">gl.website.color.scan.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
