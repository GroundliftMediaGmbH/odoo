<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_groundlift_checkout" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.groundlift.event.checkout</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']/block[@id='website_info_settings']" position="after">
                <block title="Groundlift Ticket-Checkout" id="groundlift_event_checkout_settings">
                    <setting id="groundlift_event_checkout_switch"
                             string="Groundlift One-Page Checkout"
                             help="Sofortiger Notfall-Schalter zwischen dem Groundlift Ticket-/Checkout-Ablauf und dem unveränderten Odoo-Standardablauf.">
                        <field name="groundlift_event_checkout_enabled" invisible="1"/>
                        <div class="content-group">
                            <div class="mt8" invisible="not groundlift_event_checkout_enabled">
                                <span class="badge text-bg-success me-2">Groundlift Checkout aktiv</span>
                                <span class="text-muted">Ticketselektor und One-Page-Checkout werden verwendet.</span>
                            </div>
                            <div class="mt8" invisible="groundlift_event_checkout_enabled">
                                <span class="badge text-bg-secondary me-2">Odoo-Standard aktiv</span>
                                <span class="text-muted">Die Groundlift-Oberfläche wird umgangen.</span>
                            </div>
                            <div class="mt12">
                                <button name="action_groundlift_checkout_use_standard"
                                        type="object"
                                        string="Odoo-Standard aktivieren"
                                        class="btn btn-outline-danger"
                                        icon="fa-undo"
                                        invisible="not groundlift_event_checkout_enabled"/>
                                <button name="action_groundlift_checkout_use_custom"
                                        type="object"
                                        string="Groundlift Checkout aktivieren"
                                        class="btn btn-primary"
                                        icon="fa-check"
                                        invisible="groundlift_event_checkout_enabled"/>
                            </div>
                            <div class="text-muted mt8">
                                Die Umschaltung gilt sofort für die oben ausgewählte Website. Ein zusätzliches Speichern ist nicht erforderlich.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
