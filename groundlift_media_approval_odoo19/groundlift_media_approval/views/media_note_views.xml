<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_media_note_tree" model="ir.ui.view">
        <field name="name">gl.media.approval.note.tree</field>
        <field name="model">gl.media.approval.note</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="create_date desc">
                <field name="create_date" string="Zeitpunkt"/>
                <field name="person_id"/>
                <field name="file_id"/>
                <field name="folder_id"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="view_gl_media_note_form" model="ir.ui.view">
        <field name="name">gl.media.approval.note.form</field>
        <field name="model">gl.media.approval.note</field>
        <field name="arch" type="xml">
            <form string="Video-Notiz" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="create_date" string="Zeitpunkt"/>
                        <field name="person_id"/>
                        <field name="file_id"/>
                        <field name="folder_id"/>
                    </group>
                    <group>
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_media_note" model="ir.actions.act_window">
        <field name="name">Video-Notizen</field>
        <field name="res_model">gl.media.approval.note</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
