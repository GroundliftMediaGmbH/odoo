<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: res.groups uses privilege_id; category_id belongs to res.groups.privilege. -->
    <record id="module_category_groundlift_media_approval" model="ir.module.category">
        <field name="name">Groundlift</field>
        <field name="description">Groundlift Medienfreigabe</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_media_approval" model="res.groups.privilege">
        <field name="name">Medienfreigabe</field>
        <field name="category_id" ref="module_category_groundlift_media_approval"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_media_approval_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_media_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Kann Medienfreigabe konfigurieren, Dateien hochladen und Freigaben verwalten.</field>
    </record>
</odoo>
