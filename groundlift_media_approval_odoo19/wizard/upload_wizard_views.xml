<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_media_upload_wizard_form" model="ir.ui.view">
        <field name="name">gl.media.approval.upload.wizard.form</field>
        <field name="model">gl.media.approval.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Dateien hochladen">
                <group>
                    <field name="folder_id"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="delete_local_attachments"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Auf Hetzner hochladen" class="btn-primary"/>
                    <button string="Abbrechen" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gl_media_upload_wizard" model="ir.actions.act_window">
        <field name="name">Dateien hochladen</field>
        <field name="res_model">gl.media.approval.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
