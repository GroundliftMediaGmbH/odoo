<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_event_form_guestlist_inherit" model="ir.ui.view">
        <field name="name">event.event.form.guestlist.inherit</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Gästeliste" name="guestlist">
                    <group>
                        <group string="Übersicht">
                            <field name="guestlist_total_qty" readonly="1"/>
                            <field name="guestlist_reserved_qty" readonly="1"/>
                            <field name="guestlist_waitlist_qty" readonly="1"/>
                            <field name="guestlist_checked_in_qty" readonly="1"/>
                            <field name="guestlist_remaining_qty" readonly="1"/>
                            <field name="guestlist_sold_out_with_guestlist" readonly="1"/>
                            <field name="guestlist_capacity_info" readonly="1" nolabel="1"/>
                        </group>
                        <group string="QR-Code / Einlass-Link">
                            <field name="guestlist_public_url" widget="url" readonly="1"/>
                            <field name="guestlist_qr_html" widget="html" readonly="1" nolabel="1"/>
                            <div class="d-flex gap-2 flex-wrap">
                                <button name="action_sync_guestlist_price_options"
                                        type="object"
                                        string="Preisoptionen aktualisieren"
                                        class="btn-secondary"/>
                                <button name="action_regenerate_guestlist_token"
                                        type="object"
                                        string="QR-Link neu erzeugen"
                                        class="btn-secondary"
                                        confirm="Dadurch wird der bestehende QR-Link ungültig. Fortfahren?"/>
                            </div>
                        </group>
                    </group>
                    <separator string="Gäste"/>
                    <field name="guestlist_line_ids" context="{'default_event_id': id}">
                        <list editable="bottom" decoration-success="checked_in" decoration-warning="is_waitlist">
                            <field name="name" string="Vor-/Nachname" required="1"/>
                            <field name="quantity" string="Anzahl" required="1"/>
                            <field name="employee_id" string="Bearbeiter" options="{'no_create_edit': True}"/>
                            <field name="is_waitlist" invisible="1"/>
                            <field name="price_option_id"
                                   string="Kategorie / Preis"
                                   domain="[('event_id', '=', parent.id), ('active', '=', True)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="ordered_by" string="Bestellt per" required="1"/>
                            <field name="contact_data" string="Kontaktdaten"/>
                            <field name="note" string="Bemerkung"/>
                            <field name="checked_in" string="Da" optional="show"/>
                            <field name="checked_in_datetime" string="Eingecheckt am" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
