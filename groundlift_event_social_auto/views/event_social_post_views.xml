<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_event_social_post_list" model="ir.ui.view">
        <field name="name">gl.event.social.post.list</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <list string="Groundlift Social Posts" create="false">
                <field name="gl_event_id"/>
                <field name="gl_event_social_type"/>
                <field name="gl_planned_date"/>
                <field name="gl_latest_planned_date"/>
                <field name="gl_requires_approval"/>
                <field name="gl_approved"/>
                <field name="message" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_gl_event_social_post_form" model="ir.ui.view">
        <field name="name">gl.event.social.post.form</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <form string="Groundlift Social Post">
                <header>
                    <button name="action_gl_approve_and_schedule" type="object" string="Groundlift freigeben &amp; geplant lassen" class="btn-primary" invisible="not gl_requires_approval"/>
                    <button name="action_gl_mark_needs_approval" type="object" string="Freigabe zurücknehmen" class="btn-secondary" invisible="gl_requires_approval"/>
                    <button name="action_gl_post_instagram_now" type="object" string="Direkt erneut auf Instagram posten" class="btn-secondary" invisible="not gl_has_instagram_target" confirm="Der Beitrag wird jetzt ausschließlich auf Instagram erneut veröffentlicht. Fortfahren?"/>
                    <button name="action_gl_post_facebook_now" type="object" string="Direkt erneut auf Facebook posten" class="btn-secondary" invisible="not gl_has_facebook_target" confirm="Der Beitrag wird jetzt ausschließlich auf Facebook erneut veröffentlicht. Fortfahren?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Groundlift">
                            <field name="gl_event_id"/>
                            <field name="gl_event_social_type"/>
                            <field name="gl_planned_date"/>
                            <field name="gl_latest_planned_date"/>
                            <field name="gl_requires_approval"/>
                            <field name="gl_approved"/>
                            <field name="gl_auto_generated"/>
                            <field name="gl_has_facebook_target" invisible="1"/>
                            <field name="gl_has_instagram_target" invisible="1"/>
                            <field name="gl_retry_source_post_id" readonly="1" invisible="not gl_retry_source_post_id"/>
                            <field name="gl_retry_platform" readonly="1" invisible="not gl_retry_platform"/>
                        </group>
                        <group string="Odoo Social">
                            <field name="state" readonly="1"/>
                            <field name="scheduled_date"/>
                            <field name="account_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Post">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Bilder">
                        <field name="image_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_social_post_retry_form_inherit" model="ir.ui.view">
        <field name="name">gl.social.post.retry.form.inherit</field>
        <field name="model">social.post</field>
        <field name="inherit_id" ref="social.social_post_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="gl_has_facebook_target" invisible="1"/>
                <field name="gl_has_instagram_target" invisible="1"/>
                <button name="action_gl_post_instagram_now"
                        type="object"
                        string="Direkt erneut auf Instagram posten"
                        class="btn-secondary"
                        invisible="not gl_has_instagram_target"
                        confirm="Der Beitrag wird jetzt ausschließlich auf Instagram erneut veröffentlicht. Fortfahren?"/>
                <button name="action_gl_post_facebook_now"
                        type="object"
                        string="Direkt erneut auf Facebook posten"
                        class="btn-secondary"
                        invisible="not gl_has_facebook_target"
                        confirm="Der Beitrag wird jetzt ausschließlich auf Facebook erneut veröffentlicht. Fortfahren?"/>
            </xpath>
        </field>
    </record>

    <record id="action_gl_event_social_posts" model="ir.actions.act_window">
        <field name="name">Social Posts</field>
        <field name="res_model">social.post</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('gl_auto_generated', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_gl_event_social_posts" name="Social Posts" parent="menu_gl_event_social_root" action="action_gl_event_social_posts" sequence="20"/>
</odoo>
