<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_event_social_config_list" model="ir.ui.view">
        <field name="name">gl.event.social.config.list</field>
        <field name="model">gl.event.social.config</field>
        <field name="arch" type="xml">
            <list string="Event Social Automation">
                <field name="name"/>
                <field name="active"/>
                <field name="announcement_stage_name"/>
                <field name="completed_stage_name"/>
                <field name="auto_post_without_approval"/>
                <field name="enable_weekly_promo_posts"/>
                <field name="enable_gap_filler_posts"/>
                <field name="account_search_term"/>
            </list>
        </field>
    </record>

    <record id="view_gl_event_social_config_form" model="ir.ui.view">
        <field name="name">gl.event.social.config.form</field>
        <field name="model">gl.event.social.config</field>
        <field name="arch" type="xml">
            <form string="Groundlift Event Social Automation">
                <header>
                    <button name="action_test_social_accounts" type="object" string="Kanäle testen" class="btn-secondary"/>
                    <button name="action_test_openai_api" type="object" string="ChatGPT API testen" class="btn-secondary"/>
                    <button name="action_load_all_announced_events" type="object" string="Alle Events laden" class="btn-primary"/>
                    <button name="action_generate_gap_filler_now" type="object" string="Lückenfüller erzeugen" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Auslöser">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="announcement_stage_name"/>
                            <field name="completed_stage_name"/>
                        </group>
                        <group string="Freigabe">
                            <field name="auto_post_without_approval"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kanäle">
                            <group>
                                <field name="social_account_ids" widget="many2many_tags"/>
                                <field name="account_search_term"/>
                            </group>
                        </page>
                        <page string="Posting-Zeiten">
                            <group>
                                <group string="Zeitzone">
                                    <field name="timezone"/>
                                    <field name="skip_past_planned_posts"/>
                                </group>
                                <group string="Erstankündigung">
                                    <field name="first_post_hour"/>
                                    <field name="first_post_minute"/>
                                    <field name="announcement_min_days_before"/>
                                </group>
                                <group string="Reminder">
                                    <field name="reminder_days_before"/>
                                    <field name="reminder_hour"/>
                                    <field name="reminder_minute"/>
                                </group>
                                <group string="Eventtag">
                                    <field name="event_day_hour"/>
                                    <field name="event_day_minute"/>
                                </group>
                                <group string="Ausverkauft">
                                    <field name="create_soldout_posts"/>
                                    <field name="soldout_delay_hours"/>
                                    <field name="delete_future_promo_when_soldout"/>
                                </group>
                                <group string="Nachbericht">
                                    <field name="completed_post_hour"/>
                                    <field name="completed_post_minute"/>
                                </group>
                            </group>
                        </page>
                        <page string="Texte">
                            <group>
                                <group string="Header">
                                    <field name="headline_announcement"/>
                                    <field name="headline_reminder"/>
                                    <field name="headline_event_day"/>
                                    <field name="headline_soldout"/>
                                    <field name="headline_event_day_soldout"/>
                                    <field name="headline_completed"/>
                                </group>
                                <group string="Texte und Hashtags">
                                    <field name="body_completed"/>
                                    <field name="default_hashtags"/>
                                </group>
                            </group>
                        </page>
                        <page string="ChatGPT API">
                            <group>
                                <group string="API">
                                    <field name="use_openai_hashtags"/>
                                    <field name="use_openai_headlines"/>
                                    <field name="openai_api_key" password="True"/>
                                    <field name="openai_model"/>
                                    <field name="openai_timeout"/>
                                    <field name="openai_extra_hashtag_count"/>
                                </group>
                                <group string="Prompt">
                                    <field name="openai_system_prompt"/>
                                    <field name="openai_headline_prompt"/>
                                </group>
                            </group>
                        </page>
                        <page string="Werbeposts &amp; Lückenfüller">
                            <group>
                                <group string="Wöchentlicher Werbepost">
                                    <field name="enable_weekly_promo_posts"/>
                                    <field name="weekly_promo_weekday"/>
                                    <field name="weekly_promo_lookahead_weeks"/>
                                    <field name="weekly_promo_hour"/>
                                    <field name="weekly_promo_minute"/>
                                </group>
                                <group string="Zusätzliche Lückenfüller">
                                    <field name="enable_gap_filler_posts"/>
                                    <field name="gap_filler_interval_days"/>
                                    <field name="gap_filler_lookahead_days"/>
                                    <field name="gap_filler_hour"/>
                                    <field name="gap_filler_minute"/>
                                </group>
                            </group>
                            <group>
                                <group string="Homepage-Bilder">
                                    <field name="homepage_url"/>
                                    <field name="last_homepage_image_url" readonly="1"/>
                                </group>
                            </group>
                            <group string="Prompt">
                                <field name="gap_filler_prompt" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Hinweise">
                            <group>
                                <field name="notes" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_event_social_config" model="ir.actions.act_window">
        <field name="name">Einstellungen</field>
        <field name="res_model">gl.event.social.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gl_event_social_root" name="Event Social Automation" sequence="35"/>
    <menuitem id="menu_gl_event_social_config" name="Einstellungen" parent="menu_gl_event_social_root" action="action_gl_event_social_config" sequence="10"/>
</odoo>
