<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_form_gl_event_social_auto" model="ir.ui.view">
        <field name="name">event.event.form.gl.event.social.auto</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Groundlift Social Automation">
                    <group>
                        <field name="gl_social_posts_generated" readonly="1"/>
                        <field name="gl_soldout_social_post_created" readonly="1"/>
                        <field name="gl_social_auto_publish_ok"/>
                        <field name="gl_social_post_count" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_gl_create_social_posts" type="object" string="Social Posts erzeugen" class="btn-secondary"/>
                        <button name="action_gl_approve_social_posts" type="object" string="Social Posts freigeben &amp; planen" class="btn-primary" invisible="not gl_social_posts_generated"/>
                        <button name="action_gl_open_social_posts" type="object" string="Social Posts öffnen" class="btn-secondary" invisible="not gl_social_posts_generated"/>
                    </group>
                    <field name="gl_social_last_error" readonly="1" placeholder="Keine Hinweise"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
