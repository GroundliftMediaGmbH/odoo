<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_event_form_artist_portal_inherit" model="ir.ui.view">
        <field name="name">event.event.form.artist.portal.inherit</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="gl_event_guestlist.view_event_form_guestlist_inherit"/>
        <field name="arch" type="xml">
            <!--
                Keep the Groundlift guest-list tab focused on the guest list itself.
                All information that is meant to be handed to artists/agencies lives
                in its own tab.
            -->
            <xpath expr="//page[@name='guestlist']" position="after">
                <page string="Info für Band/Agentur" name="artist_agent_info">
                    <group>
                        <group string="Künstler- / Agenturportal">
                            <field name="artist_portal_extended_enabled" readonly="1"/>
                            <field name="artist_portal_available" readonly="1"/>
                            <field name="artist_portal_status" readonly="1" nolabel="1"/>
                            <button name="action_regenerate_artist_portal_token"
                                    type="object"
                                    string="Portal-Link neu erzeugen"
                                    class="btn-secondary"
                                    confirm="Dadurch wird der bisherige Künstler-/Agentur-Link ungültig. Fortfahren?"/>
                        </group>
                        <group string="GEMA (ab Abrechnung)">
                            <field name="artist_portal_gema_url" widget="url" placeholder="https://www.gema.de/..."/>
                            <div class="text-muted">Ab Abrechnung (auch Beendet) im Portal sichtbar. Hier den vollständigen GEMA-Link hinterlegen.</div>
                        </group>
                        <group string="Portalbereiche je Veranstaltung">
                            <field name="artist_portal_section_photos"/>
                            <field name="artist_portal_section_press"/>
                            <field name="artist_portal_section_tech"/>
                            <field name="artist_portal_section_hospitality"/>
                            <div class="text-muted">Standard: Alte Veranstaltungen zeigen nur Gästeliste, neue zeigen alle Bereiche. Mit „Anzeigen“ oder „Ausblenden“ pro Veranstaltung abweichen.</div>
                        </group>
                        <group string="Einladung &amp; Vertragskontakt" invisible="not artist_portal_extended_enabled">
                            <field name="artist_portal_contract_contact_id" options="{'no_create': False}"/>
                            <field name="artist_portal_introduction" placeholder="{event} und {portal_url} können als Platzhalter verwendet werden."/>
                            <field name="artist_portal_invitation_sent_at" readonly="1"/>
                            <field name="artist_portal_invitation_recipient" readonly="1"/>
                            <button name="action_artist_portal_send_invitation" type="object"
                                    string="Einladung erneut senden" class="btn-secondary"
                                    invisible="not artist_portal_available"/>
                            <button name="action_artist_portal_send_test_mail" type="object"
                                    string="Staging-Testmail an Julius" class="btn-secondary"
                                    invisible="not artist_portal_available"/>
                        </group>
                        <group string="Benachrichtigungen" invisible="not (artist_portal_extended_enabled or artist_portal_section_photos == 'show' or artist_portal_section_press == 'show' or artist_portal_section_tech == 'show' or artist_portal_section_hospitality == 'show')">
                            <field name="artist_portal_notifications_enabled"/>
                            <div class="text-muted">Diskussions-Posteingang (ohne Popup) und To-do-Aktivität an Verantwortlich (Fotos/Texte), Techn. Leitung (Techrider) und Organisation Service (Hospitality Rider).</div>
                        </group>
                        <group string="Presse &amp; Grafiken" invisible="not (artist_portal_extended_enabled or artist_portal_section_photos == 'show' or artist_portal_section_press == 'show')">
                            <field name="artist_portal_media_ready" readonly="1"/>
                            <field name="artist_portal_short_locked"/>
                            <field name="artist_portal_long_locked"/>
                            <field name="artist_portal_photo_locked"/>
                            <field name="artist_portal_graphics_locked"/>
                        </group>
                        <group string="Hochgeladene Pressebilder" invisible="not (artist_portal_extended_enabled or artist_portal_section_photos == 'show')">
                            <field name="artist_portal_photo_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="format"/>
                                    <field name="filename"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </group>
                        <group string="Link / QR-Code">
                            <field name="artist_portal_url" widget="url" readonly="1" invisible="not artist_portal_available"/>
                            <field name="artist_portal_qr_html" widget="html" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Keep the optional provenance columns exactly as before. -->
            <xpath expr="//page[@name='guestlist']//field[@name='price_option_id']" position="after">
                <field name="artist_portal_created" string="Künstlerportal" optional="hide" readonly="1"/>
                <field name="artist_portal_entry_type" string="Portal-Art" optional="show" readonly="1"/>
                <field name="artist_portal_submitted_by" string="Agentur / Ansprechpartner" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
