<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_timesheet_reviewer_list" model="ir.ui.view">
        <field name="name">gl.timesheet.reviewer.list</field>
        <field name="model">gl.timesheet.reviewer</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="reviewer_level"/>
                <field name="auth_mode"/>
                <field name="user_id" optional="show"/>
                <field name="custom_login" optional="show"/>
                <field name="effective_email"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gl_timesheet_reviewer_form" model="ir.ui.view">
        <field name="name">gl.timesheet.reviewer.form</field>
        <field name="model">gl.timesheet.reviewer</field>
        <field name="arch" type="xml">
            <form string="Stundenzettel-Prüfer">
                <header>
                    <button name="action_open_portal" type="object" string="Prüfportal öffnen" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Name des Prüfers"/></h1>
                    </div>
                    <group>
                        <group string="Rolle">
                            <field name="reviewer_level"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Anmeldung">
                            <field name="auth_mode"/>
                            <field name="user_id" invisible="auth_mode != 'odoo'"/>
                            <field name="custom_login" invisible="auth_mode != 'custom'"/>
                            <field name="new_password" password="True" invisible="auth_mode != 'custom'" placeholder="Nur zum Setzen/Ändern ausfüllen"/>
                            <field name="password_is_set" invisible="auth_mode != 'custom'" readonly="1"/>
                            <field name="email" invisible="auth_mode != 'custom'"/>
                            <field name="effective_email" readonly="1"/>
                        </group>
                    </group>
                    <group string="Sicherheitsstatus" invisible="auth_mode != 'custom'">
                        <field name="last_login_at" readonly="1"/>
                        <field name="lock_until" readonly="1"/>
                        <field name="failed_login_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_timesheet_reviewer_search" model="ir.ui.view">
        <field name="name">gl.timesheet.reviewer.search</field>
        <field name="model">gl.timesheet.reviewer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="custom_login"/>
                <filter name="level_1" string="1. Prüfer" domain="[('reviewer_level','=','1')]"/>
                <filter name="level_2" string="2. Prüfer" domain="[('reviewer_level','=','2')]"/>
                <filter name="active" string="Aktiv" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_timesheet_reviewer" model="ir.actions.act_window">
        <field name="name">Prüfer</field>
        <field name="res_model">gl.timesheet.reviewer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_timesheet_reviewer_search"/>
    </record>
</odoo>
