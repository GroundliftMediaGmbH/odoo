<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_login" name="Stundenzettel-Prüfung: Anmeldung">
        <t t-call="website.layout">
            <t t-set="title">Stundenzettel-Prüfung</t>
            <div id="wrap" class="gl-ts-portal gl-ts-login-page">
                <div class="container py-5">
                    <div class="gl-ts-login-card mx-auto">
                        <div class="gl-ts-brand-mark">GROUNDLIFT</div>
                        <h1>Stundenzettel-Prüfung</h1>
                        <p class="text-muted">Geschützter Zugang für 1. und 2. Prüfer.</p>
                        <div t-if="error" class="alert alert-danger" role="alert">
                            <t t-esc="error"/>
                        </div>
                        <form method="post" action="/stundenzettel/pruefung/login" class="mt-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label for="gl_ts_login" class="form-label">Benutzername</label>
                                <input id="gl_ts_login" type="text" name="login" class="form-control form-control-lg"
                                       autocomplete="username" required="required" t-att-value="login_value"/>
                            </div>
                            <div class="mb-3">
                                <label for="gl_ts_password" class="form-label">Passwort</label>
                                <input id="gl_ts_password" type="password" name="password"
                                       class="form-control form-control-lg" autocomplete="current-password" required="required"/>
                            </div>
                            <button type="submit" class="btn btn-dark btn-lg w-100">Anmelden</button>
                        </form>
                        <div class="gl-ts-divider"><span>oder</span></div>
                        <a t-att-href="odoo_login_url" class="btn btn-outline-dark w-100">
                            Mit bestehendem Odoo-Benutzer anmelden
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_access_denied" name="Stundenzettel-Prüfung: Kein Zugriff">
        <t t-call="website.layout">
            <t t-set="title">Kein Zugriff</t>
            <div id="wrap" class="gl-ts-portal">
                <div class="container py-5">
                    <div class="gl-ts-empty-card mx-auto text-center">
                        <h1>Kein Prüferzugang</h1>
                        <p>Der angemeldete Odoo-Benutzer ist nicht als 1. oder 2. Prüfer eingerichtet.</p>
                        <a href="/web/session/logout?redirect=/stundenzettel/pruefung/login" class="btn btn-dark">
                            Abmelden und erneut anmelden
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_page" name="Stundenzettel-Prüfung: Monatsübersicht">
        <t t-call="website.layout">
            <t t-set="title">Stundenzettel-Prüfung</t>
            <div id="wrap" class="gl-ts-portal">
                <section class="gl-ts-header">
                    <div class="container py-4">
                        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                            <div>
                                <div class="gl-ts-brand-mark">GROUNDLIFT</div>
                                <h1 class="mb-1">Stundenzettel-Prüfung</h1>
                                <div class="gl-ts-reviewer-line">
                                    Angemeldet als <strong t-esc="reviewer.name"/>
                                    <span class="badge rounded-pill text-bg-secondary ms-2">
                                        <t t-esc="'1. Prüfer' if reviewer.reviewer_level == '1' else '2. Prüfer'"/>
                                    </span>
                                </div>
                            </div>
                            <a href="/stundenzettel/pruefung/logout" class="btn btn-outline-light">Abmelden</a>
                        </div>
                    </div>
                </section>

                <main class="container py-4 py-lg-5">
                    <div t-if="flash" t-attf-class="alert alert-#{flash['level']}" role="alert">
                        <t t-esc="flash['message']"/>
                    </div>

                    <div class="gl-ts-month-bar mb-4">
                        <div>
                            <div class="gl-ts-label">Ausgewählter Monat</div>
                            <h2 class="mb-0" t-if="selected_month" t-esc="selected_month.name"/>
                            <h2 class="mb-0" t-else="">Noch kein Prüfmonat</h2>
                        </div>
                        <div class="d-flex flex-column align-items-lg-end gap-3">
                            <div class="gl-ts-month-links" t-if="months">
                                <a t-foreach="months" t-as="month_record"
                                   t-att-href="'/stundenzettel/pruefung?month=%s' % month_record.month_start.strftime('%Y-%m')"
                                   t-attf-class="btn #{'btn-dark' if selected_month and month_record.id == selected_month.id else 'btn-outline-dark'}">
                                    <t t-esc="month_record.name"/>
                                </a>
                            </div>
                            <div t-if="selected_month" class="gl-ts-month-payment">
                                <span t-if="month_all_paid" class="badge text-bg-success fs-6">✓ Gesamtmonat überwiesen</span>
                                <span t-else="" class="badge text-bg-secondary fs-6">Gesamtmonat nicht überwiesen</span>
                                <form t-if="can_set_month_paid" method="post" class="d-inline-block ms-2"
                                      t-att-action="'/stundenzettel/pruefung/monat/%s/ueberwiesen' % selected_month.id">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button t-if="not month_all_paid" type="submit" name="paid" value="1"
                                            t-att-disabled="not month_all_approved" class="btn btn-sm btn-primary">
                                        Alle als überwiesen markieren
                                    </button>
                                    <button t-else="" type="submit" name="paid" value="0" class="btn btn-sm btn-outline-secondary">
                                        Monats-Markierung entfernen
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div t-if="not selected_month" class="gl-ts-empty-card text-center">
                        <h3>Noch keine Monatsdaten vorhanden</h3>
                        <p class="mb-0">Ein Prüfmonat wird automatisch am 1. des Folgemonats oder manuell im Backend erzeugt.</p>
                    </div>

                    <div t-elif="not employee_lines" class="gl-ts-empty-card text-center">
                        <h3>Keine relevanten Arbeitszeiten</h3>
                        <p class="mb-0">Für diesen Monat wurden keine Arbeitszeiten von Minijobbern oder geringfügig Beschäftigten gefunden.</p>
                    </div>

                    <div t-else="" class="accordion gl-ts-employee-list" id="glTimesheetEmployees">
                        <div t-foreach="employee_lines" t-as="employee" class="accordion-item gl-ts-employee-card"
                             t-att-id="employee['anchor']">
                            <h2 class="accordion-header" t-att-id="'heading-%s' % employee['id']">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        t-att-data-bs-target="'#collapse-%s' % employee['id']"
                                        aria-expanded="false" t-att-aria-controls="'collapse-%s' % employee['id']">
                                    <span class="gl-ts-employee-heading">
                                        <span>
                                            <strong class="gl-ts-employee-name" t-esc="employee['employee_name']"/>
                                            <small t-if="employee['job_title']" t-esc="employee['job_title']"/>
                                        </span>
                                        <span class="gl-ts-heading-numbers">
                                            <span><small>Arbeitszeit</small><strong t-esc="employee['payable']"/></span>
                                            <span><small>Gesamtlohn</small><strong t-esc="employee['total_salary']"/></span>
                                        </span>
                                        <span t-if="employee['approval_state'] == 'approved'" class="badge text-bg-success">Freigegeben</span>
                                        <span t-elif="employee['approval_state'] == 'rejected'" class="badge text-bg-danger">Nicht freigegeben</span>
                                        <span t-else="" class="badge text-bg-warning">Nicht freigegeben</span>
                                    </span>
                                </button>
                            </h2>
                            <div t-att-id="'collapse-%s' % employee['id']" class="accordion-collapse collapse"
                                 t-att-aria-labelledby="'heading-%s' % employee['id']">
                                <div class="accordion-body">
                                    <div class="row g-3 gl-ts-summary-grid mb-4">
                                        <div class="col-6 col-lg">
                                            <div class="gl-ts-summary-box"><small>Bruttozeit</small><strong t-esc="employee['gross']"/></div>
                                        </div>
                                        <div class="col-6 col-lg">
                                            <div class="gl-ts-summary-box"><small>Automatische Pausen</small><strong t-esc="employee['break']"/></div>
                                        </div>
                                        <div class="col-6 col-lg">
                                            <div class="gl-ts-summary-box"><small>Arbeitszeit</small><strong t-esc="employee['payable']"/></div>
                                        </div>
                                        <div class="col-6 col-lg">
                                            <div class="gl-ts-summary-box"><small>Stundenlohn</small><strong t-esc="employee['hourly_wage']"/></div>
                                        </div>
                                        <div class="col-12 col-lg">
                                            <div class="gl-ts-summary-box gl-ts-total-box"><small>Gesamtlohn</small><strong t-esc="employee['total_salary']"/></div>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table align-middle gl-ts-day-table">
                                            <thead>
                                                <tr>
                                                    <th>Datum</th>
                                                    <th>Von – bis</th>
                                                    <th>Brutto</th>
                                                    <th>Pause</th>
                                                    <th>Arbeitszeit</th>
                                                    <th>1. Prüfer</th>
                                                    <th>2. Prüfer</th>
                                                    <th>Prüfung</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="employee['days']" t-as="day">
                                                    <td><strong t-esc="day['date']"/></td>
                                                    <td>
                                                        <span t-esc="day['check_in']"/> – <span t-esc="day['check_out']"/>
                                                        <small t-if="day['attendance_count'] &gt; 1" class="d-block text-muted">
                                                            <t t-esc="day['attendance_count']"/> Anwesenheiten zusammengefasst
                                                        </small>
                                                    </td>
                                                    <td class="text-nowrap" t-esc="day['gross']"/>
                                                    <td class="text-nowrap">
                                                        <span t-esc="day['break']"/>
                                                        <small t-if="day['break'] != '00:00:00'" class="d-block text-muted">automatisch</small>
                                                    </td>
                                                    <td class="text-nowrap"><strong t-esc="day['payable']"/></td>
                                                    <td>
                                                        <span t-if="day['reviewer1_state'] == 'approved'" class="badge text-bg-success">Freigegeben</span>
                                                        <span t-elif="day['reviewer1_state'] == 'rejected'" class="badge text-bg-danger">Nicht freigegeben</span>
                                                        <span t-else="" class="badge text-bg-secondary">Offen</span>
                                                        <small t-if="day['reviewer1_name']" class="d-block text-muted mt-1" t-esc="day['reviewer1_name']"/>
                                                    </td>
                                                    <td>
                                                        <span t-if="day['reviewer2_state'] == 'approved'" class="badge text-bg-success">Freigegeben</span>
                                                        <span t-elif="day['reviewer2_state'] == 'rejected'" class="badge text-bg-danger">Nicht freigegeben</span>
                                                        <span t-else="" class="badge text-bg-secondary">Offen</span>
                                                        <small t-if="day['reviewer2_name']" class="d-block text-muted mt-1" t-esc="day['reviewer2_name']"/>
                                                    </td>
                                                    <td class="gl-ts-review-cell">
                                                        <form method="post" t-att-action="'/stundenzettel/pruefung/tag/%s' % day['id']">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <input type="text" name="note" class="form-control form-control-sm mb-2"
                                                                   placeholder="Bemerkung (optional)"/>
                                                            <div class="d-flex flex-wrap gap-2">
                                                                <button type="submit" name="state" value="approved" class="btn btn-success btn-sm">
                                                                    Geprüft und freigegeben
                                                                </button>
                                                                <button type="submit" name="state" value="rejected" class="btn btn-outline-danger btn-sm">
                                                                    Nicht freigegeben
                                                                </button>
                                                            </div>
                                                        </form>
                                                        <small t-if="day['review_note']" class="d-block mt-2 text-muted">
                                                            Letzte Bemerkung: <t t-esc="day['review_note']"/>
                                                        </small>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="gl-ts-payment-row mt-3">
                                        <div>
                                            <span class="gl-ts-label">Auszahlung des Monatslohns</span>
                                            <div t-if="employee['paid']" class="text-success fw-bold">
                                                ✓ Überwiesen<t t-if="employee['paid_by']"> von <t t-esc="employee['paid_by']"/></t>
                                            </div>
                                            <div t-else="" class="text-muted">Noch nicht als überwiesen markiert</div>
                                        </div>
                                        <form t-if="employee['can_set_paid']" method="post"
                                              t-att-action="'/stundenzettel/pruefung/mitarbeiter/%s/ueberwiesen' % employee['id']">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button t-if="not employee['paid']" type="submit" name="paid" value="1"
                                                    t-att-disabled="employee['approval_state'] != 'approved'"
                                                    class="btn btn-primary">
                                                Als überwiesen markieren
                                            </button>
                                            <button t-else="" type="submit" name="paid" value="0" class="btn btn-outline-secondary">
                                                Überwiesen-Markierung entfernen
                                            </button>
                                        </form>
                                        <div t-else="" class="text-muted small">Nur der 2. Prüfer kann diesen Status ändern.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </t>
    </template>
</odoo>
