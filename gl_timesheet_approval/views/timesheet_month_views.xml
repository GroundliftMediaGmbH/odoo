<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_timesheet_month_list" model="ir.ui.view">
        <field name="name">gl.timesheet.month.list</field>
        <field name="model">gl.timesheet.month</field>
        <field name="arch" type="xml">
            <list decoration-success="all_approved and all_paid" decoration-warning="not all_approved">
                <field name="month_start" string="Monat"/>
                <field name="name"/>
                <field name="employee_count"/>
                <field name="approved_employee_count"/>
                <field name="rejected_employee_count"/>
                <field name="all_approved"/>
                <field name="all_paid"/>
                <field name="notification_sent_at" optional="show"/>
                <field name="last_refresh_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_gl_timesheet_month_search" model="ir.ui.view">
        <field name="name">gl.timesheet.month.search</field>
        <field name="model">gl.timesheet.month</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="month_start"/>
                <filter name="not_approved" string="Noch nicht vollständig freigegeben" domain="[('all_approved','=',False)]"/>
                <filter name="not_paid" string="Noch nicht vollständig überwiesen" domain="[('all_paid','=',False)]"/>
                <group>
                    <filter name="group_year" string="Jahr" context="{'group_by':'month_start:year'}"/>
                    <filter name="group_company" string="Firma" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gl_timesheet_employee_month_list" model="ir.ui.view">
        <field name="name">gl.timesheet.employee.month.list</field>
        <field name="model">gl.timesheet.employee.month</field>
        <field name="arch" type="xml">
            <list decoration-success="approval_state == 'approved'" decoration-danger="approval_state == 'rejected'">
                <field name="month_id" optional="show"/>
                <field name="employee_id"/>
                <field name="gross_display" string="Bruttozeit"/>
                <field name="break_display" string="Pause"/>
                <field name="payable_display" string="Arbeitszeit"/>
                <field name="hourly_wage"/>
                <field name="total_salary"/>
                <field name="approval_state" widget="badge"/>
                <field name="paid"/>
            </list>
        </field>
    </record>

    <record id="view_gl_timesheet_employee_month_form" model="ir.ui.view">
        <field name="name">gl.timesheet.employee.month.form</field>
        <field name="model">gl.timesheet.employee.month</field>
        <field name="arch" type="xml">
            <form string="Mitarbeiter-Stundenzettel">
                <sheet>
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1><field name="employee_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Monatssumme">
                            <field name="month_id" readonly="1"/>
                            <field name="gross_display" readonly="1"/>
                            <field name="break_display" readonly="1"/>
                            <field name="payable_display" readonly="1"/>
                            <field name="hourly_wage"/>
                            <field name="total_salary" readonly="1"/>
                        </group>
                        <group string="Freigabe und Zahlung">
                            <field name="approval_state" widget="badge" readonly="1"/>
                            <field name="paid" readonly="1"/>
                            <field name="paid_by_id" readonly="1"/>
                            <field name="paid_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Arbeitstage">
                            <field name="day_ids" readonly="1">
                                <list decoration-success="reviewer1_state == 'approved' and reviewer2_state == 'approved'"
                                      decoration-danger="reviewer1_state == 'rejected' or reviewer2_state == 'rejected'">
                                    <field name="work_date"/>
                                    <field name="first_check_in"/>
                                    <field name="last_check_out"/>
                                    <field name="attendance_count"/>
                                    <field name="gross_display" string="Brutto"/>
                                    <field name="break_display" string="Pause"/>
                                    <field name="payable_display" string="Arbeitszeit"/>
                                    <field name="reviewer1_state" widget="badge"/>
                                    <field name="reviewer1_by_id" optional="show"/>
                                    <field name="reviewer2_state" widget="badge"/>
                                    <field name="reviewer2_by_id" optional="show"/>
                                    <field name="review_note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prüfhistorie">
                            <field name="log_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="created_at"/>
                                    <field name="day_id"/>
                                    <field name="reviewer_id"/>
                                    <field name="action"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gl_timesheet_month_form" model="ir.ui.view">
        <field name="name">gl.timesheet.month.form</field>
        <field name="model">gl.timesheet.month</field>
        <field name="arch" type="xml">
            <form string="Stundenzettel-Prüfmonat">
                <header>
                    <button name="action_refresh_from_attendance" type="object" string="Anwesenheiten einlesen / aktualisieren" class="btn-primary"/>
                    <button name="action_send_first_reviewer_notification" type="object" string="E-Mail an 1. Prüfer senden" class="btn-secondary"/>
                    <button name="action_open_portal" type="object" string="Prüfportal öffnen" class="btn-secondary"/>
                    <button name="action_download_xlsx" type="object" string="Excel herunterladen" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="month_start"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Zeitraum">
                            <field name="month_start"/>
                            <field name="month_end" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Status">
                            <field name="employee_count" readonly="1"/>
                            <field name="approved_employee_count" readonly="1"/>
                            <field name="rejected_employee_count" readonly="1"/>
                            <field name="all_approved" readonly="1"/>
                            <field name="all_paid" readonly="1"/>
                        </group>
                        <group string="Benachrichtigung und Datenstand">
                            <field name="notification_sent_at" readonly="1"/>
                            <field name="notification_recipient_count" readonly="1"/>
                            <field name="last_refresh_at" readonly="1"/>
                            <field name="last_refresh_by_id" readonly="1"/>
                        </group>
                        <group string="Ergebnis des letzten Einlesens" col="4">
                            <field name="source_attendance_count" readonly="1"/>
                            <field name="source_employee_count" readonly="1"/>
                            <field name="eligible_source_employee_count" readonly="1"/>
                            <field name="excluded_source_employee_count" readonly="1"/>
                            <field name="last_refresh_note" readonly="1" colspan="4" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mitarbeiter">
                            <field name="employee_line_ids" readonly="1" context="{'default_month_id': id}">
                                <list decoration-success="approval_state == 'approved'" decoration-danger="approval_state == 'rejected'">
                                    <field name="employee_id"/>
                                    <field name="gross_display" string="Bruttozeit"/>
                                    <field name="break_display" string="Pause"/>
                                    <field name="payable_display" string="Arbeitszeit"/>
                                    <field name="hourly_wage"/>
                                    <field name="total_salary"/>
                                    <field name="approval_state" widget="badge"/>
                                    <field name="paid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prüfhistorie">
                            <field name="log_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="created_at"/>
                                    <field name="employee_month_id"/>
                                    <field name="day_id"/>
                                    <field name="reviewer_id"/>
                                    <field name="action"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gl_timesheet_month" model="ir.actions.act_window">
        <field name="name">Prüfmonate</field>
        <field name="res_model">gl.timesheet.month</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_timesheet_month_search"/>
    </record>

    <record id="action_gl_timesheet_employee_month" model="ir.actions.act_window">
        <field name="name">Mitarbeiter-Stundenzettel</field>
        <field name="res_model">gl.timesheet.employee.month</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gl_timesheet_review_log" model="ir.actions.act_window">
        <field name="name">Prüfhistorie</field>
        <field name="res_model">gl.timesheet.review.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_gl_timesheet_review_log_list" model="ir.ui.view">
        <field name="name">gl.timesheet.review.log.list</field>
        <field name="model">gl.timesheet.review.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="created_at"/>
                <field name="month_id"/>
                <field name="employee_month_id"/>
                <field name="day_id"/>
                <field name="reviewer_id"/>
                <field name="action"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
