<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_gl_timesheet_manager" model="res.groups">
        <field name="name">Stundenzettel-Prüfung: Verwaltung</field>
    </record>

    <record id="rule_gl_timesheet_month_company" model="ir.rule">
        <field name="name">Stundenzettel-Monate nach Firma</field>
        <field name="model_id" ref="model_gl_timesheet_month"/>
        <field name="groups" eval="[(4, ref('group_gl_timesheet_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gl_timesheet_employee_month_company" model="ir.rule">
        <field name="name">Mitarbeiter-Monatszettel nach Firma</field>
        <field name="model_id" ref="model_gl_timesheet_employee_month"/>
        <field name="groups" eval="[(4, ref('group_gl_timesheet_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gl_timesheet_day_company" model="ir.rule">
        <field name="name">Stundenzettel-Tage nach Firma</field>
        <field name="model_id" ref="model_gl_timesheet_day"/>
        <field name="groups" eval="[(4, ref('group_gl_timesheet_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gl_timesheet_reviewer_company" model="ir.rule">
        <field name="name">Prüfer nach Firma</field>
        <field name="model_id" ref="model_gl_timesheet_reviewer"/>
        <field name="groups" eval="[(4, ref('group_gl_timesheet_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gl_timesheet_log_company" model="ir.rule">
        <field name="name">Prüfhistorie nach Firma</field>
        <field name="model_id" ref="model_gl_timesheet_review_log"/>
        <field name="groups" eval="[(4, ref('group_gl_timesheet_manager'))]"/>
        <field name="domain_force">[('employee_month_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
