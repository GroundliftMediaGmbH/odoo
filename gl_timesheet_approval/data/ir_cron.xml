<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gl_timesheet_previous_month" model="ir.cron">
        <field name="name">Groundlift Stundenzettel: Vormonat erzeugen und Prüfer informieren</field>
        <field name="model_id" ref="model_gl_timesheet_month"/>
        <field name="state">code</field>
        <field name="code">model._cron_prepare_and_notify_previous_month()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=6, minute=0, second=0)"/>
    </record>
</odoo>
